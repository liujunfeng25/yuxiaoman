.consultation-page { min-height: 100vh; color: #17263a; background: #f4f8fc; }
.boundary-banner { display: flex; min-height: 132rpx; padding: 28rpx 32rpx; align-items: center; gap: 18rpx; color: #fff; background: linear-gradient(135deg, #155fae, #2f83d8); box-sizing: border-box; }
.boundary-banner > image { width: 52rpx; height: 52rpx; flex: none; filter: brightness(0) invert(1); }
.boundary-banner > view { display: flex; min-width: 0; flex-direction: column; gap: 5rpx; }
