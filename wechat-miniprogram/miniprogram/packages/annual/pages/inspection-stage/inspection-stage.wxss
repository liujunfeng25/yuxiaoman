.stage-page { min-height: 100vh; padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); color: #13243c; background: #f5f8fc; box-sizing: border-box; }
.stage-hero { position: relative; padding: 34rpx 30rpx 32rpx; overflow: hidden; border-radius: 29rpx; background: linear-gradient(145deg, #edf5ff, #fff); box-shadow: 0 13rpx 34rpx rgba(30,75,124,.08); }.stage-hero::after { position: absolute; right: -46rpx; bottom: -68rpx; width: 210rpx; height: 210rpx; border-radius: 50%; background: rgba(11,99,246,.05); content: ""; }.stage-index { display: flex; align-items: center; gap: 12rpx; }.stage-index text { color: #0b63f6; font-size: 22rpx; font-weight: 850; letter-spacing: 3rpx; }.stage-index image { width: 43rpx; height: 43rpx; }.state-pill { position: absolute; top: 31rpx; right: 28rpx; padding: 8rpx 15rpx; color: #0b63f6; border-radius: 999rpx; background: #e4f0ff; font-size: 20rpx; font-weight: 700; }.tone-success .state-pill { color: #198557; background: #e4f7ed; }.tone-attention .state-pill { color: #b76514; background: #fff0df; }.stage-eyebrow { display: block; margin-top: 25rpx; color: #61768f; font-size: 22rpx; }.stage-title { display: block; width: 88%; margin-top: 7rpx; color: #0f213b; font-size: 38rpx; font-weight: 900; line-height: 1.35; }.stage-description { display: block; margin-top: 15rpx; color: #71839a; font-size: 24rpx; line-height: 1.7; }
.fact-card { margin-top: 20rpx; padding: 5rpx 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 9rpx 27rpx rgba(29,69,111,.06); }.fact-row { display: flex; min-height: 86rpx; align-items: center; justify-content: space-between; gap: 28rpx; border-bottom: 1rpx solid #edf1f5; }.fact-row:last-child { border: 0; }.fact-row text:first-child { flex-shrink: 0; color: #7a8da3; font-size: 22rpx; }.fact-row text:last-child { color: #223b59; font-size: 23rpx; font-weight: 650; text-align: right; }.phone-row { display: flex; width: 100%; min-height: 82rpx; align-items: center; color: #0b63f6; border-top: 1rpx solid #edf1f5; font-size: 22rpx; font-weight: 700; }.phone-row image { width: 34rpx; height: 34rpx; margin-right: 12rpx; }.phone-row .row-caret { width: 26rpx; height: 26rpx; margin: 0 0 0 auto; opacity: .58; }
.tips-section { margin-top: 30rpx; }.section-title { display: block; margin: 0 4rpx 14rpx; color: #152842; font-size: 28rpx; font-weight: 800; }.tip-item { padding: 23rpx 25rpx; border-left: 5rpx solid #0b63f6; border-radius: 4rpx 19rpx 19rpx 4rpx; background: #fff; }.tip-item + .tip-item { margin-top: 13rpx; }.tip-item text { display: block; }.tip-item text:first-child { color: #28435f; font-size: 24rpx; font-weight: 750; }.tip-item text:last-child { margin-top: 7rpx; color: #788ba1; font-size: 22rpx; line-height: 1.65; }
.official-guide { display: grid; margin-top: 24rpx; padding: 24rpx; grid-template-columns: 58rpx 1fr; gap: 17rpx; border: 1rpx solid #cfe0f7; border-radius: 22rpx; background: #eef6ff; }.guide-icon { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #fff; }.guide-icon image { width: 37rpx; height: 37rpx; }.official-guide view:nth-child(2) text { display: block; }.official-guide view:nth-child(2) text:first-child { color: #244664; font-size: 24rpx; font-weight: 750; }.official-guide view:nth-child(2) text:last-child { margin-top: 7rpx; color: #74899f; font-size: 21rpx; line-height: 1.6; }.official-guide button { grid-column: 2; justify-self: start; color: #0b63f6; font-size: 22rpx; font-weight: 700; }.stage-actions { margin-top: 30rpx; }
