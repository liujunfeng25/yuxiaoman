.payment-page { min-height: 100vh; padding: 30rpx 30rpx calc(230rpx + env(safe-area-inset-bottom)); color: #111a28; background: #f3f6fa; box-sizing: border-box; }
.payment-hero { display: flex; padding: 42rpx 28rpx 40rpx; align-items: center; flex-direction: column; border: 1rpx solid #dce9f6; border-radius: 34rpx; background: linear-gradient(145deg, #eaf5ff, #f8fbff); }
.hero-icon { display: flex; width: 96rpx; height: 96rpx; margin-bottom: 15rpx; align-items: center; justify-content: center; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(23, 104, 207, .10); }
.hero-icon image { width: 52rpx; height: 52rpx; }
.payment-hero > text:nth-child(2) { color: #1768cf; font-size: 23rpx; font-weight: 800; }
.payment-hero > text:nth-child(3) { margin: 7rpx 0 5rpx; color: #14243a; font-size: 64rpx; font-weight: 800; letter-spacing: -2rpx; }
.payment-hero > text:last-child { color: #788495; font-size: 22rpx; text-align: center; }
.payment-hero.paid { border-color: #d6eee5; background: linear-gradient(145deg, #eaf9f3, #f8fcfa); }
.payment-hero.paid > text:nth-child(2) { color: #18875f; }

.safety-card { display: grid; margin-top: 22rpx; padding: 24rpx 26rpx; grid-template-columns: 42rpx 1fr; align-items: center; gap: 18rpx; border: 1rpx solid #d6e8f8; color: #607087; background: #eef6ff; }
.safety-card > image { width: 42rpx; height: 42rpx; }
.safety-card > view { display: flex; flex-direction: column; gap: 5rpx; }
.safety-card text:first-child { color: #1768cf; font-size: 25rpx; font-weight: 800; }
.safety-card text:last-child { font-size: 21rpx; line-height: 1.45; }

.payment-summary { margin-top: 22rpx; overflow: hidden; border: 1rpx solid #e2e9f1; }
.payment-summary > view:not(.total) { display: grid; min-height: 126rpx; padding: 20rpx 24rpx; grid-template-columns: 54rpx 1fr; align-items: center; gap: 18rpx; box-sizing: border-box; }
.payment-summary > view + view { border-top: 1rpx solid #edf1f5; }
.summary-icon { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: #edf6ff; }
.summary-icon image { width: 32rpx; height: 32rpx; }
.payment-summary > view > view:last-child { display: flex; min-width: 0; flex-direction: column; }
.payment-summary > view > view:last-child text:first-child { color: #8490a0; font-size: 20rpx; }
.payment-summary > view > view:last-child text:nth-child(2) { overflow: hidden; margin-top: 2rpx; color: #1b2a3f; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.payment-summary > view > view:last-child text:last-child { overflow: hidden; margin-top: 2rpx; color: #728092; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.payment-summary > view.total { display: flex; min-height: 100rpx; padding: 0 24rpx; align-items: center; justify-content: space-between; }
.payment-summary > view.total > view { display: flex; flex-direction: column; gap: 3rpx; }
.payment-summary > view.total > view text { color: #718094; font-size: 19rpx; font-weight: 600; }
.payment-summary > view.total > view text:first-child { color: #1b2a3f; font-size: 22rpx; font-weight: 750; }
.payment-summary > view.total > text { color: #1768cf; font-size: 38rpx; font-weight: 800; }
.payment-summary > view.route-line { display: grid; min-height: 96rpx; margin: 0; padding: 16rpx 24rpx; grid-template-columns: 34rpx minmax(0, 1fr); align-items: center; gap: 12rpx; color: #5e7792; background: #f2f8ff; box-sizing: border-box; }
.route-line > image { width: 32rpx; height: 32rpx; }
.payment-summary > view.route-line > view:last-child { display: flex; min-width: 0; flex-direction: column; gap: 3rpx; }
.payment-summary > view.route-line > view:last-child text:first-child { color: #245e9a; font-size: 21rpx; font-weight: 800; }
.payment-summary > view.route-line > view:last-child text:last-child { color: #667e98; font-size: 19rpx; }
.payment-summary > view.route-line > view:last-child text:nth-child(2) { color: #667e98; font-size: 19rpx; }

.code-note { display: grid; margin-top: 22rpx; padding: 24rpx; grid-template-columns: 42rpx 1fr; align-items: center; gap: 16rpx; border: 1rpx solid #d8e9fa; border-radius: 22rpx; color: #1768cf; background: #f2f8ff; }
.code-note > image { width: 42rpx; height: 42rpx; }
.code-note > view { display: flex; color: #283b51; flex-direction: column; }
.code-note text:first-child { font-size: 23rpx; font-weight: 800; }
.code-note text:last-child { margin-top: 4rpx; color: #71849a; font-size: 20rpx; line-height: 1.45; }
.inline-error { display: flex; margin-top: 20rpx; padding: 20rpx; align-items: center; justify-content: center; gap: 10rpx; border-radius: 14rpx; color: #8b5a22; background: #fff5e7; font-size: 22rpx; text-align: center; }
.inline-error image { width: 30rpx; height: 30rpx; flex-shrink: 0; }

.payment-actions { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; min-height: 186rpx; padding: 20rpx 30rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e3e9f0; background: rgba(255, 255, 255, .98); box-shadow: 0 -12rpx 34rpx rgba(22, 58, 98, .08); box-sizing: border-box; }
.pay-button { width: 100%; min-height: 92rpx; border-radius: 24rpx; background: linear-gradient(135deg, #1b79d6, #1768cf); box-shadow: 0 12rpx 26rpx rgba(23, 104, 207, .20); }
.later { display: flex; min-height: 58rpx; margin: 4rpx auto 0; align-items: center; justify-content: center; color: #6f7d8e; font-size: 23rpx; }
.payment-error { display: flex; margin-top: 140rpx; padding: 42rpx 30rpx; align-items: center; flex-direction: column; gap: 14rpx; color: #788495; text-align: center; }
.payment-error > image { width: 54rpx; height: 54rpx; }
.payment-error text:nth-child(2) { color: #16253a; font-size: 31rpx; font-weight: 800; }
.payment-error .secondary-button { width: 100%; margin-top: 16rpx; }
.missing-order { width: 100%; box-sizing: border-box; }
.fallback-actions { display: grid; width: 100%; min-width: 0; margin-top: 16rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; box-sizing: border-box; }
.fallback-action { display: flex; width: 100%; min-width: 0; min-height: 78rpx; padding: 10rpx 8rpx; align-items: center; justify-content: center; color: #1768cf; border: 1rpx solid #cfe0f3; border-radius: 18rpx; background: #fff; font-size: 22rpx; font-weight: 750; text-align: center; box-sizing: border-box; }
.fallback-action.primary { color: #fff; border-color: #1768cf; background: #1768cf; }
