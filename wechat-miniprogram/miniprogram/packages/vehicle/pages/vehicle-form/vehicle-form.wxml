<view class="page vehicle-form-page {{catalogOpen ? 'catalog-visible' : ''}}">
  <view class="tip">
    <text>完善车辆档案</text>
    <text>车牌、动力类型和登记信息会共同用于年检解释与预约项目匹配。</text>
  </view>

  <view role="button" aria-label="选择或更换品牌车型" class="vehicle-identity-preview" bindtap="openCatalog">
    <image class="identity-background" src="/assets/brand/hero-tianjin-background.jpg" mode="aspectFill"/>
    <image wx:if="{{selectedModelImage}}" class="identity-car" src="{{selectedModelImage}}" mode="aspectFit" webp="{{true}}" binderror="vehicleImageError"/>
    <view wx:elif="{{selectedModelId}}" class="identity-image-fallback"><image src="/assets/icons/car.png" mode="aspectFit"/><text>车型图片暂不可用</text></view>
    <view class="identity-copy">
      <view class="identity-plate"><text>{{plateNumber || '车牌待填写'}}</text></view>
      <text class="identity-name">{{selectedModelId ? selectedBrandName + ' ' + selectedModelName : '选择品牌车型'}}</text>
      <text class="identity-action">{{selectedModelId ? '点击更换车型' : '点击选择品牌与车型'}} ›</text>
    </view>
    <text wx:if="{{selectedModelImage}}" class="identity-disclosure">{{selectedModelId ? '车型展示图' : '车辆示意图'}}</text>
  </view>

  <view class="catalog-note"><text>品牌车型只用于车辆识别与界面展示</text><text>不会自动修改座位数、动力类型或年检测算</text></view>

  <view class="surface mode-card">
    <text class="form-section-label">号牌类型</text>
    <picker class="category-picker" mode="selector" range="{{plateCategories}}" range-key="label" value="{{plateCategoryIndex}}" bindchange="categoryChange">
      <view class="category-value"><text>{{plateCategoryConfirmed ? plateCategories[plateCategoryIndex].label : '请选择实际号牌类型'}}</text><image src="/assets/icons/caret-right.png"/></view>
    </picker>
    <text class="field-note">共 11 类，请按实际车辆选择；检测站按此类别匹配报价。</text>
  </view>

  <view class="surface plate-card {{mode === 'yellow' ? 'yellow' : mode === 'blue' ? 'blue' : 'green'}}">
    <view class="plate-heading">
      <view><text>车牌号码</text><text>按实际号牌自由填写，不固定字符位数</text></view>
    </view>
    <input class="plate-free-input" aria-label="车牌号码" value="{{plateNumber}}" bindinput="plateNumberInput" maxlength="32" placeholder="如 津A·12345、津A·1234挂或其他实际号牌" placeholder-style="color:rgba(255,255,255,.72)"/>
    <view class="plate-status {{plateComplete ? 'complete' : ''}}"><image wx:if="{{plateComplete}}" src="/assets/icons/check-circle.png"/><image wx:else src="/assets/icons/clock.png"/><text>{{plateComplete ? '车牌号码可保存' : '请输入实际号牌，仅排除不安全字符'}}</text></view>
  </view>

  <view class="surface vehicle-details-card">
    <text class="field-label">车辆类型（可编辑）</text>
    <input class="profile-input" aria-label="车辆类型" maxlength="40" value="{{vehicleType}}" bindinput="vehicleTypeInput" placeholder="按行驶证填写"/>
    <view class="profile-fields"><view><text class="field-label">核定座位数</text><input class="profile-input" aria-label="核定座位数" type="number" maxlength="2" value="{{seats < 0 ? '' : seats}}" bindinput="seatsInput" placeholder="挂车可填 0"/></view><view><text class="field-label">使用性质</text><input class="profile-input" aria-label="使用性质" maxlength="40" value="{{usageNature}}" bindinput="usageNatureInput" placeholder="如非营运、货运"/></view></view>

    <view wx:if="{{passengerColorEnabled}}" class="exterior-color-section">
      <view class="exterior-color-heading"><view><text>车身颜色</text><text>按车辆实际外观选择，可随时修改</text></view><button wx:if="{{exteriorColor}}" bindtap="clearExteriorColor">清除</button></view>
      <view class="exterior-color-grid" role="radiogroup" aria-label="选择车身颜色">
        <view wx:for="{{exteriorColors}}" wx:key="value" role="radio" aria-checked="{{exteriorColor === item.value}}" tabindex="0" data-value="{{item.value}}" bindtap="chooseExteriorColor" class="exterior-color-option {{exteriorColor === item.value ? 'active' : ''}}">
          <view class="color-swatch" style="background: {{item.hex}}"></view><text>{{item.label}}</text>
        </view>
      </view>
      <input class="profile-input exterior-color-input" aria-label="自定义车身颜色" maxlength="20" value="{{exteriorColor}}" bindinput="exteriorColorInput" placeholder="也可自由输入或修改，如珍珠白、银灰双色"/>
      <text wx:if="{{!exteriorColor}}" class="field-note">尚未选择颜色，不影响保存车辆。</text>
    </view>

    <block wx:if="{{plateCategories[plateCategoryIndex].vehicleClassCode === 'passenger_car'}}">
      <view class="wash-category-heading"><view><text>洗车车型价类</text><text>门店按此档位返回对应套餐价格</text></view><text>{{washVehicleCategory === 'sedan' ? '小轿车' : washVehicleCategory === 'suv' ? 'SUV' : 'MPV'}}</text></view>
      <view class="wash-category-row" role="radiogroup" aria-label="选择洗车车型价类">
        <view role="radio" aria-checked="{{washVehicleCategory === 'sedan'}}" tabindex="0" data-value="sedan" bindtap="chooseWashCategory" class="wash-category-option {{washVehicleCategory === 'sedan' ? 'active' : ''}}"><image src="/assets/icons/car.png"/><text>小轿车</text></view>
        <view role="radio" aria-checked="{{washVehicleCategory === 'suv'}}" tabindex="0" data-value="suv" bindtap="chooseWashCategory" class="wash-category-option {{washVehicleCategory === 'suv' ? 'active' : ''}}"><image src="/assets/icons/car.png"/><text>SUV</text></view>
        <view role="radio" aria-checked="{{washVehicleCategory === 'mpv'}}" tabindex="0" data-value="mpv" bindtap="chooseWashCategory" class="wash-category-option {{washVehicleCategory === 'mpv' ? 'active' : ''}}"><image src="/assets/icons/car.png"/><text>MPV</text></view>
      </view>
      <view wx:if="{{washVehicleCategoryLegacy}}" class="wash-category-note legacy"><image src="/assets/icons/warning-circle.png"/><text>历史 SUV/MPV 合并档已按 SUV 兼容，请确认后保存为新版独立档位。</text></view>
      <view wx:else class="wash-category-note"><image src="/assets/icons/shield-check.png"/><text>7 座不会自动判定为 MPV，请按车辆实际类型选择。</text></view>
    </block>

    <text class="field-label">动力类型</text>
    <view class="powertrain-grid">
      <view role="button" tabindex="0" data-value="gasoline" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'gasoline' ? 'active' : ''}}">汽油</view>
      <view role="button" tabindex="0" data-value="diesel" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'diesel' ? 'active' : ''}}">柴油</view>
      <view role="button" tabindex="0" data-value="hybrid" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'hybrid' ? 'active' : ''}}">油电混合 HEV</view>
      <view role="button" tabindex="0" data-value="other" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'other' ? 'active' : ''}}">其他</view>

      <view role="button" tabindex="0" data-value="pure_electric" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'pure_electric' ? 'active' : ''}}">纯电</view>
      <view role="button" tabindex="0" data-value="phev" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'phev' ? 'active' : ''}}">插电混动</view>
      <view role="button" tabindex="0" data-value="erev" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'erev' ? 'active' : ''}}">增程</view>
      <view role="button" tabindex="0" data-value="unknown" bindtap="choosePowertrain" class="powertrain-option {{powertrainType === 'unknown' ? 'active' : ''}}">不清楚</view>
    </view>
    <text wx:if="{{powertrainType === 'unknown'}}" class="field-note">请按实际车辆选择动力类型，无法确认时选择“不清楚”。</text>
    <text class="field-note">号码字母不决定动力类型，纯电、混动等均可独立选择。</text>

    <view class="date-row"><text>注册日期</text><picker mode="date" value="{{registrationDate}}" bindchange="dateChange"><view class="picker-value"><text>{{registrationDate}}</text><image src="/assets/icons/caret-right.png"/></view></picker></view>
  </view>

  <view class="surface validity-card">
    <view class="validity-heading"><text>检验有效期记录</text><text>可选，不强制填写</text></view>
    <text class="validity-copy">只有您明确依据交管12123或行驶证确认的月份，才会作为车辆真实记录展示。</text>
    <view wx:if="{{legacyUnverifiedDate}}" class="legacy-note">历史档案记录为 {{legacyUnverifiedDate}}，但来源无法确认，请勿直接作为官方日期使用。</view>
    <view class="validity-mode">
      <view role="button" tabindex="0" data-value="unconfirmed" bindtap="setValidityMode" class="validity-option {{!validityConfirmed ? 'active' : ''}}">没有查到，暂不确认</view>
      <view role="button" tabindex="0" data-value="confirmed" bindtap="setValidityMode" class="validity-option {{validityConfirmed ? 'active' : ''}}">我已核对</view>
    </view>
    <block wx:if="{{validityConfirmed}}">
      <view class="date-row"><text>看到的有效期止月份</text><picker mode="date" fields="month" value="{{validThroughMonth}}" bindchange="validityMonthChange"><view class="picker-value"><text>{{validThroughMonth || '请选择'}}</text><image src="/assets/icons/caret-right.png"/></view></picker></view>
      <view class="date-row {{validThroughMonth ? '' : 'disabled'}}"><text>看到信息的位置</text><picker disabled="{{!validThroughMonth}}" mode="selector" range="{{validitySources}}" range-key="label" value="{{validitySourceIndex}}" bindchange="validitySourceChange"><view class="picker-value"><text>{{!validThroughMonth ? '请先选择月份' : validitySourceSelected ? validitySources[validitySourceIndex].label : '请选择来源'}}</text><image src="/assets/icons/caret-right.png"/></view></picker></view>
      <text wx:if="{{validThroughMonth && validitySourceSelected}}" class="confirm-copy">保存后显示为“用户根据{{validitySources[validitySourceIndex].label}}确认”；本功能只记录您主动提供的信息。</text>
      <text wx:else class="confirm-copy">不会使用规则估算或历史占位日期替你确认。</text>
    </block>
  </view>

  <button class="primary-button save" loading="{{saving}}" bindtap="submit">{{nextAfterSave === 'inspection_booking' ? '保存并继续预约' : '保存车辆'}}</button>
  <text class="form-disclosure">本页面仅保存合成演示数据，不上传真实证件</text>
</view>

<block wx:if="{{catalogOpen}}">
  <view class="keyboard-mask" catchtap="closeCatalog" catchtouchmove="noop"></view>
  <view class="vehicle-catalog-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="catalog-heading">
      <view><text>选择品牌车型</text><text>当前按“{{plateCategories[plateCategoryIndex].label}}”筛选</text></view>
      <button catchtap="closeCatalog">{{selectedModelId ? '使用此车型' : '完成'}}</button>
    </view>
    <view wx:if="{{catalogLoading}}" class="catalog-loading">正在读取车型库…</view>
    <view wx:elif="{{catalogError}}" class="catalog-empty">
      <text>车型库暂时未能加载</text><text>请检查网络后重试，已选车型会保留</text>
      <button bindtap="loadCatalog">重新加载</button>
    </view>
    <block wx:else>
      <view class="catalog-search">
        <input aria-label="搜索品牌或车型" placeholder="搜索品牌或车型，如大众 / 朗逸" value="{{catalogQuery}}" bindinput="searchCatalog" maxlength="60" confirm-type="search"/>
        <button wx:if="{{catalogQuery}}" aria-label="清空搜索" bindtap="clearCatalogSearch">清空</button>
      </view>
      <text class="catalog-summary">{{catalogQuery ? '找到 ' : '可选 '}}{{catalogBrandOptions.length}} 个品牌 · {{catalogMatchCount}} 款统一展示车型</text>
      <view wx:if="{{catalogBrandOptions.length}}" class="catalog-browser">
        <scroll-view scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="catalog-{{activeBrandId}}" class="brand-selector">
          <button wx:for="{{catalogBrandOptions}}" wx:key="id" id="catalog-{{item.id}}" data-id="{{item.id}}" catchtap="chooseCatalogBrand" aria-label="{{item.name}}" class="{{activeBrandId === item.id ? 'active' : ''}}">
            <image wx:if="{{item.logoUrl}}" src="{{item.logoUrl}}" mode="aspectFit" webp="{{true}}"/><text>{{item.name}}</text>
          </button>
        </scroll-view>
        <view class="catalog-models">
          <text class="catalog-model-heading">{{activeBrandName}} · {{activeModels.length}} 款</text>
          <scroll-view scroll-y scroll-into-view="models-top-{{catalogScrollRevision}}" class="model-selector">
            <view id="models-top-{{catalogScrollRevision}}"></view>
            <view class="model-grid">
              <button wx:for="{{activeModels}}" wx:key="id" data-id="{{item.id}}" catchtap="chooseCatalogModel" aria-label="选择{{activeBrandName}}{{item.name}}" class="{{selectedModelId === item.id ? 'selected' : ''}}">
                <view class="model-image-shell">
                  <image wx:if="{{!item.imageLoadFailed}}" src="{{item.imageUrl}}" mode="aspectFit" webp="{{true}}" lazy-load="{{true}}" data-id="{{item.id}}" binderror="catalogModelImageError"/>
                  <view wx:else class="model-image-fallback"><image src="/assets/icons/car.png" mode="aspectFit"/><text>图片暂不可用</text></view>
                </view>
                <view class="model-copy"><text>{{item.name}}</text><text>{{selectedModelId === item.id ? '已选中，请点使用此车型' : '统一角度车型展示图'}}</text></view>
              </button>
            </view>
          </scroll-view>
        </view>
      </view>
      <view wx:else class="catalog-empty"><text>未找到可选车型</text><text>试试品牌名称或更短的车系名</text><button bindtap="clearCatalogSearch">查看全部车型</button></view>
    </block>
    <button class="clear-catalog" catchtap="clearCatalogSelection">暂不设置品牌车型</button>
  </view>
</block>
