.vehicle-copy { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.vehicle-copy text:first-child { overflow: hidden; color: #17273c; font-size: 28rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.vehicle-copy text:last-child { overflow: hidden; color: #7d8b9d; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.vehicle-action { display: flex; align-items: center; gap: 3rpx; color: #1768cf; font-size: 20rpx; font-weight: 750; }
.vehicle-action image { width: 26rpx; height: 26rpx; opacity: .68; }
.loading-card { opacity: .78; }
.add-vehicle { color: inherit; }
.pricing-section { overflow: hidden; }
.value-input { display: flex; min-height: 92rpx; padding: 0 20rpx; align-items: center; border: 2rpx solid #dce5ee; border-radius: 20rpx; background: #fbfdff; }
