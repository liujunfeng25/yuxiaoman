.shop-quote-page { padding-top: 16rpx; padding-bottom: calc(158rpx + env(safe-area-inset-bottom)); background: #f6f9fc; }
.quote-loading { min-height: 420rpx; }
.demo-line { display: flex; min-height: 46rpx; margin: 0 3rpx 8rpx; align-items: center; justify-content: flex-end; gap: 7rpx; color: #6e7e91; font-size: 19rpx; }
.demo-line image { width: 25rpx; height: 25rpx; }

.request-summary { display: grid; padding: 25rpx 24rpx; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16rpx; border: 1rpx solid #cfe3fa; border-radius: 27rpx; background: #edf6ff; }
.summary-icon { display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; border-radius: 23rpx; background: #fff; }
.summary-icon image { width: 46rpx; height: 46rpx; }
.request-summary > view:nth-child(2) { display: flex; min-width: 0; flex-direction: column; }
.request-summary > view:nth-child(2) text:first-child { overflow: hidden; color: #10213a; font-size: 29rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.request-summary > view:nth-child(2) text:nth-child(2) { margin-top: 3rpx; color: #52667e; font-size: 20rpx; }
.request-summary > view:nth-child(2) text:last-child { margin-top: 3rpx; overflow: hidden; color: #77879a; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.request-summary > image { width: 58rpx; height: 58rpx; opacity: .15; }

.preset-note { display: grid; margin-top: 14rpx; padding: 17rpx 20rpx; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 11rpx; border-radius: 18rpx; background: #eaf3ff; }
.preset-note > image { width: 31rpx; height: 31rpx; }
.preset-note > view { display: flex; flex-direction: column; }
.preset-note text:first-child { color: #27557f; font-size: 20rpx; font-weight: 800; }
.preset-note text:last-child { margin-top: 2rpx; color: #697f96; font-size: 17rpx; }

.quote-form { margin-top: 17rpx; padding: 25rpx 24rpx; border: 1rpx solid #dfe7f0; border-radius: 27rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(31, 57, 88, .05); }
.form-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 15rpx; }
.form-heading text:first-child { color: #111e31; font-size: 29rpx; font-weight: 850; }
.form-heading text:last-child { color: #7a889a; font-size: 17rpx; }
.price-field { display: grid; min-height: 116rpx; margin-top: 20rpx; padding: 0 19rpx; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 8rpx; border: 2rpx solid #c7dcf5; border-radius: 20rpx; background: #f8fbff; }
.price-field.invalid { border-color: #e79682; background: #fff8f5; }
.price-field > text { color: #eb6508; font-size: 35rpx; font-weight: 850; }
.price-field input { width: 100%; height: 105rpx; color: #e85f05; font-size: 55rpx; font-weight: 850; letter-spacing: -.8rpx; }
.input-placeholder { color: #b4bfca; font-size: 33rpx; font-weight: 600; }
.price-field > view { display: flex; align-items: flex-end; flex-direction: column; }
.price-field > view text:first-child { color: #3f5269; font-size: 20rpx; font-weight: 750; }
.price-field > view text:last-child { margin-top: 2rpx; color: #8290a1; font-size: 16rpx; }
.price-preview { display: flex; min-height: 44rpx; align-items: flex-end; justify-content: flex-end; gap: 7rpx; color: #8190a2; font-size: 17rpx; }
.price-preview text:last-child { color: #eb6508; font-size: 21rpx; font-weight: 800; }
.field-error { display: block; margin-top: 7rpx; color: #c44f3c; font-size: 18rpx; }
.divider { margin: 18rpx 0 19rpx; border-top: 1rpx solid #e8edf3; }
.note-label { display: flex; align-items: center; justify-content: space-between; }
.note-label text:first-child { color: #26384f; font-size: 21rpx; font-weight: 800; }
.note-label text:last-child { color: #8a96a5; font-size: 17rpx; }
.note-field { display: grid; min-height: 86rpx; margin-top: 11rpx; padding: 0 17rpx; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 11rpx; border: 1rpx solid #dce5ee; border-radius: 17rpx; background: #f8fafc; }
.note-field.invalid { border-color: #e7a090; background: #fff9f7; }
.note-field image { width: 31rpx; height: 31rpx; }
.note-field input { width: 100%; height: 80rpx; color: #2d4058; font-size: 20rpx; }
.included-copy { display: grid; margin-top: 18rpx; padding: 15rpx 16rpx; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 9rpx; border-radius: 14rpx; color: #657990; background: #edf5ff; font-size: 17rpx; line-height: 1.5; }
.included-copy image { width: 27rpx; height: 27rpx; }

.privacy-card { display: grid; margin-top: 16rpx; padding: 20rpx 21rpx; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 12rpx; border: 1rpx solid #e0e7ef; border-radius: 21rpx; background: #fff; }
.privacy-card > image { width: 34rpx; height: 34rpx; }
.privacy-card > view { display: flex; flex-direction: column; }
.privacy-card text:first-child { color: #30435b; font-size: 21rpx; font-weight: 800; }
.privacy-card text:last-child { margin-top: 4rpx; color: #748398; font-size: 18rpx; line-height: 1.5; }
.inline-error { display: flex; margin-top: 15rpx; padding: 17rpx 19rpx; align-items: center; gap: 9rpx; color: #a6533d; border-radius: 16rpx; background: #fff1ec; font-size: 18rpx; }
.inline-error image { width: 28rpx; height: 28rpx; }

.quote-footer { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: grid; min-height: 124rpx; padding: 17rpx 28rpx calc(17rpx + env(safe-area-inset-bottom)); grid-template-columns: 1fr; gap: 12rpx; border-top: 1rpx solid #e1e8f0; background: rgba(255, 255, 255, .98); box-shadow: 0 -10rpx 30rpx rgba(22, 58, 98, .075); box-sizing: border-box; }
.quote-footer.with-withdraw { grid-template-columns: 190rpx minmax(0, 1fr); }
.quote-footer button { min-height: 82rpx; border-radius: 18rpx; font-size: 21rpx; font-weight: 800; }
.withdraw-button { color: #d04d4d; border: 1rpx solid #efc0c0; background: #fff7f7; }
.submit-button { color: #fff; background: #1677ff; box-shadow: 0 10rpx 23rpx rgba(22, 119, 255, .19); }
.quote-error { display: flex; min-height: 340rpx; margin-top: 90rpx; padding: 32rpx; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid #e1e8f0; border-radius: 25rpx; background: #fff; text-align: center; }
.quote-error image { width: 60rpx; height: 60rpx; }
.quote-error text:nth-of-type(1) { margin-top: 15rpx; color: #26374c; font-size: 28rpx; font-weight: 800; }
.quote-error text:nth-of-type(2) { margin-top: 6rpx; color: #788698; font-size: 20rpx; }
.quote-error button { min-width: 190rpx; min-height: 70rpx; margin-top: 18rpx; color: #1677ff; border: 1rpx solid #cfe0f4; border-radius: 16rpx; background: #f6faff; font-size: 21rpx; }

@media (max-width: 340px) {
  .shop-quote-page { padding-right: 22rpx; padding-left: 22rpx; }
  .request-summary > image { display: none; }
  .request-summary { grid-template-columns: auto minmax(0, 1fr); }
  .quote-footer { padding-right: 22rpx; padding-left: 22rpx; }
  .quote-footer.with-withdraw { grid-template-columns: 158rpx minmax(0, 1fr); }
}
