.demo-notice > view text:last-child { font-size: 19rpx; line-height: 1.5; }
.section-block { margin-bottom: 22rpx; padding: 28rpx 26rpx; border: 2rpx solid #e2e9f1; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(31, 66, 105, .045); }
.section-heading { display: flex; margin-bottom: 22rpx; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.section-heading > view { display: flex; min-width: 0; flex-direction: column; gap: 5rpx; }
