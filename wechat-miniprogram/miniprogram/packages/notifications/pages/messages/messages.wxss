page { background: #f3f7fb; }
button::after { border: 0; }
.messages-page { min-height: 100vh; padding: 18rpx 22rpx calc(54rpx + env(safe-area-inset-bottom)); color: #20364d; background: linear-gradient(180deg,#edf5fd 0,#f4f7fb 370rpx); box-sizing: border-box; }
.message-hero { position: relative; min-height: 262rpx; padding: 27rpx 25rpx; overflow: hidden; color: #fff; border-radius: 25rpx; background: linear-gradient(135deg,#0f5fbd 0%,#1678d6 58%,#27a0e6 100%); box-shadow: 0 16rpx 38rpx rgba(20,102,184,.2); box-sizing: border-box; }
.hero-orbit { position: absolute; border: 1rpx solid rgba(255,255,255,.16); border-radius: 50%; }
.orbit-one { top: -112rpx; right: -78rpx; width: 320rpx; height: 320rpx; }
.orbit-two { right: 86rpx; bottom: -100rpx; width: 220rpx; height: 220rpx; }
.hero-copy { position: relative; display: flex; flex-direction: column; }
.hero-copy text:first-child { color: #b9ddff; font-size: 18rpx; font-weight: 760; letter-spacing: 2rpx; }
.hero-copy text:nth-child(2) { margin-top: 7rpx; font-size: 40rpx; font-weight: 900; }
.hero-copy text:last-child { margin-top: 7rpx; color: rgba(255,255,255,.78); font-size: 19rpx; }
.hero-summary { position: relative; display: flex; width: 100%; margin-top: 23rpx; padding: 11rpx 0; border: 1rpx solid rgba(255,255,255,.16); border-radius: 15rpx; background: rgba(5,49,101,.16); box-sizing: border-box; }
.hero-summary view { display: flex; width: 33.333%; align-items: center; flex-direction: column; }
.hero-summary view + view { border-left: 1rpx solid rgba(255,255,255,.18); }
.hero-summary text:first-child { font-size: 28rpx; font-weight: 900; }
.hero-summary text:last-child { margin-top: 1rpx; color: rgba(255,255,255,.72); font-size: 15rpx; }
.privacy-note { display: grid; margin-top: 14rpx; padding: 14rpx 16rpx; grid-template-columns: 30rpx minmax(0,1fr); align-items: start; gap: 9rpx; color: #647b91; border: 1rpx solid #d7e5f2; border-radius: 15rpx; background: rgba(255,255,255,.85); font-size: 17rpx; line-height: 1.55; }
.privacy-note image { width: 28rpx; height: 28rpx; }
.wechat-reminder-card { display: grid; margin-top: 14rpx; padding: 20rpx; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 18rpx; border: 1rpx solid #cfe1f2; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(29,64,101,.05); }
.wechat-reminder-copy { display: flex; min-width: 0; flex-direction: column; }
.wechat-reminder-copy > text:first-child { color: #24415d; font-size: 22rpx; font-weight: 860; }
.wechat-reminder-copy > text:nth-child(2) { margin-top: 6rpx; color: #70859a; font-size: 17rpx; line-height: 1.5; }
.wechat-reminder-copy .wechat-reminder-status { margin-top: 7rpx; color: #1768cf; font-size: 16rpx; font-weight: 760; }
.wechat-reminder-card > button { min-width: 154rpx; min-height: 88rpx; margin: 0; padding: 0 18rpx; color: #fff; border-radius: 14rpx; background: #1768cf; font-size: 18rpx; font-weight: 820; line-height: 88rpx; }
.wechat-reminder-card > button[disabled] { opacity: .62; }
.message-toolbar { display: flex; margin: 20rpx 2rpx 12rpx; align-items: center; justify-content: space-between; gap: 12rpx; }
.filter-tabs { display: flex; min-width: 0; padding: 5rpx; border: 1rpx solid #d8e5f1; border-radius: 15rpx; background: #fff; }
.filter-tabs button { min-height: 70rpx; margin: 0; padding: 0 19rpx; color: #688096; border-radius: 11rpx; background: transparent; font-size: 18rpx; font-weight: 780; line-height: 70rpx; }
.filter-tabs button.active { color: #1768cf; background: #e8f3ff; }
.filter-tabs button[disabled] { opacity: .6; }
.read-all { min-height: 80rpx; margin: 0; padding: 0 14rpx; color: #1768cf; background: transparent; font-size: 17rpx; font-weight: 800; line-height: 80rpx; }
.read-all[disabled] { color: #9eabb8; opacity: .72; }
.message-list { display: flex; flex-direction: column; gap: 13rpx; }
.message-card { display: grid; width: 100%; min-height: 176rpx; margin: 0; padding: 20rpx; grid-template-columns: 54rpx minmax(0,1fr); gap: 14rpx; color: #20364d; border: 1rpx solid #dfe8f0; border-left: 7rpx solid #a8b8c7; border-radius: 20rpx; background: #fff; box-shadow: 0 9rpx 25rpx rgba(29,64,101,.055); text-align: left; line-height: normal; box-sizing: border-box; }
.message-card.tone-attention { border-left-color: #e39a36; }.message-card.tone-overdue { border-left-color: #cf554d; }
.message-card.is-read { background: rgba(255,255,255,.76); box-shadow: none; }.message-card[disabled] { opacity: .68; }
.message-icon { position: relative; display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 15rpx; background: #e8f3ff; }
.message-icon image { width: 29rpx; height: 29rpx; }.tone-attention .message-icon { background: #fff2df; }.tone-overdue .message-icon { background: #ffeded; }
.message-icon > text { position: absolute; top: -4rpx; right: -4rpx; width: 15rpx; height: 15rpx; border: 3rpx solid #fff; border-radius: 50%; background: #1768cf; box-sizing: border-box; }
.message-content { display: flex; min-width: 0; flex-direction: column; }
.message-meta { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 12rpx; }
.message-meta > view { display: flex; min-width: 0; align-items: center; gap: 8rpx; }
.message-meta > view > text:first-child { color: #1768cf; font-size: 16rpx; font-weight: 820; }
.message-meta > text { flex: 0 0 auto; color: #96a5b3; font-size: 15rpx; }
.urgency { padding: 5rpx 8rpx; color: #64788c; border-radius: 999rpx; background: #eff3f7; font-size: 14rpx; font-weight: 780; }
.urgency-attention { color: #a55b0e; background: #fff1db; }.urgency-overdue { color: #ae433c; background: #ffedeb; }
.message-title { margin-top: 11rpx; overflow: hidden; color: #233d56; font-size: 23rpx; font-weight: 880; text-overflow: ellipsis; white-space: nowrap; }
.message-body { display: -webkit-box; margin-top: 7rpx; overflow: hidden; color: #65798c; font-size: 18rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.message-facts { display: flex; margin-top: 11rpx; padding-top: 10rpx; align-items: center; justify-content: space-between; gap: 12rpx; color: #8292a2; border-top: 1rpx solid #edf1f5; font-size: 15rpx; }
.message-facts text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.message-facts text:last-child { flex: 0 0 auto; font-weight: 760; }
.due-attention { color: #a65a0c; }.due-overdue { color: #b2433e; }
.message-action { display: flex; min-height: 54rpx; margin-top: 5rpx; align-items: center; justify-content: flex-end; color: #1768cf; font-size: 17rpx; font-weight: 820; }
.message-action image { width: 25rpx; height: 25rpx; margin-left: 3rpx; }
.message-skeleton { display: flex; padding-top: 2rpx; flex-direction: column; gap: 13rpx; text-align: center; }
.message-skeleton view { height: 188rpx; border-radius: 20rpx; background: linear-gradient(100deg,#edf2f6 15%,#f8fafc 38%,#edf2f6 62%); background-size: 300% 100%; animation: shimmer 1.3s infinite; }
.message-skeleton text { margin-top: 7rpx; color: #8a9baa; font-size: 18rpx; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.state-card { display: flex; min-height: 390rpx; padding: 46rpx 30rpx; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid #dfe8f0; border-radius: 22rpx; background: #fff; box-sizing: border-box; }
.state-card image { width: 62rpx; height: 62rpx; }.state-card > text:nth-child(2) { margin-top: 18rpx; color: #294158; font-size: 27rpx; font-weight: 880; }
.state-card > text:nth-child(3) { max-width: 500rpx; margin-top: 9rpx; color: #7d8e9e; font-size: 18rpx; line-height: 1.6; text-align: center; }
.state-card button { min-width: 210rpx; min-height: 88rpx; margin-top: 24rpx; color: #fff; border-radius: 15rpx; background: #1768cf; font-size: 19rpx; font-weight: 820; line-height: 88rpx; }
.inline-error { display: grid; min-height: 84rpx; margin-bottom: 12rpx; padding: 10rpx 13rpx; grid-template-columns: 28rpx minmax(0,1fr) auto; align-items: center; gap: 8rpx; color: #9b4a44; border: 1rpx solid #f0d0cd; border-radius: 14rpx; background: #fff2f1; box-sizing: border-box; }
.inline-error image { width: 26rpx; height: 26rpx; }.inline-error text { font-size: 16rpx; }.inline-error button { min-height: 64rpx; margin: 0; padding: 0 11rpx; color: #b54841; background: transparent; font-size: 16rpx; line-height: 64rpx; }
.load-more { width: 100%; min-height: 88rpx; margin-top: 15rpx; color: #1768cf; border: 1rpx solid #cbddec; border-radius: 15rpx; background: #fff; font-size: 18rpx; font-weight: 800; line-height: 88rpx; }
.list-state { display: flex; min-height: 82rpx; align-items: center; justify-content: center; color: #93a1ae; font-size: 16rpx; }.load-error { gap: 10rpx; color: #a45a54; }.load-error button { min-height: 64rpx; margin: 0; padding: 0 12rpx; color: #1768cf; background: transparent; font-size: 16rpx; line-height: 64rpx; }
