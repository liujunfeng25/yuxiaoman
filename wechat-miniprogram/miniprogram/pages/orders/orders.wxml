<wxs module="fmt" src="../../utils/format.wxs" />

<view class="page">
  <view class="orders-heading-row"><view class="heading"><text class="heading-eyebrow">OWNER SERVICE</text><text class="heading-title">订单</text><text class="heading-copy">洗车、年检与维修询价记录统一查看</text></view><workflow-bell compact="{{true}}" unread-count="{{unreadCount}}" bind:open="openMessages" /></view>
  <view wx:if="{{loading}}" class="loading">正在读取订单…</view>
  <block wx:else>
    <view role="button" tabindex="0" wx:for="{{orders}}" wx:key="id" data-url="{{item.detailUrl}}" bindtap="open" class="order surface">
      <view class="order-header">
        <view class="order-state"><view class="service-icon"><image wx:if="{{item.serviceLabel === '洗车'}}" src="../../assets/icons/drop.png"/><image wx:elif="{{item.serviceLabel === '维修'}}" src="../../assets/icons/wrench.png"/><image wx:else src="../../assets/icons/calendar-check.png"/></view><text class="service-tag service-{{item.serviceLabel === '洗车' ? 'wash' : item.serviceLabel === '维修' ? 'repair' : 'inspection'}}">{{item.serviceLabel}}</text><text class="status">{{item.status}}</text></view>
        <text class="order-number">{{item.number}}</text>
      </view>
      <text class="name">{{item.name}}</text>
      <text class="station">{{item.storeName}}</text>
      <view class="footer"><view><image src="../../assets/icons/clock.png"/><text>{{item.appointment}}</text></view><view><text wx:if="{{item.showPrice}}">¥{{fmt.money(item.priceFen)}}</text><text wx:else>{{item.priceText}}</text><image src="../../assets/icons/caret-right.png"/></view></view>
    </view>
  </block>
  <view wx:if="{{!loading && !orders.length}}" class="surface empty order-empty"><image src="../../assets/icons/receipt.png"/><text>暂无服务记录</text><text>洗车、年检和维修询价进度会集中显示在这里</text><view class="empty-actions"><view role="button" tabindex="0" class="empty-action" bindtap="wash">预约洗车</view><view role="button" tabindex="0" class="empty-action primary" bindtap="book">预约年检</view></view></view>
</view>
