{
  "name": "yuxiaoman-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "check:used-car-assets": "node scripts/check-used-car-real-assets.mjs",
    "check:owner-vehicle-assets": "node scripts/check-owner-vehicle-assets.mjs && tsx scripts/check-owner-vehicle-presentation-inventory.ts",
    "export:owner-vehicle-presentation-inventory": "tsx scripts/export-owner-vehicle-presentation-inventory.ts",
    "probe:owner-vehicle-imagin": "tsx scripts/probe-owner-vehicle-imagin-coverage.ts",
    "probe:owner-vehicle-commons": "tsx scripts/probe-owner-vehicle-commons-coverage.ts",
    "promote:owner-vehicle-commons": "node scripts/promote-owner-vehicle-commons-selections.mjs",
    "approve:owner-vehicle-presentation": "node scripts/approve-owner-vehicle-presentation-batch.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "node scripts/run-postgres-playwright.mjs mobile",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:entrypoints": "node --test tests/mini-api-entrypoint.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "api:dev": "tsx watch server/index.ts",
    "workflow:worker": "tsx server/workflow-worker-entry.ts",
    "api:mini": "tsx watch scripts/start-mini-api.mjs",
    "api:mini:qa-map": "tsx watch scripts/start-mini-api-qa-map.mjs",
    "demo:load-annual-local": "tsx scripts/load-local-annual-inspection-demo.ts",
    "backoffice:create-admin": "tsx scripts/create-backoffice-admin.ts",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "admin:test": "npm --prefix admin run test",
    "api:test": "tsx --test --test-concurrency=1 server/tests/api.test.ts server/tests/auth.test.ts server/tests/backoffice.test.ts server/tests/database.test.ts server/tests/finance.test.ts server/tests/insurance.test.ts server/tests/subsidy-consultation.test.ts server/tests/inspection.test.ts server/tests/plate.test.ts server/tests/used-cars.test.ts server/tests/car-rental.test.ts server/tests/driving-school.test.ts server/tests/repair-marketplace.test.ts server/tests/workflow-core.test.ts server/tests/workflow-integration.test.ts server/tests/workflow-admin-api.test.ts server/tests/wechat-pay.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run check:used-car-assets && npm run check:owner-vehicle-assets && npm run test:entrypoints && npm run api:test && npm run test:runtime && npm run test:sites && npm run admin:test",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:all": "npm run build && npm run admin:build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@types/node": "^26.1.1",
    "@use-gesture/react": "10.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.11.3",
    "motion": "12.42.2",
    "pg": "^8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.3"
  }
}
