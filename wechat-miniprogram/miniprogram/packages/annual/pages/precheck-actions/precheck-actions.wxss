.actions-page{min-height:100vh;padding:24rpx 26rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#f4f8fc;color:#17283e}.summary,.card{padding:28rpx;border:1rpx solid #e1e9f2;border-radius:24rpx;background:#fff}.summary{border-top:6rpx solid #1768cf}.summary-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.summary-head>text:first-child{font-size:36rpx;font-weight:800}.badge,.tag{display:inline-block;color:#996023;background:#fff5e6;border-radius:8rpx;padding:7rpx 12rpx;font-size:22rpx}.title{display:block;margin-top:24rpx;font-size:32rpx;font-weight:750}.subtitle{display:block;margin-top:10rpx;color:#536a82;font-size:24rpx}.money{display:flex;justify-content:space-between;margin:24rpx 0 16rpx;padding-top:20rpx;border-top:1rpx solid #e1e9f2;font-size:25rpx}.money text:last-child{font-weight:800;color:#1768cf}.muted{display:block;color:#60748a;font-size:24rpx;line-height:1.65}.section-title{display:flex;flex-direction:column;gap:6rpx;margin:32rpx 2rpx 16rpx}.section-title>text:first-child{font-size:30rpx;font-weight:750}.section-title>text:last-child{font-size:22rpx;color:#6e8095}.card{margin-bottom:20rpx}.issue{display:flex;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #edf1f6}.issue:first-child{padding-top:0}.issue>image{width:34rpx;height:34rpx;flex:none}.issue>view{flex:1;min-width:0}.issue-title,.card-title{display:block;font-size:28rpx;font-weight:750;line-height:1.5}.tag{margin:12rpx 0;background:#edf5ff;color:#1768cf;font-size:21rpx}.station-note{display:flex;flex-direction:column;gap:10rpx;margin-top:20rpx;font-size:25rpx;line-height:1.6}.station-note text:first-child{font-size:22rpx;color:#6b7e92}.service-card{display:flex;flex-wrap:wrap;gap:18rpx;align-items:flex-start;margin-top:20rpx}.service-card>image,.card-heading>image{width:40rpx;height:40rpx;flex:none}.service-card>view{flex:1;min-width:0}.service-card>button{width:100%;margin-top:4rpx;color:#1768cf;border:1rpx solid #b9d6f8;background:#edf5ff}.card-heading{display:flex;align-items:center;gap:14rpx;margin-bottom:16rpx;font-size:29rpx;font-weight:750}.primary{width:100%;min-height:90rpx;padding:18rpx;color:#fff;border-radius:16rpx;background:#1768cf;font-size:27rpx;font-weight:700;line-height:1.7}.primary[disabled]{color:#a3b0be;background:#e3eaf2}.repair-selection{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.repair-selection button{padding:14rpx 18rpx;margin:0;min-height:80rpx;color:#60748a;border:1rpx solid #dce5ef;background:#f8fafc;font-size:23rpx;line-height:1.5}.repair-selection .selected{color:#1768cf;border-color:#75a9e8;background:#edf5ff}.field-label{display:block;margin:22rpx 0 12rpx;font-size:25rpx;font-weight:700}.share-photos{white-space:nowrap;height:146rpx}.share-photos image{width:140rpx;height:132rpx;margin-right:12rpx;border-radius:12rpx}.consent{display:flex;align-items:flex-start;gap:10rpx;margin:22rpx 0;color:#526980;font-size:23rpx;line-height:1.6}.consent checkbox{flex:none;transform:scale(.88);transform-origin:top left}.consent text{flex:1}.service-link{display:flex;align-items:center;justify-content:space-between;gap:12rpx;width:100%;padding:20rpx 0;margin:0;background:#fff;border-bottom:1rpx solid #edf1f6;text-align:left;font-size:27rpx;line-height:1.6}.service-link image,.slot-picker image{width:28rpx;height:28rpx;flex:none}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:20rpx}.photo{position:relative;min-width:0;padding:10rpx;border:1rpx solid #dce6f0;border-radius:16rpx}.photo>image,.photo-empty{width:100%;height:170rpx;border-radius:10rpx;background:#f4f8fc}.photo-empty{display:flex;align-items:center;justify-content:center}.photo-empty image{width:50rpx;height:50rpx}.photo>text{display:block;margin-top:9rpx;font-size:23rpx}.photo .photo-state{font-size:21rpx;color:#9b632b}.photo .ready{color:#28795b}.photo button{width:100%;min-height:76rpx;padding:12rpx 4rpx;margin-top:12rpx;color:#1768cf;background:#edf5ff;font-size:23rpx;line-height:1.6}.card textarea{width:100%;height:190rpx;padding:18rpx;border:1rpx solid #d7e2ed;border-radius:14rpx;box-sizing:border-box;background:#f9fbfd;font-size:25rpx;line-height:1.6}.slot-picker{display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-height:90rpx;padding:16rpx;border:1rpx solid #d7e2ed;border-radius:14rpx;color:#1768cf;font-size:25rpx;box-sizing:border-box}.slot-picker+.muted{margin-top:12rpx}.footer .refund{width:100%;min-height:88rpx;margin:12rpx 0;color:#b14e45;background:transparent;font-size:25rpx}.footer>.muted{text-align:center;font-size:21rpx}.error,.state{padding:28rpx;margin-bottom:20rpx;color:#a14d45;background:#fff;border-radius:20rpx;font-size:25rpx;line-height:1.6}.error button{color:#1768cf;font-size:25rpx}.state{color:#60748a}button::after{border:none}
.actions-page button.primary,.actions-page .footer>.refund,.actions-page .service-card>button{display:flex;align-items:center;justify-content:center;width:100%;margin-right:0;margin-left:0;min-height:90rpx;line-height:1.6;padding:16rpx}.actions-page .repair-selection>button{display:flex;align-items:center;justify-content:center;width:auto;min-height:88rpx}.actions-page .photo>button{display:flex;align-items:center;justify-content:center;width:100%;margin-left:0;margin-right:0;min-height:88rpx}.actions-page .service-link{width:100%;margin-left:0;margin-right:0}
.actions-page .share-photos image{display:inline-block;vertical-align:top}.actions-page .repair-selection>button{border-radius:14rpx}.actions-page .service-card>button{border-radius:16rpx;font-size:27rpx}.actions-page .section-title{align-items:flex-start;text-align:left}
