.order-page { min-height: 100vh; padding: 18rpx 22rpx 40rpx; color: #17263b; background: #f4f7fb; box-sizing: border-box; }
.status-card { display: grid; padding: 23rpx; grid-template-columns: 58rpx minmax(0,1fr) auto; align-items: center; gap: 13rpx; color: #fff; border-radius: 20rpx; background: linear-gradient(120deg,#1768d4,#278be0); }.status-card.status-warning { background: linear-gradient(120deg,#ec7b24,#f1a244); }.status-card.status-muted { background: linear-gradient(120deg,#6e7a89,#929dab); }.status-icon { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.2); }.status-icon image { width: 34rpx; height: 34rpx; filter: brightness(0) invert(1); }.status-card > view:nth-child(2) { display: flex; flex-direction: column; }.status-card > view:nth-child(2) text:first-child { font-size: 29rpx; font-weight: 900; }.status-card > view:nth-child(2) text:last-child { margin-top: 3rpx; font-size: 18rpx; opacity: .82; }.status-card > text { font-size: 17rpx; opacity: .8; }
.progress-card { display: grid; margin-top: 16rpx; padding: 22rpx 10rpx; grid-template-columns: repeat(5,1fr); border-radius: 18rpx; background: #fff; }.progress-card view { position: relative; display: flex; align-items: center; flex-direction: column; color: #a0a9b5; font-size: 16rpx; }.progress-card view::before { position: absolute; top: 18rpx; right: 50%; left: -50%; height: 3rpx; background: #dfe5ec; content: ""; }.progress-card view:first-child::before { display: none; }.progress-card view > text:first-child { z-index: 1; display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; color: #8995a4; border-radius: 50%; background: #e9edf2; }.progress-card view > text:last-child { margin-top: 7rpx; }.progress-card view.done { color: #1768d4; font-weight: 700; }.progress-card view.done::before,.progress-card view.done > text:first-child { color: #fff; background: #1768d4; }
.model-card { display: grid; margin-top: 16rpx; padding: 14rpx; grid-template-columns: 182rpx 1fr; gap: 13rpx; border-radius: 18rpx; background: #fff; }.model-card > image { width: 182rpx; height: 126rpx; border-radius: 12rpx; background: #edf1f5; }.model-card > view { display: flex; justify-content: center; flex-direction: column; }.model-card > view text:first-child { font-size: 24rpx; font-weight: 900; }.model-card > view text:nth-child(2) { margin-top: 5rpx; color: #788597; font-size: 18rpx; }.model-card > view text:last-child { margin-top: 5rpx; color: #1768d4; font-size: 17rpx; }
.section-card,.deposit-card { margin-top: 16rpx; padding: 21rpx; border-radius: 18rpx; background: #fff; }.section-head { display: flex; padding-bottom: 13rpx; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; }.section-head text:first-child { font-size: 25rpx; font-weight: 900; }.section-head text:last-child { color: #1768d4; font-size: 18rpx; }.place { display: grid; margin-top: 15rpx; grid-template-columns: 42rpx 1fr; gap: 10rpx; }.place > image { width: 38rpx; height: 38rpx; }.place > view { display: flex; flex-direction: column; }.place > view text:first-child { font-size: 20rpx; font-weight: 800; }.place > view text:nth-child(2) { margin-top: 3rpx; font-size: 21rpx; }.place > view text:last-child { margin-top: 2rpx; color: #8490a0; font-size: 17rpx; }.time { display: grid; margin-top: 15rpx; grid-template-columns: repeat(2,1fr); gap: 10rpx; }.time view { display: flex; flex-direction: column; }.time view text:first-child { width: 31rpx; color: #fff; border-radius: 7rpx; background: #1768d4; font-size: 17rpx; text-align: center; }.time view text:last-child { margin-top: 4rpx; font-size: 19rpx; font-weight: 700; }
.driver > view:not(.section-head),.fees > view:not(.section-head) { display: flex; margin-top: 13rpx; justify-content: space-between; color: #657286; font-size: 20rpx; }.driver > view:not(.section-head) text:last-child,.fees > view:not(.section-head) text:last-child { color: #26354a; font-weight: 700; }.fees .total { margin-top: 16rpx!important; padding-top: 15rpx; border-top: 1rpx solid #dfe5ec; font-size: 24rpx!important; font-weight: 900; }.fees .total text:last-child { color: #ee6725!important; font-size: 28rpx; }
.deposit-card { color: #745c36; background: #fff8e8; }.deposit-card > text:first-child { display: block; font-size: 22rpx; font-weight: 900; }.deposit-card > view { display: flex; margin-top: 9rpx; justify-content: space-between; font-size: 20rpx; }.deposit-card > text:last-child { display: block; margin-top: 9rpx; font-size: 17rpx; }.demo-note { margin: 17rpx 0; color: #8d98a7; font-size: 17rpx; text-align: center; }.footer-spacer { height: 130rpx; }
.fixed-footer { position: fixed; z-index: 8; right: 0; bottom: 0; left: 0; display: flex; min-height: 105rpx; padding: 14rpx 22rpx calc(env(safe-area-inset-bottom) + 14rpx); justify-content: flex-end; gap: 11rpx; border-top: 1rpx solid #e5eaf0; background: #fff; box-sizing: border-box; }.fixed-footer button { min-width: 210rpx; min-height: 74rpx; padding: 0 20rpx; color: #1768d4; border: 1rpx solid #bdd3f4; border-radius: 14rpx; font-size: 23rpx; font-weight: 800; }.fixed-footer button:last-child { color: #fff; border-color: #1768d4; background: #1768d4; }.again { display: flex; justify-content: center; }.again button { padding: 15rpx 30rpx; color: #1768d4; border-radius: 999rpx; background: #eaf3ff; font-size: 22rpx; font-weight: 800; }
.loading-card,.state-card { display: flex; margin-top: 60rpx; padding: 50rpx 25rpx; align-items: center; flex-direction: column; border-radius: 20rpx; background: #fff; color: #8995a4; }.loading-card view { width: 100%; height: 150rpx; margin-bottom: 13rpx; border-radius: 14rpx; background: #e8edf3; }.loading-card view:nth-child(2) { height: 300rpx; }.state-card > image { width: 66rpx; height: 66rpx; }.state-title { margin-top: 17rpx; color: #17263b; font-size: 28rpx; font-weight: 900; }.state-copy { margin-top: 8rpx; font-size: 20rpx; }.state-actions { display: flex; margin-top: 20rpx; gap: 12rpx; }.state-card .state-actions button { margin-top: 0; padding: 14rpx 23rpx; color: #1768d4; border: 1rpx solid #bdd3f4; border-radius: 12rpx; background: #fff; }.state-card .state-actions button:last-child { color: #fff; border-color: #1768d4; background: #1768d4; }
