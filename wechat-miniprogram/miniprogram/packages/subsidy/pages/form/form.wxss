.boundary-banner > view text:last-child { opacity: .86; font-size: 20rpx; line-height: 1.45; }
.consultation-content { padding: 24rpx 26rpx 350rpx; }
.state-card { display: flex; min-height: 180rpx; padding: 30rpx; align-items: center; justify-content: center; gap: 8rpx; border: 2rpx solid #dfe8f2; border-radius: 24rpx; color: #758398; background: #fff; flex-direction: column; text-align: center; box-sizing: border-box; }
.state-card > text:first-child { color: #25364c; font-size: 27rpx; font-weight: 800; }
