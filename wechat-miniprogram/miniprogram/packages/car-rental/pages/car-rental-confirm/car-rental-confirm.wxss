.confirm-page { min-height: 100vh; padding: 18rpx 22rpx 0; color: #17263b; background: #f4f7fb; box-sizing: border-box; }
.model-card { display: grid; padding: 15rpx; grid-template-columns: 188rpx minmax(0,1fr); gap: 14rpx; border-radius: 19rpx; background: #fff; }.model-card > image { width: 188rpx; height: 130rpx; border-radius: 13rpx; background: #edf1f5; }.model-card > view { display: flex; min-width: 0; justify-content: center; flex-direction: column; }.model-card > view text:first-child { font-size: 25rpx; font-weight: 900; }.model-card > view text:nth-child(2) { margin-top: 6rpx; color: #6f7d8f; font-size: 18rpx; }.model-card > view text:last-child { margin-top: 6rpx; color: #1768d4; font-size: 17rpx; }
.trip-card,.section-card,.deposit-card { margin-top: 16rpx; padding: 21rpx; border-radius: 19rpx; background: #fff; }.trip-title { display: flex; justify-content: space-between; font-size: 25rpx; font-weight: 900; }.trip-title text:last-child { color: #1768d4; }.store { display: grid; margin-top: 17rpx; padding-bottom: 16rpx; grid-template-columns: 42rpx 1fr; gap: 11rpx; border-bottom: 1rpx solid #edf0f4; }.store > image { width: 38rpx; height: 38rpx; }.store > view { display: flex; flex-direction: column; }.store > view text:first-child { font-size: 22rpx; font-weight: 800; }.store > view text:nth-child(2) { margin-top: 3rpx; color: #7c899a; font-size: 18rpx; }.store > view text:last-child { margin-top: 4rpx; color: #1768d4; font-size: 17rpx; }.time-line { display: grid; margin-top: 15rpx; grid-template-columns: repeat(2,1fr); gap: 10rpx; }.time-line view { display: flex; flex-direction: column; }.time-line view text:first-child { width: 32rpx; color: #fff; border-radius: 7rpx; background: #1768d4; font-size: 18rpx; text-align: center; }.time-line view text:last-child { margin-top: 5rpx; font-size: 20rpx; font-weight: 700; }
.section-heading { display: block; padding-bottom: 13rpx; border-bottom: 1rpx solid #edf0f4; font-size: 26rpx; font-weight: 900; }.form-row { display: grid; min-height: 80rpx; grid-template-columns: 112rpx 1fr; align-items: center; border-bottom: 1rpx solid #edf0f4; }.form-row > text { font-size: 21rpx; font-weight: 700; }.form-row input { text-align: right; font-size: 22rpx; }.license-check { display: flex; margin-top: 17rpx; align-items: flex-start; gap: 8rpx; color: #536277; font-size: 19rpx; }.license-check checkbox { transform: scale(.78); transform-origin: top left; }.privacy-note { display: block; margin-top: 8rpx; color: #98a2af; font-size: 17rpx; }
.mandatory,.optional { display: grid; padding: 16rpx 0; grid-template-columns: 1fr auto; align-items: center; border-bottom: 1rpx solid #edf0f4; }.mandatory > view,.optional > view { display: flex; flex-direction: column; }.mandatory > view text:first-child,.optional > view text:first-child { font-size: 22rpx; font-weight: 800; }.mandatory > view text:last-child,.optional > view text:last-child { margin-top: 3rpx; color: #8793a3; font-size: 17rpx; }.mandatory > text,.optional > text { color: #ee6725; font-size: 21rpx; font-weight: 800; }.optional { grid-template-columns: 45rpx 1fr auto; border-bottom: 0; }.optional checkbox { transform: scale(.8); }
.section-heading-row { display: flex; padding-bottom: 13rpx; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; }.section-heading-row text:first-child { font-size: 26rpx; font-weight: 900; }.section-heading-row text:last-child { color: #1768d4; font-size: 18rpx; }.fees > view:not(.section-heading-row) { display: flex; margin-top: 13rpx; justify-content: space-between; color: #536176; font-size: 20rpx; }.fees > view:not(.section-heading-row) text:last-child { color: #26354a; font-weight: 700; }.fees .fee-total { margin-top: 17rpx!important; padding-top: 16rpx; border-top: 1rpx solid #dfe5ec; color: #17263b!important; font-size: 24rpx!important; font-weight: 900; }.fees .fee-total text:last-child { color: #ee6725!important; font-size: 28rpx; }.fee-expiry { display: block; margin-top: 11rpx; color: #929dab; font-size: 16rpx; text-align: right; }
.deposit-card { color: #745c36; background: #fff8e8; }.deposit-card > view { display: flex; margin-top: 9rpx; justify-content: space-between; font-size: 20rpx; }.deposit-card > view:first-child { margin-top: 0; padding-bottom: 8rpx; align-items: center; justify-content: flex-start; gap: 8rpx; font-weight: 900; }.deposit-card > view:first-child image { width: 30rpx; height: 30rpx; }.deposit-card > text { display: block; margin-top: 9rpx; font-size: 17rpx; }.demo-notice { margin: 16rpx 10rpx; color: #8c97a6; font-size: 17rpx; text-align: center; }.footer-spacer { height: 145rpx; }
.fixed-footer { position: fixed; z-index: 9; right: 0; bottom: 0; left: 0; display: grid; min-height: 112rpx; padding: 14rpx 22rpx calc(env(safe-area-inset-bottom) + 14rpx); grid-template-columns: 1fr 260rpx; align-items: center; gap: 12rpx; border-top: 1rpx solid #e5eaf0; background: #fff; box-sizing: border-box; }.fixed-footer > view { display: flex; flex-direction: column; }.fixed-footer > view text:first-child { color: #ee6725; font-size: 29rpx; font-weight: 900; }.fixed-footer > view text:last-child { color: #8d98a7; font-size: 17rpx; }.fixed-footer button { min-height: 76rpx; color: #fff; border-radius: 15rpx; background: #1768d4; font-size: 27rpx; font-weight: 900; }
.loading-card,.state-card { display: flex; margin-top: 50rpx; padding: 45rpx 25rpx; align-items: center; flex-direction: column; border-radius: 20rpx; background: #fff; color: #8793a3; }.loading-card view { width: 100%; height: 150rpx; margin-bottom: 14rpx; border-radius: 14rpx; background: #e8edf3; }.loading-card view:nth-child(2) { height: 240rpx; }.state-card > image { width: 66rpx; height: 66rpx; }.state-title { margin-top: 17rpx; color: #17263b; font-size: 28rpx; font-weight: 900; }.state-copy { margin-top: 8rpx; font-size: 20rpx; text-align: center; }.state-card > view { display: flex; margin-top: 22rpx; gap: 10rpx; }.state-card button { padding: 14rpx 22rpx; color: #1768d4; border-radius: 12rpx; background: #eaf3ff; }.state-card button:last-child { color: #fff; background: #1768d4; }
