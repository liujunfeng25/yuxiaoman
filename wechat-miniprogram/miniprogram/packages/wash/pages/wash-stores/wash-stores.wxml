<wxs module="fmt" src="../../../../utils/format.wxs" />
<view class="wash-stores-page">
  <view class="flow-kicker">
    <image src="/assets/icons/storefront.png" mode="aspectFit" />
    <text>洗车预约 · 选择门店</text>
  </view>

  <view class="page-heading">
    <text>选一家合适的洗车店</text>
    <text>按距离、当前车型价格和最近可约时间比较，门店均为演示数据。</text>
  </view>

  <view wx:if="{{!loading && !error}}" class="selection-context surface">
    <view class="context-vehicle">
      <view class="context-icon"><image src="/assets/icons/car.png" mode="aspectFit" /></view>
      <view class="context-copy">
        <text>{{vehicle.plateNumber}} · {{vehicleCategoryLabel}}价类</text>
        <text>卡片起价仅读取该车型在当前门店的可用套餐</text>
      </view>
    </view>
    <view class="context-divider"></view>
    <view class="context-origin">
      <image src="/assets/icons/map-pin.png" mode="aspectFit" />
      <view>
        <text>{{originTitle}}</text>
        <text>{{originDescription}}</text>
      </view>
      <button wx:if="{{serviceMode === 'self_drive'}}" loading="{{locating}}" disabled="{{locating}}" bindtap="locate">{{originLat === null ? '使用当前位置' : '重新定位'}}</button>
    </view>
  </view>

  <view wx:if="{{!loading && !error}}" class="distance-notice">
    <image src="/assets/icons/shield-check.png" mode="aspectFit" />
    <text>列表距离会明确标注来源；代驾最终费用仍以预约页的真实驾车路线报价为准。</text>
  </view>

  <view wx:if="{{loading}}" class="store-loading">
    <view class="loading-cover"></view>
    <view class="loading-lines"><view></view><view></view><view></view></view>
    <text>正在读取门店详情和当前车型价格…</text>
  </view>

  <view wx:elif="{{error}}" class="store-error surface">
    <image src="/assets/icons/warning-circle.png" mode="aspectFit" />
    <text>暂时无法读取洗车门店</text>
    <text>{{error}}</text>
    <button class="secondary-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view wx:for="{{stores}}" wx:key="id" class="wash-store-card surface {{selectedStoreId === item.id ? 'selected' : ''}}">
      <view class="store-media" data-id="{{item.id}}" data-url="{{item.coverSrc}}" bindtap="previewImage" role="button" aria-label="查看{{item.name}}门店图片">
        <image src="{{item.coverSrc}}" mode="aspectFill" webp="{{true}}" data-id="{{item.id}}" binderror="coverError" />
        <view class="media-badges">
          <text class="demo-badge">演示门店</text>
          <text wx:if="{{selectedStoreId === item.id}}" class="selected-badge">当前选择</text>
        </view>
        <text wx:if="{{item.usesFallbackCover}}" class="fallback-label">服务环境示意</text>
        <view wx:if="{{item.imageCount}}" class="image-count">
          <image src="/assets/icons/camera.png" mode="aspectFit" />
          <text>{{item.imageCount}} 张</text>
        </view>
      </view>

      <view class="store-main">
        <view class="store-title-row">
          <view>
            <text class="store-name">{{item.name}}</text>
            <text wx:if="{{item.rating}}" class="store-rating">{{item.rating}} 分 · {{item.reviewCount || 0}} 条演示评价</text>
          </view>
          <text class="open-state {{item.isOpen === false ? 'closed' : ''}}">{{item.openStateLabel}}</text>
        </view>

        <view class="store-metrics">
          <view class="metric distance-metric">
            <text>距起点</text>
            <text>{{item.distanceText}}</text>
            <text>{{item.distanceSourceLabel}}</text>
          </view>
          <view class="metric price-metric">
            <text>{{vehicleCategoryLabel}}起</text>
            <text wx:if="{{item.priceLoading}}">查询中</text>
            <text wx:elif="{{item.priceError}}" class="metric-error">读取失败</text>
            <text wx:elif="{{item.currentVehiclePriceFen !== null}}">¥{{fmt.money(item.currentVehiclePriceFen)}}</text>
            <text wx:else>暂无</text>
            <text wx:if="{{item.priceLoading}}">正在读取价格</text>
            <text wx:elif="{{item.priceError}}">点击下方重试</text>
            <text wx:else>{{item.startingPackageName || '未配置套餐'}}</text>
          </view>
          <view class="metric availability-metric">
            <text>最近可约</text>
            <text class="availability-value">{{item.earliestLabel}}</text>
            <text>{{item.earliestLoading ? '查询中' : '门店服务时段'}}</text>
          </view>
        </view>

        <view wx:if="{{item.visibleTags.length}}" class="store-tags">
          <text wx:for="{{item.visibleTags}}" wx:key="*this">{{item}}</text>
        </view>

        <view class="hours-row">
          <image src="/assets/icons/clock.png" mode="aspectFit" />
          <text>{{item.openHours || '营业时间请电话确认'}}</text>
          <text wx:if="{{item.businessHoursNotice}}">· {{item.businessHoursNotice}}</text>
        </view>

        <view class="card-actions">
          <button class="detail-action" data-id="{{item.id}}" catchtap="toggleDetails">
            <text>{{item.detailsExpanded ? '收起详情' : '查看详情'}}</text>
            <image class="{{item.detailsExpanded ? 'expanded' : ''}}" src="/assets/icons/caret-down.png" mode="aspectFit" />
          </button>
          <button wx:if="{{item.priceError}}" class="select-action retry-price-action" data-id="{{item.id}}" catchtap="retryStorePrice">重试价格</button>
          <button wx:elif="{{item.priceLoading}}" class="select-action" loading disabled>正在读取价格</button>
          <button wx:else class="select-action {{selectedStoreId === item.id ? 'current' : ''}}" disabled="{{!item.hasCurrentVehicleOffer}}" data-id="{{item.id}}" catchtap="selectStore">
            {{!item.hasCurrentVehicleOffer ? '当前车型暂无套餐' : selectedStoreId === item.id ? '使用当前门店' : '选择这家'}}
          </button>
        </view>

        <view wx:if="{{item.detailsExpanded}}" class="store-details">
          <view class="detail-section">
            <text class="detail-title">门店介绍</text>
            <text class="description">{{item.description || '该演示门店暂未填写详细介绍，具体服务以预约套餐内容为准。'}}</text>
          </view>

          <view wx:if="{{item.gallerySources.length}}" class="detail-section gallery-section">
            <view class="detail-title-row"><text class="detail-title">门店相册</text><text>{{item.gallerySources.length}} 张门店图片</text></view>
            <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="gallery-scroll">
              <view class="gallery-row">
                <image wx:for="{{item.gallerySources}}" wx:for-item="imageUrl" wx:for-index="imageIndex" wx:key="*this" src="{{imageUrl}}" mode="aspectFill" webp="{{true}}" data-id="{{item.id}}" data-url="{{imageUrl}}" bindtap="previewImage" binderror="galleryError" role="button" aria-label="查看{{item.name}}第{{imageIndex + 1}}张门店图片" />
              </view>
            </scroll-view>
          </view>
          <view wx:else class="fallback-detail">
            <image src="/assets/icons/camera.png" mode="aspectFit" />
            <text>门店暂未上传实景图片，封面为洗车服务环境示意。</text>
          </view>

          <view class="detail-list">
            <view>
              <image src="/assets/icons/map-pin.png" mode="aspectFit" />
              <view><text>门店地址</text><text>{{item.address}}</text></view>
            </view>
            <view>
              <image src="/assets/icons/phone.png" mode="aspectFit" />
              <view><text>联系电话</text><text>{{item.phone || '暂未提供公开电话'}}</text></view>
            </view>
            <view>
              <image src="/assets/icons/storefront.png" mode="aspectFit" />
              <view><text>服务设施</text><text>{{item.facilitiesText}}</text></view>
            </view>
          </view>

          <view class="detail-actions">
            <button disabled="{{!item.phone}}" data-id="{{item.id}}" bindtap="callStore"><image src="/assets/icons/phone.png" mode="aspectFit" /><text>联系门店</text></button>
            <button disabled="{{!item.hasLocation}}" data-id="{{item.id}}" bindtap="openStoreLocation"><image src="/assets/icons/map-pin.png" mode="aspectFit" /><text>查看位置</text></button>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !error && !stores.length}}" class="empty-state surface">
    <image src="/assets/icons/storefront.png" mode="aspectFit" />
    <text>暂时没有可预约的洗车门店</text>
    <text>请稍后下拉刷新，或联系客服了解服务范围。</text>
  </view>
</view>
