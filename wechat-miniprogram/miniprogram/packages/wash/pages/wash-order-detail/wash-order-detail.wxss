.detail-page { min-height: 100vh; padding: 30rpx 30rpx calc(54rpx + env(safe-area-inset-bottom)); color: #111a28; background: #f3f6fa; box-sizing: border-box; }
.status-hero { display: grid; min-height: 222rpx; padding: 34rpx; grid-template-columns: 92rpx 1fr; align-items: center; gap: 24rpx; border: 1rpx solid #dce9f6; border-radius: 32rpx; background: linear-gradient(140deg, #eaf5ff, #f8fbff); box-sizing: border-box; }
.status-icon { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(23, 104, 207, .10); }
.status-icon image { width: 50rpx; height: 50rpx; }
.status-hero > view:last-child { display: flex; min-width: 0; flex-direction: column; }
.status-hero > view:last-child text:first-child { overflow: hidden; color: #6481a0; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.status-hero > view:last-child text:nth-child(2) { margin: 7rpx 0 5rpx; color: #16324f; font-size: 42rpx; font-weight: 800; }
.status-hero > view:last-child text:last-child { color: #708095; font-size: 22rpx; line-height: 1.5; }
.status-hero.status-pending_payment { border-color: #f5dfc8; background: linear-gradient(140deg, #fff3e7, #fffaf6); }
.status-hero.status-redeemed { border-color: #d4ece3; background: linear-gradient(140deg, #eaf9f3, #f8fcfa); }
.status-hero.status-cancelled, .status-hero.status-refunded, .status-hero.status-expired { border-color: #e0e5eb; background: linear-gradient(140deg, #eef1f4, #fafbfc); }

.code-card { position: relative; display: flex; margin-top: 22rpx; overflow: hidden; padding: 34rpx 28rpx 30rpx; align-items: center; flex-direction: column; border-radius: 32rpx; color: #fff; background: linear-gradient(145deg, #1768cf, #0f57b3); box-shadow: 0 22rpx 44rpx rgba(23, 104, 207, .22); }
.code-badge { display: flex; position: relative; z-index: 1; width: 74rpx; height: 74rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: rgba(255, 255, 255, .14); }
.code-badge image { width: 42rpx; height: 42rpx; }
.code-card > text:nth-child(2) { position: relative; z-index: 1; margin-top: 9rpx; opacity: .8; font-size: 21rpx; font-weight: 700; }
.code-card > text:nth-child(3) { position: relative; z-index: 1; margin: 3rpx 0 10rpx; font-size: 62rpx; font-weight: 800; letter-spacing: 14rpx; font-variant-numeric: tabular-nums; }
.copy-action { position: relative; z-index: 1; display: flex; min-height: 58rpx; padding: 0 22rpx; align-items: center; border: 1rpx solid rgba(255, 255, 255, .28); border-radius: 18rpx; background: rgba(255, 255, 255, .13); }
.copy-action text { font-size: 21rpx; font-weight: 700; }
.code-card > text:last-child { position: relative; z-index: 1; margin-top: 12rpx; opacity: .74; font-size: 18rpx; text-align: center; }
.code-card::before, .code-card::after { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .08); content: ""; }
.code-card::before { top: -92rpx; right: -56rpx; width: 250rpx; height: 250rpx; }
.code-card::after { bottom: -116rpx; left: -54rpx; width: 220rpx; height: 220rpx; }

.redeemed-card, .invalid-card { display: grid; margin-top: 22rpx; padding: 24rpx; grid-template-columns: 44rpx 1fr; align-items: center; gap: 16rpx; border: 1rpx solid #cfe8dc; border-radius: 22rpx; background: #edf9f4; }
.invalid-card { border-color: #efd9d4; background: #fff4f1; }
.redeemed-card > image, .invalid-card > image { width: 44rpx; height: 44rpx; }
.redeemed-card > view, .invalid-card > view { display: flex; flex-direction: column; gap: 3rpx; }
.redeemed-card text:first-child, .invalid-card text:first-child { color: #23805c; font-size: 24rpx; font-weight: 800; }
.invalid-card text:first-child { color: #a65345; }
.redeemed-card text:last-child, .invalid-card text:last-child { color: #71849a; font-size: 20rpx; line-height: 1.45; }

.order-summary { margin-top: 22rpx; overflow: hidden; border: 1rpx solid #e2e9f1; }
.order-summary > view { display: grid; min-height: 126rpx; padding: 20rpx 24rpx; grid-template-columns: 54rpx 1fr; align-items: center; gap: 18rpx; box-sizing: border-box; }
.order-summary > view + view { border-top: 1rpx solid #edf1f5; }
.summary-icon { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: #edf6ff; }
.summary-icon image { width: 32rpx; height: 32rpx; }
.order-summary > view > view:last-child { display: flex; min-width: 0; flex-direction: column; }
.order-summary > view > view:last-child text:first-child { color: #8490a0; font-size: 20rpx; }
.order-summary > view > view:last-child text:nth-child(2) { overflow: hidden; margin-top: 2rpx; color: #1b2a3f; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.order-summary > view > view:last-child text:last-child { overflow: hidden; margin-top: 2rpx; color: #728092; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }

.valet-route { display: grid; margin-top: 22rpx; padding: 22rpx 24rpx; grid-template-columns: 38rpx minmax(0, 1fr); align-items: start; gap: 14rpx; border: 1rpx solid #d8e8f8; color: #5d7692; background: #eef6ff; }
.valet-route > image { width: 36rpx; height: 36rpx; }
.valet-route > view { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.valet-route > view text:first-child { color: #245e9a; font-size: 23rpx; font-weight: 800; }
.valet-route > view text:last-child { font-size: 20rpx; line-height: 1.45; }
.valet-route > view text:nth-child(2) { font-size: 20rpx; line-height: 1.45; }

.order-meta { margin-top: 22rpx; overflow: hidden; padding: 0 24rpx; border: 1rpx solid #e2e9f1; }
.order-meta > view { display: flex; min-height: 86rpx; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #edf1f5; }
.order-meta > view text:first-child { flex-shrink: 0; color: #7b8797; font-size: 22rpx; }
.order-meta > view text:last-child { overflow: hidden; color: #1b2a3f; font-size: 23rpx; font-weight: 700; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.order-meta > view.fee { min-height: 102rpx; border-bottom: 0; }
.order-meta > view.fee text:first-child { color: #1b2a3f; font-size: 27rpx; font-weight: 800; }
.order-meta > view.fee text:last-child { color: #1768cf; font-size: 36rpx; }

.store-actions { display: grid; margin-top: 22rpx; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.store-actions.single { grid-template-columns: 1fr; }
.store-actions button { display: flex; min-height: 88rpx; align-items: center; justify-content: center; gap: 11rpx; border: 1rpx solid #dce5ef; border-radius: 20rpx; color: #1768cf; background: #fff; font-size: 24rpx; font-weight: 700; }
.store-actions image { width: 34rpx; height: 34rpx; }
.main-action { display: flex; width: 100%; min-height: 92rpx; margin-top: 26rpx; gap: 12rpx; border-radius: 22rpx; }
.main-action image { width: 36rpx; height: 36rpx; padding: 4rpx; border-radius: 10rpx; background: rgba(255, 255, 255, .90); box-sizing: border-box; }
.manage-actions { display: grid; margin-top: 18rpx; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.manage-actions button { display: flex; min-height: 88rpx; align-items: center; justify-content: center; gap: 9rpx; border: 1rpx solid #dce4ed; border-radius: 20rpx; color: #1768cf; background: #fff; font-size: 23rpx; font-weight: 700; }
.manage-actions button image { width: 32rpx; height: 32rpx; }
.manage-actions button.danger { color: #d94f61; }
.manage-actions button[disabled] { opacity: .5; }
.order-note { display: flex; margin-top: 26rpx; align-items: center; justify-content: center; gap: 8rpx; color: #7d8997; font-size: 19rpx; text-align: center; }
.order-note image { width: 27rpx; height: 27rpx; flex-shrink: 0; opacity: .72; }
.inline-error { display: flex; margin-top: 20rpx; padding: 20rpx; align-items: center; justify-content: center; gap: 10rpx; border-radius: 14rpx; color: #8b5a22; background: #fff5e7; font-size: 22rpx; text-align: center; }
.inline-error image { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.detail-error { display: flex; margin-top: 140rpx; padding: 42rpx 30rpx; align-items: center; flex-direction: column; gap: 14rpx; color: #788495; text-align: center; }
.detail-error > image { width: 54rpx; height: 54rpx; }
.detail-error text:nth-child(2) { color: #16253a; font-size: 31rpx; font-weight: 800; }
.detail-error .secondary-button { width: 100%; margin-top: 16rpx; }
.missing-order { width: 100%; box-sizing: border-box; }
.fallback-actions { display: grid; width: 100%; min-width: 0; margin-top: 16rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; box-sizing: border-box; }
.fallback-action { display: flex; width: 100%; min-width: 0; min-height: 78rpx; padding: 10rpx 8rpx; align-items: center; justify-content: center; color: #1768cf; border: 1rpx solid #cfe0f3; border-radius: 18rpx; background: #fff; font-size: 22rpx; font-weight: 750; text-align: center; box-sizing: border-box; }
.fallback-action.primary { color: #fff; border-color: #1768cf; background: #1768cf; }
