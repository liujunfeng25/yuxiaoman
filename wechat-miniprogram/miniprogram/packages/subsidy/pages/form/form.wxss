.section-heading > view text:last-child { color: #8995a5; font-size: 19rpx; line-height: 1.4; }
.required-tag { padding: 4rpx 10rpx; flex: none; border-radius: 999rpx; color: #1768cf; background: #eaf4ff; font-size: 17rpx; font-weight: 750; }
.vehicle-card { display: grid; width: 100%; min-height: 114rpx; padding: 18rpx 18rpx; grid-template-columns: auto 1fr auto; align-items: center; gap: 16rpx; border: 2rpx solid #dfe7ef; border-radius: 21rpx; background: #fbfdff; text-align: left; box-sizing: border-box; }
