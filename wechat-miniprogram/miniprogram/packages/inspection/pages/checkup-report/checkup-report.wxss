@import "../checkup-editor/checkup-editor.wxss";

.readonly-page { padding-bottom: calc(52rpx + env(safe-area-inset-bottom)); }
.draft-preview-banner { display: grid; margin-bottom: 14rpx; padding: 16rpx 17rpx; grid-template-columns: 34rpx minmax(0,1fr); align-items: start; gap: 10rpx; color: #617b94; border: 1rpx solid #b9d6ef; border-radius: 15rpx; background: #eaf4ff; }
.draft-preview-banner image { width: 32rpx; height: 32rpx; }
.draft-preview-banner view { display: flex; min-width: 0; flex-direction: column; }
.draft-preview-banner text:first-child { color: #215b91; font-size: 20rpx; font-weight: 850; }
.draft-preview-banner text:last-child { margin-top: 3rpx; font-size: 17rpx; line-height: 1.5; }
.report-inline-error { display: grid; margin-bottom: 14rpx; padding: 14rpx 15rpx; grid-template-columns: 28rpx minmax(0,1fr) auto; align-items: center; gap: 9rpx; color: #a04c46; border: 1rpx solid #efc8c5; border-radius: 14rpx; background: #fff2f1; font-size: 19rpx; line-height: 1.5; }
.report-inline-error > image { width: 27rpx; height: 27rpx; }
.report-inline-error > button { min-width: 136rpx; min-height: 88rpx; padding: 0 13rpx; color: #a04c46; border: 1rpx solid #e5b8b4; border-radius: 12rpx; background: #fff; font-size: 19rpx; font-weight: 800; }
.report-result { display: grid; padding: 26rpx; grid-template-columns: 66rpx minmax(0,1fr); align-items: start; gap: 15rpx; color: #fff; border-radius: 24rpx; background: #1768cf; box-shadow: 0 15rpx 34rpx rgba(23,104,207,.19); }
.report-result.conclusion-passed { background: #16805d; box-shadow: 0 15rpx 34rpx rgba(22,128,93,.18); }
.report-result.conclusion-failed { background: #b74943; box-shadow: 0 15rpx 34rpx rgba(183,73,67,.18); }
.report-result.conclusion-pending { background: #64788b; box-shadow: 0 15rpx 34rpx rgba(71,87,102,.16); }
.result-symbol { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: rgba(255,255,255,.17); }
.result-symbol image { width: 39rpx; height: 39rpx; }
.result-copy { display: flex; min-width: 0; flex-direction: column; }
.result-copy text:first-child { color: rgba(255,255,255,.72); font-size: 19rpx; }
.result-copy text:nth-child(2) { margin-top: 2rpx; font-size: 39rpx; font-weight: 900; }
.result-copy text:last-child { margin-top: 5rpx; overflow: hidden; color: rgba(255,255,255,.77); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.result-meta { display: flex; grid-column: 1 / -1; padding-top: 16rpx; align-items: center; justify-content: space-between; border-top: 1rpx solid rgba(255,255,255,.2); color: rgba(255,255,255,.7); font-size: 18rpx; }
.result-meta text:last-child { color: #fff; font-weight: 700; }
.boundary-note { display: flex; margin-top: 14rpx; padding: 15rpx 17rpx; align-items: flex-start; gap: 9rpx; color: #6e8298; border: 1rpx solid #d9e5f1; border-radius: 15rpx; background: #eef5fc; font-size: 18rpx; line-height: 1.55; }
.boundary-note image { width: 27rpx; height: 27rpx; flex: 0 0 auto; }
.material-boundary { margin-top: 0; }
.material-boundary + .attachment-list { margin-top: 12rpx; }
.summary-grid { display: grid; margin-top: 14rpx; padding: 19rpx 8rpx; grid-template-columns: repeat(4, minmax(0,1fr)); border: 1rpx solid #e1e8ef; border-radius: 18rpx; background: #fff; }
.summary-grid view { display: flex; min-width: 0; padding: 0 7rpx; align-items: center; flex-direction: column; }
.summary-grid view + view { border-left: 1rpx solid #e6ebf1; }
.summary-grid text:first-child { max-width: 100%; overflow: hidden; color: #1768cf; font-size: 24rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.summary-grid text:last-child { margin-top: 3rpx; color: #8795a5; font-size: 17rpx; }
.summary-grid .mark-summary text:first-child { overflow: visible; font-size: 19rpx; line-height: 1.35; text-align: center; text-overflow: clip; white-space: normal; word-break: break-all; }
.repair-quote-entry { display: grid; width: 100%; min-height: 154rpx; margin: 20rpx 0 28rpx; padding: 22rpx; grid-template-columns: 76rpx minmax(0,1fr) 28rpx; align-items: center; gap: 16rpx; color: #173a5f; border: 1rpx solid #aed3f4; border-radius: 22rpx; text-align: left; background: linear-gradient(135deg, #eaf6ff 0%, #f8fcff 100%); box-shadow: 0 12rpx 28rpx rgba(23,104,207,.08); box-sizing: border-box; }
.repair-entry-icon { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: #d8ecff; }
.repair-entry-icon image { width: 42rpx; height: 42rpx; }
.repair-entry-copy { display: flex; min-width: 0; flex-direction: column; }
.repair-entry-copy > view { display: flex; align-items: center; gap: 9rpx; }
.repair-entry-copy > view text:first-child { color: #55718d; font-size: 17rpx; font-weight: 800; letter-spacing: 1rpx; }
.repair-entry-copy > view text:last-child { padding: 3rpx 9rpx; color: #1768cf; border-radius: 999rpx; background: #d7ebff; font-size: 14rpx; font-weight: 750; }
.repair-entry-copy > text:nth-child(2) { margin-top: 5rpx; color: #155fae; font-size: 26rpx; font-weight: 850; }
.repair-entry-copy > text:last-child { margin-top: 5rpx; color: #6d8297; font-size: 17rpx; line-height: 1.5; }
.repair-entry-caret { width: 27rpx; height: 27rpx; opacity: .72; }
.repair-quote-entry.repair-paid { border-color: #acd9ca; background: linear-gradient(135deg, #eaf9f4, #fbfffd); }
.repair-quote-entry.repair-paid .repair-entry-icon { background: #d7f0e7; }
.repair-quote-entry.repair-cancelled { border-color: #d9e1e8; background: #f7f9fb; box-shadow: none; }
.readonly-diagnostic .view-tabs button { position: relative; display: flex; align-items: center; justify-content: center; gap: 7rpx; }
.readonly-diagnostic .view-tabs button text:last-child { display: flex; min-width: 29rpx; height: 29rpx; padding: 0 5rpx; align-items: center; justify-content: center; color: #fff; border-radius: 999rpx; background: #cf4740; font-size: 15rpx; box-sizing: border-box; }
.readonly-diagnostic .diagnostic-legend view:last-child { margin-left: auto; }
.readonly-faults .fault-row { grid-template-columns: 43rpx minmax(0,1fr) 27rpx; }
.readonly-faults .fault-row > image { width: 25rpx; height: 25rpx; opacity: .55; }
.no-fault-card { display: grid; margin-top: 16rpx; padding: 22rpx; grid-template-columns: 50rpx minmax(0,1fr); align-items: center; gap: 13rpx; border: 1rpx solid #cde5d9; border-radius: 19rpx; background: #f0faf5; }
.no-fault-card image { width: 47rpx; height: 47rpx; }
.no-fault-card view { display: flex; flex-direction: column; }
.no-fault-card text:first-child { color: #247055; font-size: 24rpx; font-weight: 850; }
.no-fault-card text:last-child { margin-top: 3rpx; color: #6f8d81; font-size: 18rpx; }
.report-photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12rpx; }
.report-photo { position: relative; height: 206rpx; overflow: hidden; border: 1rpx solid #dce5ed; border-radius: 17rpx; background: #e8eef4; }
.report-photo:last-child:nth-child(odd) { grid-column: 1 / -1; }
.report-photo > image { width: 100%; height: 100%; }
.report-photo > view { position: absolute; right: 0; bottom: 0; left: 0; display: flex; min-height: 54rpx; padding: 0 13rpx; align-items: center; justify-content: space-between; color: #fff; background: rgba(4,23,40,.72); box-sizing: border-box; }
.report-photo > view text:first-child { font-size: 20rpx; font-weight: 800; }
.report-photo > view text:last-child { color: #b6ddfb; font-size: 16rpx; }
.report-photo[disabled], .report-fault-photo-grid button[disabled] { opacity: 1; }
.report-photo > .report-photo-failed,
.report-fault-photo-grid .report-photo-failed { position: static; display: flex; width: 100%; height: 100%; padding: 18rpx; align-items: center; justify-content: center; flex-direction: column; gap: 7rpx; color: #9c5750; background: #fff2f0; box-sizing: border-box; }
.report-photo > .report-photo-failed image,
.report-fault-photo-grid .report-photo-failed image { width: 34rpx; height: 34rpx; opacity: .78; }
.report-photo > .report-photo-failed text,
.report-fault-photo-grid .report-photo-failed text { position: static; padding: 0; color: #9c5750; background: transparent; font-size: 16rpx; }
.report-detail-card { padding: 4rpx 21rpx; border: 1rpx solid #e0e7ef; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 25rpx rgba(27,58,94,.05); }
.report-detail-card > view { display: flex; min-height: 78rpx; padding: 14rpx 0; align-items: flex-start; justify-content: space-between; gap: 30rpx; border-bottom: 1rpx solid #edf1f5; box-sizing: border-box; }
.report-detail-card > view:last-child { border: 0; }
.report-detail-card text:first-child { flex: 0 0 auto; color: #8493a5; font-size: 20rpx; }
.report-detail-card text:last-child { color: #2a4058; font-size: 21rpx; font-weight: 700; text-align: right; line-height: 1.5; }
.legacy-empty { display: flex; min-height: 180rpx; padding: 25rpx; align-items: center; justify-content: center; flex-direction: column; gap: 9rpx; color: #8494a5; border: 1rpx dashed #cfdae5; border-radius: 18rpx; background: #fff; font-size: 20rpx; text-align: center; box-sizing: border-box; }
.legacy-empty.full { min-height: 62vh; border: 0; background: transparent; }
.legacy-empty image { width: 49rpx; height: 49rpx; opacity: .62; }
.legacy-empty text:first-of-type { color: #526a82; font-size: 24rpx; font-weight: 800; }
.legacy-empty text:last-child { max-width: 560rpx; font-size: 19rpx; line-height: 1.55; }

.document-card, .annual-conclusion-card, .condition-report-card { overflow: hidden; border: 1rpx solid #dfe7ef; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 25rpx rgba(27,58,94,.05); }
.report-information { padding: 6rpx 21rpx; }
.information-title { display: block; padding: 18rpx 0 9rpx; color: #24415e; font-size: 22rpx; font-weight: 850; }
.information-title.vehicle-title { margin-top: 5rpx; border-top: 1rpx solid #e5ebf1; }
.information-row { display: flex; min-height: 67rpx; padding: 11rpx 0; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #edf1f5; box-sizing: border-box; }
.information-row:last-child { border-bottom: 0; }
.information-row > text:first-child { flex: 0 0 auto; color: #8493a4; font-size: 19rpx; }
.information-row > text:last-child { color: #2b4259; font-size: 20rpx; font-weight: 700; text-align: right; line-height: 1.45; word-break: break-all; }

.annual-conclusion-card { padding: 22rpx; border-left: 7rpx solid #1768cf; }
.annual-conclusion-card.conclusion-passed { border-left-color: #218565; }
.annual-conclusion-card.conclusion-pending { border-left-color: #8294a5; }
.annual-conclusion-card.conclusion-failed { border-left-color: #bf4b45; }
.annual-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.annual-heading > view { display: flex; align-items: baseline; gap: 12rpx; }
.annual-heading > view text:first-child { color: #6d8196; font-size: 19rpx; }
.annual-heading > view text:last-child { color: #1768cf; font-size: 31rpx; font-weight: 900; }
.conclusion-passed .annual-heading > view text:last-child { color: #218565; }
.conclusion-pending .annual-heading > view text:last-child { color: #607589; }
.conclusion-failed .annual-heading > view text:last-child { color: #b74943; }
.annual-heading > text { flex: 0 0 auto; padding: 6rpx 10rpx; color: #62768a; border-radius: 999rpx; background: #eef3f7; font-size: 16rpx; font-weight: 700; }
.annual-heading > text { max-width: 210rpx; line-height: 1.4; text-align: right; white-space: normal; word-break: break-all; }
.annual-narrative { display: block; margin-top: 15rpx; color: #405970; font-size: 20rpx; line-height: 1.7; }
.annual-failure-details { display: grid; margin-top: 15rpx; padding: 15rpx; gap: 10rpx; border: 1rpx solid #efd2cf; border-radius: 14rpx; background: #fff8f7; }
.annual-failure-details > view { display: grid; grid-template-columns: 166rpx minmax(0,1fr); align-items: start; gap: 11rpx; }
.annual-failure-details > view text:first-child { color: #8b605c; font-size: 17rpx; font-weight: 800; }
.annual-failure-details > view text:last-child { color: #364e64; font-size: 18rpx; line-height: 1.55; }
.conclusion-boundary { display: grid; margin-top: 17rpx; padding: 14rpx 15rpx; grid-template-columns: 72rpx minmax(0,1fr); gap: 10rpx; border-radius: 13rpx; background: #f2f6fa; }
.conclusion-boundary text:first-child { color: #42617e; font-size: 17rpx; font-weight: 800; }
.conclusion-boundary text:last-child { color: #788a9c; font-size: 17rpx; line-height: 1.55; }

.condition-report-card { padding: 21rpx; }
.condition-heading { display: grid; grid-template-columns: 47rpx minmax(0,1fr); align-items: center; gap: 11rpx; }
.condition-heading image { width: 44rpx; height: 44rpx; }
.condition-heading > view { display: flex; min-width: 0; flex-direction: column; }
.condition-heading > view text:first-child { color: #8594a5; font-size: 17rpx; }
.condition-heading > view text:last-child { margin-top: 2rpx; color: #263f57; font-size: 25rpx; font-weight: 850; }
.condition-narrative { display: block; margin-top: 15rpx; color: #435c73; font-size: 20rpx; line-height: 1.7; }
.inspection-note, .record-scope { display: grid; margin-top: 15rpx; padding: 14rpx 15rpx; grid-template-columns: 78rpx minmax(0,1fr); gap: 10rpx; border-radius: 13rpx; background: #eef5fc; }
.record-scope { margin-top: 8rpx; background: #f4f6f8; }
.inspection-note text:first-child, .record-scope text:first-child { color: #32618b; font-size: 17rpx; font-weight: 800; }
.record-scope text:first-child { color: #61768a; }
.inspection-note text:last-child, .record-scope text:last-child { color: #657d94; font-size: 17rpx; line-height: 1.55; }

.generated-advice-note { display: flex; margin-bottom: 11rpx; padding: 13rpx 15rpx; align-items: flex-start; gap: 8rpx; color: #71869b; border: 1rpx solid #d8e5f1; border-radius: 13rpx; background: #eef5fc; font-size: 17rpx; line-height: 1.55; }
.generated-advice-note image { width: 26rpx; height: 26rpx; flex: 0 0 auto; }
.written-fault-list { display: flex; flex-direction: column; gap: 13rpx; }
.written-fault-item { padding: 20rpx; border: 1rpx solid #e2e8ef; border-radius: 19rpx; background: #fff; box-shadow: 0 8rpx 23rpx rgba(29,58,89,.05); }
.written-fault-head { display: grid; grid-template-columns: 43rpx minmax(0,1fr) auto; align-items: center; gap: 11rpx; }
.written-fault-head > text:first-child { display: flex; width: 41rpx; height: 41rpx; align-items: center; justify-content: center; color: #fff; border-radius: 50%; background: #dc4a42; font-size: 17rpx; font-weight: 900; }
.written-fault-head > view { display: flex; min-width: 0; flex-direction: column; }
.written-fault-head > view text:first-child { color: #263f57; font-size: 23rpx; font-weight: 850; }
.written-fault-head > view text:last-child { margin-top: 2rpx; color: #8a98a8; font-size: 16rpx; }
.severity { padding: 6rpx 10rpx; border-radius: 999rpx; background: #f1f4f7; font-size: 16rpx; font-weight: 800; }
.severity-minor { color: #46745f; background: #edf8f2; }
.severity-moderate { color: #a76a27; background: #fff5e8; }
.severity-severe { color: #b74943; background: #fff0ef; }
.fault-facts { display: grid; margin-top: 16rpx; padding: 13rpx 4rpx; grid-template-columns: repeat(3,minmax(0,1fr)); border-top: 1rpx solid #e8edf2; border-bottom: 1rpx solid #e8edf2; }
.fault-facts view { display: flex; min-width: 0; align-items: center; flex-direction: column; }
.fault-facts view + view { border-left: 1rpx solid #e8edf2; }
.fault-facts text:first-child { color: #929eaa; font-size: 15rpx; }
.fault-facts text:last-child { max-width: 100%; margin-top: 3rpx; overflow: hidden; color: #3f566c; font-size: 18rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.fault-written-block { display: grid; margin-top: 14rpx; grid-template-columns: 78rpx minmax(0,1fr); gap: 10rpx; }
.fault-written-block text:first-child { color: #75889c; font-size: 17rpx; font-weight: 750; }
.fault-written-block text:last-child { color: #40586f; font-size: 18rpx; line-height: 1.55; }
.fault-advice { display: grid; margin-top: 14rpx; padding: 14rpx; grid-template-columns: 31rpx minmax(0,1fr); align-items: start; gap: 9rpx; border-radius: 13rpx; background: #eef5fc; }
.fault-advice image { width: 29rpx; height: 29rpx; }
.fault-advice view { display: flex; flex-direction: column; }
.fault-advice text:first-child { color: #32618b; font-size: 17rpx; font-weight: 800; }
.fault-advice text:last-child { margin-top: 3rpx; color: #637b92; font-size: 17rpx; line-height: 1.55; }
.report-fault-photos { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #e8edf2; }
.report-fault-photo-head { display: flex; align-items: center; justify-content: space-between; }
.report-fault-photo-head text:first-child { color: #536d85; font-size: 18rpx; font-weight: 800; }
.report-fault-photo-head text:last-child { color: #1768cf; font-size: 17rpx; font-weight: 750; }
.report-fault-photo-grid { display: grid; margin-top: 10rpx; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; }
.report-fault-photo-grid button { position: relative; height: 124rpx; overflow: hidden; border: 1rpx solid #dbe5ee; border-radius: 11rpx; background: #e6edf3; }
.report-fault-photo-grid image { width: 100%; height: 100%; }
.report-fault-photo-grid text { position: absolute; right: 0; bottom: 0; left: 0; padding: 6rpx 5rpx; color: #fff; background: rgba(4,24,42,.68); font-size: 14rpx; font-weight: 700; text-align: center; }
.report-fault-photo-missing { display: flex; min-height: 79rpx; margin-top: 9rpx; padding: 10rpx; align-items: center; justify-content: center; flex-direction: column; color: #8a98a7; border: 1rpx dashed #cfdae5; border-radius: 11rpx; background: #f8fafc; font-size: 15rpx; text-align: center; box-sizing: border-box; }
.report-fault-photo-missing text:first-child { color: #63778b; font-size: 17rpx; font-weight: 750; }
.report-fault-photo-missing text:last-child { margin-top: 2rpx; }
.written-fault-item > button { width: 100%; min-height: 88rpx; margin-top: 13rpx; color: #1768cf; border: 1rpx solid #bfd7ee; border-radius: 12rpx; background: #fff; font-size: 18rpx; font-weight: 750; }
.zero-fault-report { display: grid; padding: 22rpx; grid-template-columns: 49rpx minmax(0,1fr); align-items: start; gap: 12rpx; border: 1rpx solid #cfe5da; border-radius: 19rpx; background: #f2faf6; }
.zero-fault-report image { width: 46rpx; height: 46rpx; }
.zero-fault-report view { display: flex; flex-direction: column; }
.zero-fault-report text:first-child { color: #247055; font-size: 23rpx; font-weight: 850; }
.zero-fault-report text:last-child { margin-top: 5rpx; color: #657f74; font-size: 18rpx; line-height: 1.6; }

.attachment-list { overflow: hidden; border: 1rpx solid #dfe7ef; border-radius: 19rpx; background: #fff; }
.attachment-row { display: grid; width: 100%; min-height: 88rpx; padding: 12rpx 16rpx; grid-template-columns: 37rpx minmax(0,1fr) auto 25rpx; align-items: center; gap: 10rpx; border-bottom: 1rpx solid #edf1f5; background: #fff; text-align: left; box-sizing: border-box; }
.attachment-row:last-child { border-bottom: 0; }
.attachment-row[disabled] { opacity: 1; background: #fafbfc; }
.attachment-row > text:first-child { color: #93a1ae; font-size: 16rpx; font-weight: 800; }
.attachment-row > view { display: flex; min-width: 0; flex-direction: column; }
.attachment-row > view text:first-child { color: #30485f; font-size: 20rpx; font-weight: 800; }
.attachment-row > view text:last-child { margin-top: 2rpx; overflow: hidden; color: #8b99a8; font-size: 15rpx; text-overflow: ellipsis; white-space: nowrap; }
.attachment-row > text:nth-last-child(2), .attachment-row > text:last-of-type { color: #23735a; font-size: 16rpx; font-weight: 750; }
.attachment-row.attachment-missing > text:nth-last-child(2), .attachment-row.attachment-missing > text:last-of-type { color: #b24b45; }
.attachment-row.attachment-not-applicable > text:nth-last-child(2), .attachment-row.attachment-not-applicable > text:last-of-type { color: #8794a2; }
.attachment-row > image { width: 23rpx; height: 23rpx; opacity: .55; }
.result-material-list .attachment-row > text:nth-last-child(2), .result-material-list .attachment-row > text:last-of-type { max-width: 150rpx; line-height: 1.35; text-align: right; white-space: normal; }
.photo-group-title { display: block; margin: 0 0 10rpx; color: #4e6881; font-size: 19rpx; font-weight: 800; }
.result-material-title { margin-top: 19rpx; padding-top: 17rpx; border-top: 1rpx solid #e2e8ef; }
.legacy-empty.compact { min-height: 120rpx; }
.report-load-error { border-color: #efcbc8; background: #fffafa; }
.report-error-actions { display: grid; width: 100%; max-width: 560rpx; margin-top: 14rpx; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10rpx; }
.report-error-actions button { min-height: 88rpx; color: #1768cf; border: 1rpx solid #bad4ed; border-radius: 14rpx; background: #fff; font-size: 20rpx; font-weight: 800; }
.report-error-actions button:only-child { grid-column: 1 / -1; }
.location-index { margin-top: 13rpx; }
.report-footnote { display: flex; margin-top: 18rpx; padding: 18rpx; flex-direction: column; gap: 5rpx; color: #7d8c9c; border: 1rpx solid #dce5ed; border-radius: 16rpx; background: #f6f8fa; font-size: 17rpx; line-height: 1.55; }
.report-footnote text:first-child { color: #526b82; font-size: 19rpx; font-weight: 800; }

.report-image-viewer { position: fixed; z-index: 80; inset: 0; display: flex; padding: calc(22rpx + env(safe-area-inset-top)) 24rpx calc(22rpx + env(safe-area-inset-bottom)); align-items: center; justify-content: center; box-sizing: border-box; }
.report-image-viewer-mask { position: absolute; inset: 0; background: rgba(7,24,41,.5); }
.report-image-viewer-dialog { position: relative; z-index: 1; display: flex; width: 100%; height: 82vh; max-width: 680rpx; max-height: 960rpx; min-height: 0; overflow: hidden; flex-direction: column; border: 1rpx solid rgba(205,222,237,.92); border-radius: 25rpx; background: #f7fafc; box-shadow: 0 28rpx 70rpx rgba(3,20,37,.34); }
.report-image-viewer-head { display: grid; min-height: 94rpx; padding: 14rpx 15rpx 14rpx 21rpx; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #dde7ef; background: #fff; box-sizing: border-box; }
.report-image-viewer-head > view { display: flex; min-width: 0; flex-direction: column; }
.report-image-viewer-head > view text:first-child { color: #1f3d59; font-size: 23rpx; font-weight: 850; }
.report-image-viewer-head > view text:last-child { margin-top: 3rpx; overflow: hidden; color: #75889b; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.report-image-viewer-head > button { display: flex; width: 104rpx; min-width: 104rpx; max-width: 104rpx; min-height: 88rpx; margin: 0; padding: 0; align-items: center; justify-content: center; color: #1768cf; border: 1rpx solid #bfd6ed; border-radius: 12rpx; background: #f4f9ff; font-size: 19rpx; font-weight: 800; line-height: 1; }
.report-image-viewer-stage { display: flex; height: 0; min-height: 0; padding: 16rpx; align-items: center; justify-content: center; flex: 1 1 auto; background: #eaf1f6; box-sizing: border-box; }
.report-image-viewer-stage image { width: 100%; height: 100%; border-radius: 13rpx; background: #dfe8ef; }
.report-image-viewer-controls { display: grid; width: 100%; min-width: 0; min-height: 94rpx; padding: 13rpx 15rpx; flex: 0 0 auto; grid-template-columns: minmax(0,1fr) minmax(80rpx,120rpx) minmax(0,1fr); align-items: center; gap: 8rpx; border-top: 1rpx solid #dce6ee; background: #fff; box-sizing: border-box; }
.report-image-viewer-controls > button { display: flex; width: 100%; min-width: 0; min-height: 88rpx; margin: 0; padding: 0 8rpx; overflow: hidden; align-items: center; justify-content: center; gap: 5rpx; color: #1768cf; border: 1rpx solid #bfd7ed; border-radius: 12rpx; background: #f5f9fe; font-size: 18rpx; font-weight: 800; box-sizing: border-box; }
.report-image-viewer-controls > button text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.report-image-viewer-controls > button:first-child text:first-child, .report-image-viewer-controls > button:last-child text:last-child { flex: 0 0 auto; font-size: 25rpx; line-height: 1; }
.report-image-viewer-controls > button[disabled] { color: #9ca9b5; border-color: #dfe5ea; background: #f1f3f5; }
.report-image-viewer-controls > view { display: flex; width: 100%; min-width: 0; align-items: center; flex-direction: column; }
.report-image-viewer-controls > view text:first-child { color: #294761; font-size: 20rpx; font-weight: 850; }
.report-image-viewer-controls > view text:last-child { margin-top: 2rpx; color: #8a98a6; font-size: 14rpx; }

@media (max-width: 340px) {
  .report-inline-error { grid-template-columns: 28rpx minmax(0,1fr); }
  .report-inline-error > button { width: 100%; grid-column: 1 / -1; }
  .report-error-actions { grid-template-columns: 1fr; }
  .report-error-actions button,
  .report-error-actions button:only-child { grid-column: auto; }
}
