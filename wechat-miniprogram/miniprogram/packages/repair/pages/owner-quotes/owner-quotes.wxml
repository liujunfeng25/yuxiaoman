<view class="quotes-page">
  <view wx:if="{{loading}}" class="loading-state"><image src="/assets/icons/clock.png" mode="aspectFit"/><text>正在读取修理店报价…</text></view>

  <view wx:elif="{{error && !request}}" class="error-state">
    <image src="/assets/icons/warning-circle.png" mode="aspectFit"/>
    <text>维修报价暂时无法打开</text><text>{{error}}</text>
    <button bindtap="retry">重新加载</button><button class="plain" bindtap="goHome">返回首页</button>
  </view>

  <block wx:elif="{{request}}">
    <view class="request-summary" bindtap="viewRequest" role="button" aria-label="查看维修需求" hover-class="request-summary-hover">
      <image class="summary-watermark" src="/assets/icons/shield-check.png" mode="aspectFit"/>
      <view class="summary-icon"><image src="/assets/icons/car.png" mode="aspectFit"/><image class="summary-mini-check" src="/assets/icons/calendar-check.png" mode="aspectFit"/></view>
      <view class="summary-copy"><text>{{plateText}} · {{faultCount}} 处车损</text><text>{{request.status === 'paid' ? '已选定修理店并完成模拟支付' : request.status === 'cancelled' ? '维修询价已取消' : '已收到 ' + activeQuoteCount + ' 份有效报价'}}</text></view>
      <view class="summary-action"><text>查看维修需求</text><image src="/assets/icons/caret-right.png" mode="aspectFit"/></view>
    </view>

    <radio-group wx:if="{{quoteViews.length}}" class="quote-list" bindchange="selectQuote">
      <label wx:for="{{quoteViews}}" wx:key="id" class="quote-card {{item.selected ? 'selected' : ''}} {{!item.selectable && request.status === 'open' ? 'unavailable' : ''}} {{item.isLowest ? 'has-lowest' : ''}}">
        <text wx:if="{{item.isLowest}}" class="lowest-badge">最低价</text>
        <view class="quote-main">
          <view class="shop-copy"><text>{{item.shopName}}</text><text wx:if="{{item.status !== 'active'}}" class="status-pill status-{{item.status}}">{{item.statusText}}</text></view>
          <view class="price-copy"><text><text>¥</text>{{item.priceText}}</text><text>全款总价</text></view>
          <view wx:if="{{request.status === 'paid'}}" class="quote-final-state {{item.selected ? 'selected' : ''}}"><image wx:if="{{item.selected}}" src="/assets/icons/check-circle.png" mode="aspectFit"/><text>{{item.selected ? '已选' : '未选'}}</text></view>
          <radio wx:else value="{{item.id}}" checked="{{item.selected}}" disabled="{{!item.selectable}}" color="#1768CF" aria-label="选择{{item.shopName}}报价"/>
        </view>
        <view class="shop-meta">
          <view><image src="/assets/icons/map-pin.png" mode="aspectFit"/><text>{{item.distanceText}}</text></view>
          <view><image src="/assets/icons/shield-check.png" mode="aspectFit"/><text>{{item.ratingText}}</text></view>
        </view>
        <text class="quote-note">{{item.note || '门店未填写补充维修说明'}}</text>
        <view class="quote-time"><text>报价时间</text><text>{{item.quotedAtText}}</text><text wx:if="{{item.revision > 1}}" class="revision">第 {{item.revision}} 版</text></view>
      </label>
    </radio-group>

    <view wx:else class="empty-quotes">
      <image src="/assets/icons/clock.png" mode="aspectFit"/><text>修理店正在查看需求</text><text>暂未收到有效报价，下拉页面或点击按钮即可刷新。</text><button bindtap="retry">刷新报价</button>
    </view>

    <view class="payment-boundary"><image src="/assets/icons/shield-check.png" mode="aspectFit"/><text>模拟支付，不会真实扣款；支付后由双方线下协商，平台不参与维修履约。</text></view>
    <view wx:if="{{error}}" class="inline-error"><image src="/assets/icons/warning-circle.png" mode="aspectFit"/><text>{{error}}</text></view>

    <view wx:if="{{request.status === 'open' && activeQuoteCount}}" class="payment-bar">
      <view class="selected-total" wx:if="{{selectedQuoteId}}"><text>已选择报价</text><text><text>¥</text>{{selectedPriceText}}</text><text>全款总价</text></view>
      <view class="selected-total" wx:else><text>尚未选择报价</text><text>请选择</text><text>系统不会自动选最低价</text></view>
      <button class="defer" bindtap="deferSelection">暂不选择</button>
      <button class="pay" loading="{{paying}}" disabled="{{paying || !selectedQuoteId}}" bindtap="paySelectedQuote">{{paying ? '正在支付' : selectedQuoteId ? '确认模拟支付 ¥' + selectedPriceText : '请先选择门店报价'}}</button>
    </view>
    <view wx:elif="{{request.status === 'paid'}}" class="completed-bar"><view><text>报价已成交</text><text>查看冻结金额与门店联系方式</text></view><button bindtap="viewReceipt">查看成交回执</button></view>
  </block>
</view>
