<view class="page detail-page">
  <view wx:if="{{loading}}" class="state-card">正在安全读取预审资料…</view>
  <view wx:elif="{{loadError && !booking}}" class="state-card"><text>{{loadError}}</text><button bindtap="load">重新加载</button></view>
  <block wx:elif="{{booking}}">
    <view class="summary-card"><view><text>{{booking.vehicle ? booking.vehicle.plateNumber : '车牌待核验'}}</text><text>{{serviceModeLabel}}</text></view><text>待预审</text><view class="summary-grid"><view><text>预约时间</text><text>{{appointmentLabel}}</text></view><view><text>支付提交</text><text>{{submittedLabel}}</text></view><view><text>联系人</text><text>{{booking.contactName}} {{booking.contactPhone}}</text></view><view><text>模拟实付</text><text>{{paymentLabel}}</text></view></view></view>
    <view class="review-note"><image src="/assets/icons/shield-check.png"/><text>请核对 7 张照片与预约车辆信息。本环节只做资料预审，不代表机动车年检结论。</text></view>
    <view class="section-head"><view><text>预约照片</text><text>7 张必需资料 · 点击查看原图</text></view><text>{{booking.media.length}} / 7</text></view>
    <view class="photo-grid"><button wx:for="{{photos}}" wx:key="kind" class="photo-card {{item.selected ? 'selected' : ''}} {{!item.url ? 'missing' : ''}}" data-url="{{item.url}}" bindtap="preview"><image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill"/><view wx:else><image src="/assets/icons/warning-circle.png"/><text>资料缺失</text></view><text>{{item.label}}</text></button></view>
    <view class="bottom-space"></view>
    <view wx:if="{{booking.precheck.status === 'pending'}}" class="action-bar"><button class="reject" bindtap="openReject" disabled="{{deciding}}">预审不通过</button><button class="approve" bindtap="approve" loading="{{deciding}}" disabled="{{deciding}}">预审通过并接单</button></view>
    <view wx:else class="review-note">该订单预审已处理，不能重复修改</view>
  </block>
  <view wx:if="{{showReject}}" class="sheet-layer">
    <view class="sheet-mask" bindtap="closeReject" catchtouchmove="noop"></view>
    <view class="reject-sheet" catchtap="noop">
      <view class="sheet-head"><view><text>填写不通过原因</text><text>原因会同步给车主并进入订单审计</text></view><button bindtap="closeReject">关闭</button></view>
      <scroll-view scroll-y class="sheet-scroll">
        <text class="field-label">问题类型（至少一项）</text>
        <view class="reason-grid"><button wx:for="{{reasons}}" wx:key="code" class="{{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="toggleReason">{{item.label}}</button></view>
        <text class="field-label">存在问题的照片（可多选）</text>
        <view class="photo-tags"><button wx:for="{{photos}}" wx:key="kind" class="{{item.selected ? 'selected' : ''}}" data-kind="{{item.kind}}" bindtap="togglePhoto">{{item.label}}</button></view>
        <text class="field-label">具体说明（5–300 字）</text>
        <textarea maxlength="300" value="{{reasonText}}" bindinput="reasonInput" placeholder="请说明照片或车辆信息为何无法通过预审，便于车主重新准备资料。"/>
        <text class="count">{{reasonText.length}} / 300</text>
        <view class="refund-warning"><text>确认后将执行</text><text>释放预约号源 · 终止本次业务 · 全额模拟退款 {{paymentLabel}}</text></view>
      </scroll-view>
      <button class="confirm-reject" bindtap="submitReject" loading="{{deciding}}" disabled="{{deciding}}">确认不通过并发起退款</button>
    </view>
  </view>
</view>
