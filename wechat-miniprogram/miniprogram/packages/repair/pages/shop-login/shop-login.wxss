.repair-login-page { min-height: 100vh; padding: 72rpx 34rpx calc(42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #17304d; background: linear-gradient(180deg, #eaf5ff 0, #f5f9fd 430rpx, #f5f8fc 100%); }
.login-brand { display: flex; align-items: center; flex-direction: column; text-align: center; }
.login-brand-icon { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border-radius: 28rpx; background: linear-gradient(145deg, #0b70e8, #1756bb); box-shadow: 0 18rpx 34rpx rgba(19, 91, 177, .2); }
.login-brand-icon image { width: 48rpx; height: 48rpx; filter: brightness(0) invert(1); }
.login-brand > text:nth-of-type(1) { margin-top: 25rpx; color: #4382bd; font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.login-brand > text:nth-of-type(2) { margin-top: 8rpx; color: #122b48; font-size: 38rpx; font-weight: 850; }
.login-brand > text:nth-of-type(3) { max-width: 570rpx; margin-top: 12rpx; color: #6d8095; font-size: 21rpx; line-height: 1.55; }
.login-card { margin-top: 42rpx; padding: 32rpx; border: 1rpx solid #d8e6f2; border-radius: 28rpx; background: rgba(255,255,255,.96); box-shadow: 0 18rpx 48rpx rgba(47, 91, 135, .09); }
.login-loading { display: flex; min-height: 180rpx; align-items: center; justify-content: center; color: #698096; font-size: 22rpx; }
.card-title { display: block; margin-bottom: 26rpx; color: #17304d; font-size: 29rpx; font-weight: 850; }
.field-label { display: block; margin: 18rpx 0 10rpx; color: #506780; font-size: 20rpx; font-weight: 750; }
input { height: 84rpx; padding: 0 23rpx; border: 1rpx solid #ceddea; border-radius: 17rpx; color: #17304d; background: #f8fbfe; font-size: 24rpx; box-sizing: border-box; }
.primary, .secondary { width: 100%; min-height: 84rpx; margin-top: 28rpx; border-radius: 18rpx; font-size: 23rpx; font-weight: 800; }
.primary { color: #fff; background: #0868df; box-shadow: 0 12rpx 24rpx rgba(8, 104, 223, .18); }
.secondary { margin-top: 14rpx; color: #1768cf; border: 1rpx solid #b8d3ec; background: #f2f8fe; }
.login-error { display: flex; margin-top: 18rpx; padding: 14rpx 16rpx; align-items: flex-start; gap: 9rpx; border-radius: 13rpx; color: #b5443c; background: #fff3f1; font-size: 19rpx; line-height: 1.45; }
.login-error image { width: 25rpx; height: 25rpx; flex: 0 0 auto; }
.signed-account { display: flex; padding: 22rpx; align-items: center; gap: 17rpx; border-radius: 18rpx; background: #f1f7fd; }
.signed-account > image { width: 48rpx; height: 48rpx; }
.signed-account > view { display: flex; min-width: 0; flex-direction: column; gap: 5rpx; }
.signed-account > view > text { color: #18344f; font-size: 24rpx; font-weight: 800; }
.signed-account > view > view { display: flex; min-width: 0; align-items: center; gap: 9rpx; }
.signed-account .subject-name { overflow: hidden; color: #72869b; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.signed-account .demo-badge { padding: 3rpx 8rpx; color: #956414; border-radius: 999rpx; background: #fff2d8; font-size: 15rpx; white-space: nowrap; }
.back-owner { min-height: 72rpx; margin: 28rpx auto 0; color: #5f748a; background: transparent; font-size: 21rpx; }
.security-note { display: flex; max-width: 590rpx; margin: 24rpx auto 0; align-items: flex-start; justify-content: center; gap: 8rpx; color: #8090a2; font-size: 18rpx; line-height: 1.45; }
.security-note image { width: 23rpx; height: 23rpx; flex: 0 0 auto; }
