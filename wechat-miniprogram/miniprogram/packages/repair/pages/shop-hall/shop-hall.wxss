.shop-hall-page { padding-top: 20rpx; padding-bottom: calc(58rpx + env(safe-area-inset-bottom)); background: #f6f9fc; }
.shop-header { display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; gap: 16rpx; }
.shop-identity { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.role-kicker { color: #1677ff; font-size: 20rpx; font-weight: 800; letter-spacing: .8rpx; }
.shop-name { max-width: 480rpx; margin-top: 4rpx; overflow: hidden; color: #101c30; font-size: 35rpx; font-weight: 850; letter-spacing: -.5rpx; text-overflow: ellipsis; white-space: nowrap; }
.account-line { display: flex; margin-top: 5rpx; align-items: center; gap: 9rpx; color: #74869a; font-size: 18rpx; }
.account-line .account-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.account-line .demo-badge { padding: 3rpx 8rpx; color: #956414; border-radius: 999rpx; background: #fff1d6; font-size: 15rpx; white-space: nowrap; }
.logout-entry { display: flex; min-height: 68rpx; padding: 0 17rpx; align-items: center; gap: 7rpx; color: #304158; border: 1rpx solid #dce5ef; border-radius: 999rpx; background: #fff; font-size: 20rpx; white-space: nowrap; }
.logout-entry image { width: 28rpx; height: 28rpx; }

.demo-notice { display: grid; margin: 10rpx 0 18rpx; padding: 16rpx 18rpx; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 11rpx; color: #59718d; border: 1rpx solid #d6e7fa; border-radius: 18rpx; background: #edf6ff; }
.demo-notice > image { width: 32rpx; height: 32rpx; }
.demo-notice > view { display: flex; min-width: 0; flex-direction: column; }
.demo-notice text:first-child { color: #25547f; font-size: 20rpx; font-weight: 750; }
.demo-notice text:last-child { margin-top: 2rpx; font-size: 17rpx; }
.workflow-summary-wrap { margin: 0 0 18rpx; }

.overview-card { display: grid; padding: 24rpx 10rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1rpx solid #dfe7f0; border-radius: 27rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(31, 57, 88, .055); }
.metric { display: grid; min-width: 0; min-height: 88rpx; padding: 0 17rpx; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 11rpx; }
.metric + .metric { border-left: 1rpx solid #e7ecf2; }
.metric > image { width: 39rpx; height: 39rpx; }
.metric > view { display: flex; min-width: 0; flex-direction: column; }
.metric text:first-child { color: #536175; font-size: 19rpx; white-space: nowrap; }
.metric text:last-child { margin-top: 2rpx; color: #1677ff; font-size: 41rpx; font-weight: 850; line-height: 1.1; }

.hall-heading { display: flex; margin: 34rpx 2rpx 17rpx; align-items: center; justify-content: space-between; gap: 16rpx; }
.hall-heading > view { display: flex; min-width: 0; align-items: baseline; gap: 13rpx; }
.hall-heading > view text:first-child { color: #101c30; font-size: 35rpx; font-weight: 850; white-space: nowrap; }
.hall-heading > view text:last-child { color: #7b899b; font-size: 18rpx; white-space: nowrap; }
.hall-heading button { display: flex; min-height: 60rpx; padding: 0 8rpx; align-items: center; gap: 6rpx; color: #647489; font-size: 20rpx; }
.hall-heading button image { width: 28rpx; height: 28rpx; }
.filter-scroll { width: calc(100% + 28rpx); margin-right: -28rpx; white-space: nowrap; }
.filter-row { display: inline-flex; padding-right: 28rpx; gap: 10rpx; }
.filter-row button { min-width: 122rpx; min-height: 68rpx; padding: 0 22rpx; color: #667489; border: 1rpx solid #dce5ef; border-radius: 16rpx; background: #fff; font-size: 21rpx; white-space: nowrap; }
.filter-row button.active { color: #fff; border-color: #1677ff; background: #1677ff; box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, .16); font-weight: 750; }
.hall-loading { min-height: 300rpx; }

.request-list { display: flex; margin-top: 18rpx; flex-direction: column; gap: 14rpx; }
.request-card { overflow: hidden; padding: 23rpx 22rpx 0; border: 1rpx solid #dfe7f0; border-radius: 25rpx; background: #fff; box-shadow: 0 9rpx 25rpx rgba(31, 57, 88, .05); }
.request-card.status-pending_quote { border-left: 6rpx solid #1677ff; padding-left: 17rpx; }
.request-card.status-won { border-color: #bde3d2; }
.request-topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.plate-line { display: flex; min-width: 0; align-items: center; gap: 11rpx; }
.plate-line text:first-child { overflow: hidden; color: #111e33; font-size: 31rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.plate-line text:last-child { padding: 6rpx 10rpx; color: #116bdd; border-radius: 10rpx; background: #eaf3ff; font-size: 17rpx; white-space: nowrap; }
.status-won .plate-line text:last-child { color: #14805b; background: #e8f8f1; }
.status-not_selected .plate-line text:last-child,
.status-closed .plate-line text:last-child { color: #778494; background: #f0f3f6; }
.quoted-price { display: flex; flex: none; align-items: baseline; color: #eb6508; }
.quoted-price text:first-child { font-size: 20rpx; font-weight: 800; }
.quoted-price text:last-child { font-size: 34rpx; font-weight: 850; }
.vehicle-label { display: block; margin-top: 4rpx; color: #68778b; font-size: 20rpx; }
.damage-summary { display: grid; min-height: 66rpx; margin-top: 14rpx; padding: 0 14rpx; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 9rpx; border-radius: 15rpx; background: #f4f8fd; }
.damage-summary image { width: 30rpx; height: 30rpx; }
.damage-summary text:first-of-type { overflow: hidden; color: #33475f; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.damage-summary text:last-child { color: #7b8999; font-size: 18rpx; white-space: nowrap; }
.request-footer { display: flex; min-height: 77rpx; margin-top: 10rpx; align-items: center; justify-content: space-between; gap: 12rpx; border-top: 1rpx solid #e9eef3; }
.request-footer > view { display: flex; min-width: 0; align-items: center; gap: 7rpx; color: #7b8999; font-size: 18rpx; }
.request-footer > view image { width: 25rpx; height: 25rpx; }
.request-footer > view text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.request-footer button { display: flex; min-height: 60rpx; padding-left: 14rpx; align-items: center; gap: 4rpx; color: #1677ff; font-size: 20rpx; font-weight: 750; }
.request-footer button image { width: 23rpx; height: 23rpx; }
.privacy-note { display: grid; margin-top: 3rpx; padding: 19rpx 20rpx; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 10rpx; color: #667b92; border-radius: 19rpx; background: #edf5ff; font-size: 18rpx; line-height: 1.5; }
.privacy-note image { width: 29rpx; height: 29rpx; }

.error-card,
.empty-card { display: flex; min-height: 300rpx; margin-top: 18rpx; padding: 30rpx; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid #e1e8f0; border-radius: 25rpx; background: #fff; text-align: center; }
.error-card image,
.empty-card image { width: 62rpx; height: 62rpx; }
.error-card text:nth-of-type(1),
.empty-card text:nth-of-type(1) { margin-top: 16rpx; color: #26374c; font-size: 27rpx; font-weight: 800; }
.error-card text:nth-of-type(2),
.empty-card text:nth-of-type(2) { margin-top: 5rpx; color: #7b899b; font-size: 20rpx; }
.error-card button { min-width: 190rpx; min-height: 70rpx; margin-top: 18rpx; color: #1677ff; border: 1rpx solid #cddff4; border-radius: 16rpx; background: #f6faff; font-size: 21rpx; }

@media (max-width: 340px) {
  .shop-hall-page { padding-right: 22rpx; padding-left: 22rpx; }
  .shop-name { max-width: 330rpx; font-size: 31rpx; }
  .metric { padding: 0 10rpx; gap: 7rpx; }
  .metric > image { width: 34rpx; height: 34rpx; }
  .damage-summary { grid-template-columns: auto minmax(0, 1fr); }
  .damage-summary text:last-child { display: none; }
}
.finance-entry{display:flex;width:100%;align-items:center;gap:18rpx;margin:18rpx 0;padding:22rpx;border:1rpx solid #d9e8f2;border-radius:22rpx;color:#17466b;background:#fff;text-align:left}.finance-entry>image:first-child{width:42rpx;height:42rpx;padding:10rpx;border-radius:14rpx;background:#eaf5fd}.finance-entry>view{display:grid;flex:1;gap:6rpx}.finance-entry>view text:first-child{font-size:26rpx;font-weight:700}.finance-entry>view text:last-child{color:#758b9c;font-size:20rpx}.finance-entry>image:last-child{width:26rpx;height:26rpx}
