.operator-page { padding-top: 18rpx; padding-bottom: calc(58rpx + env(safe-area-inset-bottom)); background: #f7f9fc; }
.operator-header { display: flex; min-height: 84rpx; align-items: center; justify-content: space-between; gap: 18rpx; }
.station-switch { min-width: 0; flex: 1; }
.station-switch-value { display: flex; min-height: 88rpx; align-items: center; gap: 7rpx; }
.station-switch-value text { max-width: 430rpx; overflow: hidden; color: #101c30; font-size: 35rpx; font-weight: 800; letter-spacing: -.6rpx; text-overflow: ellipsis; white-space: nowrap; }
.station-switch-value image { width: 29rpx; height: 29rpx; flex: none; }
.role-pill { display: flex; min-height: 88rpx; padding: 0 16rpx; align-items: center; gap: 7rpx; color: #26384e; border: 1rpx solid #dfe6ee; border-radius: 999rpx; background: #fff; font-size: 20rpx; white-space: nowrap; }
.role-pill image:first-child { width: 29rpx; height: 29rpx; }
.role-pill image:last-child { width: 22rpx; height: 22rpx; }

.scope-bar { display: flex; min-height: 72rpx; margin: 11rpx 0 20rpx; padding: 0 18rpx; align-items: center; justify-content: space-between; border: 1rpx solid #e2e8ef; border-radius: 18rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(31, 57, 88, .035); }
.workflow-summary-wrap { margin: 0 0 20rpx; }
.scope-date,
.synthetic-label { display: flex; min-height: 88rpx; align-items: center; gap: 8rpx; color: #536174; font-size: 21rpx; }
.scope-date image:first-child,
.synthetic-label image { width: 28rpx; height: 28rpx; }
.scope-date image:last-child { width: 23rpx; height: 23rpx; }
.synthetic-label { color: #7d8998; font-size: 19rpx; }

.operator-loading { min-height: 300rpx; }
.operator-load-error { display: flex; min-height: 430rpx; padding: 48rpx 30rpx; align-items: center; justify-content: center; flex-direction: column; color: #788a9c; text-align: center; box-sizing: border-box; }
.operator-load-error image { width: 66rpx; height: 66rpx; }
.operator-load-error > text:nth-child(2) { margin-top: 17rpx; color: #283b51; font-size: 29rpx; font-weight: 800; }
.operator-load-error > text:nth-child(3) { margin-top: 9rpx; font-size: 22rpx; line-height: 1.55; }
.operator-load-error button { min-width: 232rpx; min-height: 88rpx; margin-top: 24rpx; color: #fff; border-radius: 16rpx; background: #1768cf; font-size: 24rpx; font-weight: 800; }
.operator-inline-error { display: grid; min-height: 88rpx; margin-bottom: 18rpx; padding: 11rpx 13rpx; grid-template-columns: 28rpx minmax(0, 1fr) auto; align-items: center; gap: 9rpx; color: #9f4c46; border: 1rpx solid #efcbc8; border-radius: 15rpx; background: #fff2f1; font-size: 20rpx; line-height: 1.5; box-sizing: border-box; }
.operator-inline-error image { width: 28rpx; height: 28rpx; }
.operator-inline-error button { min-width: 132rpx; min-height: 88rpx; padding: 0 13rpx; color: #a24741; border: 1rpx solid #e7b9b5; border-radius: 12rpx; background: #fff; font-size: 20rpx; font-weight: 750; }
.overview-card { overflow: hidden; border: 1rpx solid #dfe7f0; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(31, 57, 88, .055); }
.overview-metrics { display: grid; padding: 26rpx 12rpx 24rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.metric { display: grid; min-width: 0; min-height: 94rpx; padding: 0 18rpx; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 13rpx; }
.metric + .metric { border-left: 1rpx solid #e7ecf2; }
.metric > image { width: 43rpx; height: 43rpx; }
.metric > view { display: flex; min-width: 0; flex-direction: column; }
.metric > view > text:first-child { color: #344055; font-size: 19rpx; white-space: nowrap; }
.metric > view > text:last-child { margin-top: 3rpx; color: #0868df; font-size: 42rpx; font-weight: 800; line-height: 1.15; }
.metric > view > text:last-child text { color: #58667a; font-size: 20rpx; font-weight: 500; }
.pressure-row { display: grid; width: calc(100% - 38rpx); min-height: 88rpx; margin: 0 19rpx; padding: 0 8rpx; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 10rpx; border-top: 1rpx solid #e6ebf1; color: #2e394b; text-align: left; font-size: 21rpx; }
.pressure-row image:first-child { width: 33rpx; height: 33rpx; }
.pressure-row image:last-child { width: 25rpx; height: 25rpx; }
.pressure-row > text:first-of-type { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pressure-row > text:first-of-type text { color: #f0781e; font-weight: 700; }
.pressure-row > text:last-of-type { color: #0868df; font-weight: 700; white-space: nowrap; }
.precheck-entry { display: grid; width: 100%; min-height: 122rpx; margin-top: 18rpx; padding: 18rpx 20rpx; grid-template-columns: 58rpx minmax(0, 1fr) auto 24rpx; align-items: center; gap: 13rpx; text-align: left; border: 1rpx solid #cfe2f7; border-radius: 22rpx; background: linear-gradient(135deg, #eff7ff, #fff); box-shadow: 0 8rpx 22rpx rgba(24, 104, 201, .07); box-sizing: border-box; }
.precheck-entry-icon { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: #dceeff; }.precheck-entry-icon image { width: 32rpx; height: 32rpx; }
.precheck-entry-copy { display: flex; min-width: 0; flex-direction: column; }.precheck-entry-copy text:first-child { color: #17314f; font-size: 25rpx; font-weight: 800; }.precheck-entry-copy text:last-child { margin-top: 5rpx; overflow: hidden; color: #6f8094; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.precheck-entry-count { display: flex; min-width: 70rpx; flex-direction: column; align-items: center; }.precheck-entry-count text:first-child { color: #1768cf; font-size: 32rpx; font-weight: 850; line-height: 1; }.precheck-entry-count text:last-child { margin-top: 5rpx; color: #7a8796; font-size: 17rpx; }.precheck-entry-caret { width: 24rpx; height: 24rpx; }

.task-heading { display: flex; margin: 36rpx 2rpx 18rpx; align-items: center; justify-content: space-between; gap: 18rpx; }
.task-heading > view { display: flex; min-width: 0; align-items: baseline; gap: 14rpx; }
.task-heading > view text:first-child { color: #101c30; font-size: 36rpx; font-weight: 800; white-space: nowrap; }
.task-heading > view text:last-child { color: #7c8796; font-size: 18rpx; white-space: nowrap; }
.task-heading button { display: flex; min-height: 88rpx; padding: 0 12rpx; align-items: center; gap: 6rpx; color: #667386; font-size: 20rpx; }
.task-heading button image { width: 29rpx; height: 29rpx; }

.filter-scroll { width: calc(100% + 28rpx); margin-right: -28rpx; white-space: nowrap; box-sizing: border-box; }
.filter-row { display: inline-flex; min-width: 100%; padding: 0 28rpx 2rpx 0; gap: 10rpx; box-sizing: border-box; }
.filter-row button { display: flex; min-width: 132rpx; min-height: 88rpx; padding: 10rpx 20rpx; align-items: center; justify-content: center; color: #657184; border: 1rpx solid #dfe5ed; border-radius: 16rpx; background: #fff; font-size: 21rpx; line-height: 1.25; white-space: nowrap; box-sizing: border-box; }
.role-pill[disabled],
.task-heading button[disabled],
.filter-row button[disabled] { opacity: .62; }
.filter-row button.active { color: #fff; border-color: #0868df; background: #0868df; box-shadow: 0 7rpx 16rpx rgba(8, 104, 223, .16); font-weight: 700; }

.task-list { margin-top: 18rpx; overflow: hidden; border: 1rpx solid #e1e7ee; border-radius: 27rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(31, 57, 88, .05); }
.task-row { position: relative; display: grid; width: 100%; min-height: 204rpx; padding: 22rpx 20rpx; grid-template-columns: 104rpx minmax(0, 1fr) 26rpx; grid-template-rows: auto auto auto; align-items: start; gap: 9rpx 14rpx; text-align: left; background: #fff; box-sizing: border-box; }
.task-row + .task-row { border-top: 1rpx solid #e8edf2; }
.task-row.next { border-left: 6rpx solid #1475e6; padding-left: 14rpx; }
.task-time { display: flex; min-height: 132rpx; padding-right: 13rpx; grid-row: 1 / 4; justify-content: flex-start; border-right: 1rpx solid #e3e8ef; flex-direction: column; }
.task-time text:first-child { color: #1768cf; font-size: 22rpx; font-weight: 800; line-height: 1.25; white-space: nowrap; }
.task-time text:nth-child(2) { margin-top: 2rpx; color: #1768cf; font-size: 18rpx; font-weight: 700; white-space: nowrap; }
.task-time text:last-child { margin-top: 12rpx; color: #657184; font-size: 19rpx; }
.task-main { display: flex; min-width: 0; grid-column: 2; grid-row: 1; flex-direction: column; }
.task-main text:first-child { overflow: hidden; color: #17253a; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.task-main text:nth-child(2),
.task-main text:nth-child(3) { margin-top: 5rpx; overflow: hidden; color: #687587; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-status { display: flex; min-width: 0; grid-column: 2 / 4; grid-row: 2; align-items: center; flex-wrap: wrap; gap: 7rpx 10rpx; }
.task-status text:first-child { padding: 6rpx 10rpx; color: #0965d9; border-radius: 10rpx; background: #eaf3ff; font-size: 18rpx; white-space: nowrap; }
.task-status text:last-child { min-width: 0; color: #667184; font-size: 18rpx; line-height: 1.35; white-space: normal; }
.task-status.status-on_hold text:first-child,
.task-status.status-no_show text:first-child { color: #c25b0a; background: #fff2e5; }
.task-status.status-completed text:first-child { color: #14835c; background: #e8f8f1; }
.task-caret { width: 27rpx; height: 27rpx; grid-column: 3; grid-row: 1; align-self: center; }
.task-address { display: flex; min-width: 0; margin-top: 1rpx; grid-column: 2 / 4; grid-row: 3; align-items: center; gap: 7rpx; color: #7a8797; font-size: 18rpx; }
.task-address image { width: 24rpx; height: 24rpx; flex: none; }
.task-address text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.list-note { display: flex; min-height: 74rpx; padding: 0 22rpx; align-items: center; gap: 9rpx; color: #8b95a3; background: #fafbfd; font-size: 18rpx; }
.list-note image { width: 27rpx; height: 27rpx; }
.operator-empty { display: flex; min-height: 330rpx; margin-top: 18rpx; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid #e2e8ef; border-radius: 27rpx; background: #fff; }
.operator-empty image { width: 68rpx; height: 68rpx; }
.operator-empty text:nth-of-type(1) { margin-top: 18rpx; color: #27374b; font-size: 27rpx; font-weight: 750; }
.operator-empty text:nth-of-type(2) { margin-top: 7rpx; color: #7b899b; font-size: 20rpx; }

@media (max-width: 340px) {
  .operator-page { padding-right: 22rpx; padding-left: 22rpx; }
  .station-switch-value text { max-width: 360rpx; font-size: 31rpx; }
  .role-pill { padding: 0 12rpx; }
  .role-pill text { display: none; }
  .overview-metrics { padding-right: 5rpx; padding-left: 5rpx; }
  .metric { padding: 0 10rpx; gap: 8rpx; }
  .metric > image { width: 36rpx; height: 36rpx; }
  .task-row { padding-right: 15rpx; grid-template-columns: 92rpx minmax(0, 1fr) 24rpx; gap: 8rpx 10rpx; }
  .task-time { padding-right: 10rpx; }
  .task-time text:first-child { font-size: 20rpx; }
  .operator-inline-error { grid-template-columns: 28rpx minmax(0, 1fr); }
  .operator-inline-error button { width: 100%; grid-column: 1 / -1; }
}
