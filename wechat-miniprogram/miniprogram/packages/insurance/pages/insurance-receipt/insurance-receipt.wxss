.receipt-page { min-height: 100vh; padding: 32rpx 30rpx calc(56rpx + env(safe-area-inset-bottom)); color: #18263a; background: #f6f9fc; box-sizing: border-box; }
.empty-receipt { display: flex; min-height: 72vh; padding: 48rpx 28rpx; align-items: center; justify-content: center; flex-direction: column; text-align: center; box-sizing: border-box; }
.empty-receipt > view { display: flex; width: 112rpx; height: 112rpx; margin-bottom: 26rpx; align-items: center; justify-content: center; border-radius: 36rpx; background: #eaf4ff; }
.empty-receipt image { width: 58rpx; height: 58rpx; }
.empty-receipt > text:nth-child(2) { color: #17263b; font-size: 34rpx; font-weight: 800; }
.empty-receipt > text:nth-child(3) { margin-top: 10rpx; color: #7a8798; font-size: 24rpx; }
.empty-receipt .primary-button { width: 100%; margin-top: 40rpx; }
.receipt-hero { display: flex; padding: 40rpx 32rpx; align-items: center; border-radius: 36rpx; color: #fff; flex-direction: column; text-align: center; background: linear-gradient(145deg, #1669c9, #3b8ee0); box-shadow: 0 20rpx 44rpx rgba(23, 104, 207, .18); }
.hero-status { display: flex; width: 98rpx; height: 98rpx; margin-bottom: 15rpx; align-items: center; justify-content: center; border-radius: 31rpx; color: #168760; background: rgba(255, 255, 255, .96); }
.hero-status image { width: 60rpx; height: 60rpx; }
.hero-label { opacity: .84; font-size: 20rpx; font-weight: 800; }
.hero-title { margin: 8rpx 0; font-size: 38rpx; font-weight: 800; }
.hero-copy { max-width: 570rpx; opacity: .88; font-size: 21rpx; line-height: 1.55; }
.receipt-hero.withdrawn { background: #7e8b99; box-shadow: 0 18rpx 38rpx rgba(54, 65, 78, .13); }
.receipt-hero.withdrawn .hero-status { color: #6f7c89; }
.receipt-hero.withdrawn .hero-status image { filter: grayscale(1); opacity: .68; }
.duplicate-note { display: flex; margin-top: 22rpx; padding: 20rpx 22rpx; align-items: flex-start; gap: 12rpx; border: 2rpx solid #cce1f7; border-radius: 20rpx; color: #356d9f; background: #eff7ff; font-size: 21rpx; line-height: 1.45; }
.duplicate-note image { width: 31rpx; height: 31rpx; flex: none; }
.receipt-card { margin-top: 24rpx; overflow: hidden; border: 2rpx solid #e0e7ef; border-radius: 30rpx; background: #fff; box-shadow: 0 14rpx 36rpx rgba(35, 63, 98, .05); }
.receipt-code { display: flex; min-height: 132rpx; padding: 20rpx 24rpx; align-items: center; justify-content: space-between; gap: 18rpx; background: #f4f9ff; box-sizing: border-box; }
.receipt-code > view { display: flex; min-width: 0; flex-direction: column; gap: 5rpx; }
.receipt-code > view text:first-child { color: #6581a0; font-size: 19rpx; font-weight: 800; }
.receipt-code > view text:last-child { overflow: hidden; color: #155fab; font-size: 34rpx; font-weight: 800; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.receipt-code button { min-height: 62rpx; padding: 0 17rpx; flex: none; border: 2rpx solid #cfe1f5; border-radius: 16rpx; color: #1768cf; background: #fff; font-size: 20rpx; font-weight: 750; }
.receipt-row { display: flex; min-height: 88rpx; padding: 0 24rpx; align-items: center; justify-content: space-between; gap: 24rpx; }
.receipt-row + .receipt-row { border-top: 2rpx solid #edf1f5; }
.receipt-row > text:first-child { flex: none; color: #7b8999; font-size: 21rpx; }
.receipt-row > text:last-child { color: #26384d; font-size: 23rpx; font-weight: 700; text-align: right; }
.boundary-notice { display: flex; margin-top: 24rpx; padding: 24rpx; align-items: flex-start; gap: 16rpx; border: 2rpx solid #d8e6f5; border-radius: 24rpx; color: #2778c7; background: #f2f8ff; }
.boundary-notice image { width: 37rpx; height: 37rpx; flex: none; }
.boundary-notice > view { display: flex; color: #26384e; flex-direction: column; gap: 6rpx; }
.boundary-notice > view text:first-child { font-size: 23rpx; font-weight: 800; }
.boundary-notice > view text:last-child { color: #708196; font-size: 20rpx; line-height: 1.5; }
.receipt-error { display: flex; margin-top: 22rpx; padding: 19rpx 20rpx; align-items: flex-start; gap: 12rpx; border: 2rpx solid #f0c3c9; border-radius: 18rpx; color: #aa354a; background: #fff5f6; font-size: 21rpx; line-height: 1.5; }
.receipt-error > image { width: 28rpx; height: 28rpx; flex: none; }
.receipt-actions { margin-top: 26rpx; }
.withdraw-button, .home-button { display: flex; width: 100%; min-height: 84rpx; align-items: center; justify-content: center; border-radius: 22rpx; font-size: 23rpx; font-weight: 800; }
.withdraw-button { border: 2rpx solid #e2b8bf; color: #b84254; background: #fff; }
.withdraw-button[disabled] { color: #a7afb8; border-color: #e1e5e9; background: #f3f5f7; }
.home-button { color: #1768cf; border: 2rpx solid #bcdcff; background: #eef6ff; }
.home-link { display: block; margin: 22rpx auto 0; color: #7d8999; font-size: 22rpx; }
