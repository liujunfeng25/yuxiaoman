.heading { display: flex; flex-direction: column; margin: 14rpx 4rpx 26rpx; }.heading text:first-child { color: #183d69; font-size: 40rpx; font-weight: 800; }.heading text:last-child { margin-top: 8rpx; color: #8198af; font-size: 24rpx; }.material { display: flex; align-items: center; gap: 21rpx; padding: 27rpx; margin-bottom: 15rpx; }.tick { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border: 2rpx solid #bdd0e4; border-radius: 50%; color: #fff; }.tick.done { border-color: #1975d9; background: #1975d9; }.tick image { width: 28rpx; height: 28rpx; }.material view:last-child { display: flex; flex-direction: column; gap: 5rpx; }.material text:first-child { color: #25486e; font-size: 29rpx; font-weight: 700; }.material text:last-child { color: #8298ae; font-size: 23rpx; }.notice { display: flex; flex-direction: column; gap: 10rpx; padding: 28rpx; margin: 28rpx 0; background: #f0f7ff; }.notice text:first-child { color: #1e5898; font-weight: 700; }.notice text:last-child { color: #6986a2; font-size: 24rpx; line-height: 1.8; }
