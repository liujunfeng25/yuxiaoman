.detail-page { min-height: 100vh; color: #17263b; background: #f4f7fb; }
.gallery { position: relative; height: 430rpx; background: #e9eef4; }
.gallery swiper,.gallery swiper-item,.gallery swiper image { width: 100%; height: 100%; }
.image-index,.demo-photo { position: absolute; bottom: 18rpx; padding: 7rpx 12rpx; color: #fff; border-radius: 999rpx; background: rgba(17,31,49,.62); font-size: 18rpx; }
.image-index { right: 22rpx; }.demo-photo { left: 22rpx; }
.title-card,.trip-card,.section-card { margin: 18rpx 22rpx 0; padding: 22rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 7rpx 20rpx rgba(25,54,88,.05); }
.brand { display: flex; align-items: center; gap: 8rpx; color: #657286; font-size: 20rpx; }
.brand image { width: 48rpx; height: 38rpx; }
.model-title { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 900; }
.model-tags { display: flex; margin-top: 11rpx; flex-wrap: wrap; gap: 8rpx; }
.model-tags text { padding: 5rpx 10rpx; color: #587087; border-radius: 7rpx; background: #f0f4f8; font-size: 18rpx; }
.price { display: flex; margin-top: 20rpx; padding-top: 17rpx; align-items: flex-end; justify-content: space-between; border-top: 1rpx solid #edf0f4; }
.price > view:first-child { color: #ee6725; }.price > view:first-child text:first-child { font-size: 39rpx; font-weight: 900; }.price > view:first-child text:last-child { font-size: 18rpx; }
.price > view:last-child { display: flex; align-items: flex-end; flex-direction: column; }.price > view:last-child text:first-child { color: #8b96a5; font-size: 18rpx; }.price > view:last-child text:last-child { font-size: 26rpx; font-weight: 800; }
.price-hint { display: block; margin-top: 7rpx; color: #929dab; font-size: 17rpx; text-align: right; }
.trip-title { display: flex; padding-bottom: 14rpx; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; }.trip-title text:first-child { font-size: 27rpx; font-weight: 900; }.trip-title text:last-child { color: #1768d4; font-size: 19rpx; }
.trip-line { display: grid; margin-top: 16rpx; grid-template-columns: 37rpx 1fr; gap: 10rpx; }.trip-line > text { width: 35rpx; height: 35rpx; color: #fff; border-radius: 8rpx; background: #1768d4; font-size: 19rpx; line-height: 35rpx; text-align: center; font-weight: 800; }.trip-line > view { display: flex; min-width: 0; flex-direction: column; }.trip-line > view text:first-child { font-size: 22rpx; font-weight: 700; }.trip-line > view text:last-child { margin-top: 3rpx; color: #8b96a5; font-size: 18rpx; }
.guarantee { display: grid; margin: 18rpx 22rpx 0; padding: 20rpx 22rpx; grid-template-columns: 46rpx 1fr; gap: 12rpx; color: #175a43; border: 1rpx solid #c9ecdd; border-radius: 18rpx; background: #effaf5; }.guarantee image { width: 43rpx; height: 43rpx; }.guarantee view { display: flex; flex-direction: column; }.guarantee view text:first-child { font-size: 23rpx; font-weight: 900; }.guarantee view text:last-child { margin-top: 4rpx; color: #5c7b70; font-size: 18rpx; }
.section-title { display: block; font-size: 27rpx; font-weight: 900; }
.spec-grid { display: grid; margin-top: 15rpx; grid-template-columns: repeat(2,1fr); gap: 10rpx; }.spec-grid view { display: flex; padding: 15rpx; justify-content: space-between; border-radius: 10rpx; background: #f5f7fa; }.spec-grid text:first-child { color: #8490a0; font-size: 18rpx; }.spec-grid text:last-child { font-size: 20rpx; font-weight: 800; }
.policies > view { display: grid; margin-top: 17rpx; grid-template-columns: 44rpx 1fr; gap: 12rpx; }.policies > view image { width: 39rpx; height: 39rpx; }.policies > view view { display: flex; flex-direction: column; }.policies > view view text:first-child { font-size: 22rpx; font-weight: 800; }.policies > view view text:last-child { margin-top: 3rpx; color: #788597; font-size: 19rpx; }
.deposit-note { margin: 18rpx 22rpx 0; padding: 19rpx 22rpx; color: #725a35; border-radius: 17rpx; background: #fff8e8; }.deposit-note text:first-child { display: block; font-size: 22rpx; font-weight: 900; }.deposit-note text:last-child { display: block; margin-top: 5rpx; font-size: 18rpx; }
.service-link { display: grid; width: calc(100% - 44rpx); margin: 18rpx 22rpx 0; padding: 19rpx 20rpx; grid-template-columns: 44rpx 1fr 20rpx; align-items: center; gap: 12rpx; border-radius: 17rpx; background: #fff; text-align: left; }.service-link > image:first-child { width: 40rpx; height: 40rpx; }.service-link > image:last-child { width: 18rpx; height: 18rpx; }.service-link view { display: flex; flex-direction: column; }.service-link view text:first-child { font-size: 21rpx; font-weight: 800; }.service-link view text:last-child { color: #8a96a5; font-size: 18rpx; }
.photo-disclosure { margin: 18rpx 32rpx 0; color: #919cab; font-size: 18rpx; text-align: center; }.footer-spacer { height: 150rpx; }
.fixed-footer { position: fixed; z-index: 8; right: 0; bottom: 0; left: 0; display: grid; min-height: 112rpx; padding: 14rpx 22rpx calc(env(safe-area-inset-bottom) + 14rpx); grid-template-columns: 1fr 250rpx; align-items: center; gap: 14rpx; border-top: 1rpx solid #e6ebf1; background: #fff; box-sizing: border-box; }.fixed-footer > view { display: flex; flex-direction: column; }.fixed-footer > view text:first-child { color: #ee6725; font-size: 29rpx; font-weight: 900; }.fixed-footer > view text:last-child { color: #8b96a5; font-size: 17rpx; }.fixed-footer button { min-height: 76rpx; color: #fff; border-radius: 15rpx; background: #1768d4; font-size: 27rpx; font-weight: 900; }
.loading-detail { padding: 22rpx; color: #8793a3; text-align: center; }.gallery-skeleton { height: 420rpx; border-radius: 20rpx; background: #e6ebf1; }.copy-skeleton { height: 260rpx; margin-top: 18rpx; border-radius: 20rpx; background: #e6ebf1; }.loading-detail text { display: block; margin-top: 18rpx; }
.state-card { display: flex; margin: 100rpx 22rpx; padding: 58rpx 30rpx; align-items: center; flex-direction: column; border-radius: 22rpx; background: #fff; }.state-card > image { width: 66rpx; height: 66rpx; }.state-title { margin-top: 18rpx; font-size: 29rpx; font-weight: 900; }.state-copy { margin-top: 8rpx; color: #8995a4; font-size: 21rpx; text-align: center; }.state-card > view { display: flex; margin-top: 22rpx; gap: 10rpx; }.state-card button { padding: 14rpx 23rpx; color: #1768d4; border-radius: 12rpx; background: #eaf3ff; }.state-card button:last-child { color: #fff; background: #1768d4; }
