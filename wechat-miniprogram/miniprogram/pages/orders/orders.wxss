.page { padding-bottom: calc(62rpx + env(safe-area-inset-bottom)); }
.heading { display: flex; margin: 10rpx 2rpx 28rpx; flex-direction: column; }
.orders-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.orders-heading-row .heading { min-width: 0; flex: 1; }
.heading-eyebrow { color: #2e78bf; font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }
.heading-title { margin-top: 4rpx; color: #17253a; font-size: 46rpx; font-weight: 800; letter-spacing: -1rpx; }
.heading-copy { margin-top: 5rpx; color: #7b899b; font-size: 22rpx; }

.order { display: flex; width: 100%; margin-bottom: 19rpx; padding: 25rpx 25rpx 0; overflow: hidden; flex-direction: column; border: 1rpx solid #e1e8ef; border-radius: 27rpx; text-align: left; box-shadow: 0 9rpx 25rpx rgba(31, 59, 94, .055); box-sizing: border-box; }
.order-header { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 16rpx; }
.order-state { display: flex; min-width: 0; align-items: center; gap: 9rpx; }
.service-icon { display: flex; width: 50rpx; height: 50rpx; align-items: center; justify-content: center; border-radius: 15rpx; background: #edf5ff; }
.service-icon image { width: 31rpx; height: 31rpx; }
.service-tag { padding: 5rpx 11rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 750; white-space: nowrap; }
.service-wash { color: #1768cf; background: #eaf3ff; }
.service-inspection { color: #8b5a22; background: #fff5e7; }
.service-repair { color: #1768cf; background: #e7f3ff; }
.status { overflow: hidden; color: #2776cd; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-number { max-width: 205rpx; overflow: hidden; color: #8a97a8; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.name { margin-top: 18rpx; color: #26384e; font-size: 29rpx; font-weight: 800; }
.station { margin-top: 6rpx; overflow: hidden; color: #7b899b; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.footer { display: flex; min-height: 88rpx; margin-top: 20rpx; align-items: center; justify-content: space-between; gap: 14rpx; border-top: 1rpx solid #edf1f5; }
.footer > view { display: flex; min-width: 0; align-items: center; gap: 7rpx; color: #6e8095; font-size: 21rpx; }
.footer > view:first-child image { width: 28rpx; height: 28rpx; }
.footer > view:first-child text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.footer > view:last-child { color: #263f5d; font-size: 25rpx; font-weight: 750; }
.footer > view:last-child image { width: 29rpx; height: 29rpx; }

.order-empty { display: flex; width: 100%; min-width: 0; min-height: 430rpx; padding: 56rpx 28rpx; align-items: center; justify-content: center; overflow: hidden; flex-direction: column; box-sizing: border-box; }
.order-empty > image { width: 74rpx; height: 74rpx; padding: 22rpx; border-radius: 28rpx; background: #edf5ff; }
.order-empty > text:nth-of-type(1) { margin-top: 20rpx; color: #26384e; font-size: 30rpx; font-weight: 750; }
.order-empty > text:nth-of-type(2) { margin-top: 8rpx; color: #7b899b; font-size: 21rpx; text-align: center; }
.empty-actions { display: grid; width: 100%; min-width: 0; margin-top: 28rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; box-sizing: border-box; }
.empty-action { display: flex; width: 100%; min-width: 0; max-width: 100%; min-height: 78rpx; padding: 10rpx 8rpx; overflow: hidden; align-items: center; justify-content: center; color: #1768cf; border: 1rpx solid #cfe0f3; border-radius: 18rpx; background: #fff; font-size: 22rpx; font-weight: 700; line-height: 1.3; text-align: center; overflow-wrap: anywhere; box-sizing: border-box; }
.empty-action.primary { color: #fff; border-color: #1768cf; background: #1768cf; }
