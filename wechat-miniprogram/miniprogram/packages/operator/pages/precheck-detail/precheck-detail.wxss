.detail-page{min-height:100vh;padding:24rpx 26rpx calc(150rpx + env(safe-area-inset-bottom));background:#f4f8fc;box-sizing:border-box}.summary-card{padding:28rpx;border-radius:27rpx;color:#fff;background:linear-gradient(135deg,#075ecb,#2689ef);box-shadow:0 14rpx 32rpx rgba(17,101,205,.2)}.summary-card>view:first-child{display:flex;align-items:flex-end;justify-content:space-between;gap:16rpx}.summary-card>view:first-child text:first-child{font-size:38rpx;font-weight:800}.summary-card>view:first-child text:last-child{font-size:21rpx}.summary-card>text{display:inline-block;margin-top:14rpx;padding:7rpx 13rpx;border-radius:999rpx;background:rgba(255,255,255,.18);font-size:19rpx}.summary-grid{display:grid;margin-top:20rpx;padding-top:18rpx;grid-template-columns:1fr 1fr;gap:18rpx;border-top:1rpx solid rgba(255,255,255,.24)}.summary-grid view{display:flex;min-width:0;flex-direction:column}.summary-grid text:first-child{opacity:.74;font-size:18rpx}.summary-grid text:last-child{margin-top:5rpx;font-size:20rpx;line-height:1.45}.review-note{display:flex;margin-top:18rpx;padding:17rpx;align-items:flex-start;gap:11rpx;color:#45627f;border:1rpx solid #d6e7f8;border-radius:16rpx;background:#eaf4ff;font-size:20rpx;line-height:1.55}.review-note image{width:29rpx;height:29rpx;flex:none}.section-head{display:flex;margin:30rpx 3rpx 16rpx;align-items:flex-end;justify-content:space-between}.section-head>view{display:flex;flex-direction:column}.section-head>view text:first-child{color:#17283e;font-size:32rpx;font-weight:800}.section-head>view text:last-child{margin-top:5rpx;color:#788699;font-size:19rpx}.section-head>text{color:#1768cf;font-size:23rpx;font-weight:800}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:15rpx}.photo-card{position:relative;display:flex;min-width:0;min-height:224rpx;padding:0;overflow:hidden;flex-direction:column;text-align:left;border:2rpx solid transparent;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(27,60,98,.06)}.photo-card>image{width:100%;height:178rpx}.photo-card>text{padding:13rpx 15rpx;color:#263a51;font-size:20rpx;font-weight:700}.photo-card.missing>view{display:flex;height:178rpx;align-items:center;justify-content:center;gap:8rpx;color:#b44b46;background:#fff1f0;font-size:19rpx}.photo-card.missing>view image{width:30rpx;height:30rpx}.photo-card.selected{border-color:#e07168}.bottom-space{height:20rpx}.action-bar{position:fixed;z-index:20;right:0;bottom:0;left:0;display:grid;padding:16rpx 25rpx calc(16rpx + env(safe-area-inset-bottom));grid-template-columns:.8fr 1.25fr;gap:12rpx;border-top:1rpx solid #e0e8f1;background:rgba(255,255,255,.97)}.action-bar button{min-height:94rpx;border-radius:18rpx;font-size:24rpx;font-weight:800}.action-bar .reject{color:#c94a45;border:1rpx solid #efc1be;background:#fff}.action-bar .approve{color:#fff;background:#1768cf}.sheet-layer{position:fixed;z-index:60;inset:0}.sheet-mask{position:absolute;inset:0;background:rgba(10,22,38,.5)}.reject-sheet{position:absolute;right:0;bottom:0;left:0;max-height:88vh;padding:24rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#fff;box-sizing:border-box}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15rpx}.sheet-head>view{display:flex;flex-direction:column}.sheet-head>view text:first-child{color:#17283e;font-size:32rpx;font-weight:800}.sheet-head>view text:last-child{margin-top:5rpx;color:#788699;font-size:19rpx}.sheet-head button{min-width:100rpx;min-height:80rpx;color:#607086;font-size:21rpx}.sheet-scroll{max-height:58vh;margin-top:16rpx}.field-label{display:block;margin:22rpx 0 12rpx;color:#33465d;font-size:22rpx;font-weight:750}.reason-grid{display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.reason-grid button,.photo-tags button{min-height:76rpx;padding:10rpx 13rpx;color:#536378;border:1rpx solid #dce5ee;border-radius:13rpx;background:#f9fbfd;font-size:19rpx;line-height:1.35}.reason-grid button.selected,.photo-tags button.selected{color:#1768cf;border-color:#79afe8;background:#eaf4ff;font-weight:700}.photo-tags{display:flex;flex-wrap:wrap;gap:9rpx}.photo-tags button{min-height:70rpx}.sheet-scroll textarea{width:100%;min-height:190rpx;padding:18rpx;color:#26384f;border:1rpx solid #dce5ee;border-radius:16rpx;background:#f9fbfd;font-size:21rpx;line-height:1.55;box-sizing:border-box}.count{display:block;margin-top:7rpx;color:#8b96a5;text-align:right;font-size:18rpx}.refund-warning{display:flex;margin:18rpx 0;padding:17rpx;flex-direction:column;color:#a54c45;border-radius:15rpx;background:#fff0ef}.refund-warning text:first-child{font-size:18rpx}.refund-warning text:last-child{margin-top:5rpx;font-size:21rpx;font-weight:750;line-height:1.45}.confirm-reject{width:100%;min-height:92rpx;margin-top:14rpx;color:#fff;border-radius:17rpx;background:#d44848;font-size:24rpx;font-weight:800}.state-card{display:flex;min-height:400rpx;padding:30rpx;align-items:center;justify-content:center;flex-direction:column;color:#718096;border-radius:24rpx;background:#fff;text-align:center}.state-card button{min-width:220rpx;min-height:88rpx;margin-top:20rpx;color:#fff;border-radius:16rpx;background:#1768cf}@media(max-width:340px){.photo-grid{grid-template-columns:1fr}.summary-grid{grid-template-columns:1fr}.reason-grid{grid-template-columns:1fr}}
