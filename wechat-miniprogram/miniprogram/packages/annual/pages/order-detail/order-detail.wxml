<wxs module="fmt" src="../../../../utils/format.wxs" />
<view class="page detail-page">
  <view wx:if="{{loading}}" class="detail-loading">
    <image src="/assets/icons/clock.png" mode="aspectFit" />
    <text>正在读取履约进度…</text>
  </view>

  <view wx:elif="{{booking}}">
    <view wx:if="{{loadError}}" class="detail-inline-error">
      <text>{{loadError}}，当前保留的是上次成功同步的订单信息。</text>
      <button bindtap="retryLoad" disabled="{{loading}}">刷新</button>
    </view>
    <view class="status-hero status-{{booking.status}}">
      <view class="status-top">
        <view class="status-icon"><image src="/assets/icons/calendar-check-white.png" mode="aspectFit" /></view>
        <view><text>当前状态</text><text>{{fmt.statusLabel(booking.status)}}</text></view>
      </view>
      <text class="status-copy">{{booking.vehicle ? booking.vehicle.plateNumber : '预约车辆'}} · {{booking.station ? booking.station.name : '预约检测站'}}</text>
      <view class="hero-meta">
        <text>{{booking.precheckSlotReleased ? "原时段已释放 · 处理后重新选择" : booking.appointmentDate + " " + booking.startTime + "–" + booking.endTime}}</text>
        <text>¥{{fmt.money(booking.serviceFeeFen)}}</text>
      </view>
    </view>

    <view wx:if="{{booking.precheck && booking.status === 'precheck_action_required'}}" class="precheck-owner-card pending urgent">
      <view class="precheck-urgent-badge">需要你处理</view>
      <view class="precheck-owner-head">
        <image src="/assets/icons/warning-circle.png"/>
        <view>
          <text>预检发现问题，等待你处理</text>
          <text>{{booking.precheck.reasonText || '检测站已标注问题，请查看处理方式'}}</text>
        </view>
      </view>
      <text class="precheck-owner-note">订单和已付款保留，原时段已释放。请尽快补充资料、选择洗车或维修后再次提交审核；也可以主动申请退款。</text>
      <button class="pay-button precheck-urgent-button" bindtap="openPrecheckActions">查看问题与处理方式</button>
    </view>
    <view wx:if="{{booking.precheck && booking.status === 'pending_precheck'}}" class="precheck-owner-card pending top-alert">
      <view class="precheck-owner-head"><image src="/assets/icons/clock.png"/><view><text>等待检测站照片预审</text><text>检测站正在核对行驶证、车辆四角和启动后仪表盘共 7 张资料。</text></view></view>
      <view class="precheck-owner-meta"><text>提交时间</text><text>{{booking.precheck.submittedAt}}</text></view>
      <text class="precheck-owner-note">{{precheckSupervisionNote}}</text>
    </view>
    <view wx:if="{{booking.precheck && booking.precheck.status === 'approved'}}" class="precheck-owner-card approved top-alert">
      <view class="precheck-owner-head"><image src="/assets/icons/shield-check.png"/><view><text>检测站预审已通过</text><text>检测站已核对 7 张预约资料并接单，订单已进入后续履约阶段。</text></view></view>
      <view class="precheck-owner-meta"><text>审核时间</text><text>{{precheckReviewedAt}}</text></view>
    </view>
    <view wx:if="{{booking.precheck && booking.status === 'precheck_rejected'}}" class="precheck-owner-card rejected top-alert">
      <view class="precheck-owner-head"><image src="/assets/icons/warning-circle.png"/><view><text>检测站预审未通过</text><text>{{booking.precheck.reasonText}}</text></view></view>
      <view class="precheck-owner-meta"><text>问题类型</text><text>{{precheckReasonText || '检测站已填写具体说明'}}</text></view>
      <view wx:if="{{precheckIssueText}}" class="precheck-owner-meta"><text>涉及照片</text><text>{{precheckIssueText}}</text></view>
      <view class="precheck-owner-meta"><text>审核时间</text><text>{{precheckReviewedAt}}</text></view>
      <view class="precheck-refund-status"><text>{{booking.refundStatus === 'refunded' ? '模拟退款已完成' : booking.refundStatus === 'refund_failed' ? '退款异常，平台处理中' : '退款处理中'}}</text><text>¥{{fmt.money(booking.precheck.refundAmountFen)}}</text></view>
      <button bindtap="rebook">重新预约</button>
    </view>

    <view class="order-number">
      <image src="/assets/icons/receipt.png" mode="aspectFit" />
      <text>订单号</text>
      <text>{{booking.bookingNumber}}</text>
    </view>

    <button wx:if="{{booking.vehicleCheckupReport}}" class="checkup-report-entry" bindtap="openCheckupReport">
      <view class="entry-icon"><image src="/assets/icons/file-arrow-up.png" mode="aspectFit"/></view>
      <view class="entry-content"><view class="entry-title-row"><text>查看检测报告与留证</text><image class="entry-caret" src="/assets/icons/caret-right.png" mode="aspectFit"/></view><view class="entry-material-groups"><view class="{{checkupLegalMaterialsMissing ? 'missing' : ''}}"><text>检测证明材料</text><text>{{checkupLegalMaterialsText}}</text></view><view><text>平台车辆体检留证</text><text>{{checkupPlatformEvidenceText}}</text></view></view><text class="entry-report-boundary">平台车辆体检报告不替代法定检测报告</text></view>
    </button>

    <view wx:if="{{booking.station}}" class="station-contact-card">
      <view class="station-contact-head">
        <view class="station-contact-icon"><image src="/assets/icons/storefront.png" mode="aspectFit" /></view>
        <view>
          <text>预约检测站</text>
          <text>{{booking.station.name}}</text>
          <text>{{booking.station.address || booking.station.district || '地址待确认'}}</text>
        </view>
      </view>
      <view class="station-contact-row">
        <view>
          <text>联系电话</text>
          <text>{{booking.station.phone || '暂未提供'}}</text>
        </view>
        <button wx:if="{{booking.station.phone}}" class="station-call-button" bindtap="callStation">
          <image src="/assets/icons/phone.png" mode="aspectFit" />
          <text>拨打</text>
        </button>
      </view>
    </view>

    <view wx:if="{{booking.serviceMode === 'valet' && booking.driverAssignment && (booking.driverAssignment.pickupDriverPhone || booking.driverAssignment.returnDriverPhone)}}" class="valet-driver-contacts-card">
      <view class="valet-driver-contacts-head">
        <view class="valet-driver-contacts-icon"><image src="/assets/icons/car.png" mode="aspectFit" /></view>
        <view>
          <text>代驾联系方式</text>
          <text>取送车司机绑定后展示，便于你联系履约人员</text>
        </view>
      </view>
      <view wx:if="{{booking.driverAssignment.pickupDriverPhone}}" class="valet-driver-contact-row">
        <view>
          <text>取车代驾联系方式</text>
          <text>{{booking.driverAssignment.pickupDriverPhone}}</text>
        </view>
      </view>
      <view wx:if="{{booking.driverAssignment.returnDriverPhone}}" class="valet-driver-contact-row">
        <view>
          <text>送车司机联系方式</text>
          <text>{{booking.driverAssignment.returnDriverPhone}}</text>
        </view>
      </view>
    </view>

    <view class="payment-card payment-{{paymentStateTone}}">
      <view class="payment-head">
        <view class="payment-icon"><image src="/assets/icons/receipt.png" mode="aspectFit" /></view>
        <view>
          <text>{{paymentStateTitle}}</text>
          <text>{{paymentStateCopy}}</text>
        </view>
      </view>
      <view class="payment-summary-row"><text>{{paymentSummaryLabel}}</text><text>¥{{fmt.money(paymentSummaryFen)}}</text></view>
      <view wx:if="{{refundedFen > 0}}" class="payment-refund-row"><text>{{refundRowLabel}}</text><text>−¥{{fmt.money(refundedFen)}}</text></view>
      <view class="quote-breakdown">
        <view><text>年检服务费</text><text>¥{{fmt.money(booking.inspectionFeeFen)}}</text></view>
        <view wx:if="{{booking.serviceMode === 'valet'}}"><text>往返取送费</text><text>¥{{fmt.money(booking.valetFeeFen)}}</text></view>
        <view class="quote-total"><text>订单报价合计</text><text>¥{{fmt.money(booking.serviceFeeFen)}}</text></view>
      </view>
      <view wx:if="{{booking.serviceMode === 'valet'}}" class="quote-route-card">
        <view><image src="/assets/icons/map-pin.png" mode="aspectFit"/><text>代驾路线与计价依据</text></view>
        <text>{{routeSummaryText}}</text>
        <text>{{pricingFormulaText}}</text>
      </view>
      <view wx:if="{{paymentPending && booking.status === 'pending_payment' && booking.paymentStatus !== 'paid' && booking.paymentStatus !== 'refunded'}}" class="quote-validity {{quoteExpired ? 'expired' : ''}}">
        <view><text>报价有效截止时间</text><text>{{quoteExpiryText}}</text></view>
        <view><text>报价快照</text><text>{{quoteSnapshotText}}</text></view>
      </view>
      <view wx:if="{{priceChangeNotice}}" class="price-change-notice"><image src="/assets/icons/warning-circle.png" mode="aspectFit"/><text>{{priceChangeNotice}}</text></view>
      <view wx:if="{{paymentPending && booking.status === 'pending_payment' && booking.paymentStatus !== 'paid' && booking.paymentStatus !== 'refunded' && quoteExpired}}" class="quote-expired-actions">
        <view><text>报价已过期</text><text>原订单与预约时段仍保留，更新报价后再确认支付。</text></view>
        <button loading="{{requoting}}" disabled="{{requoting || paying}}" bindtap="requote">{{requoting ? '正在重新报价…' : '重新报价'}}</button>
      </view>
      <button wx:if="{{paymentPending && booking.status === 'pending_payment' && booking.paymentStatus !== 'paid' && booking.paymentStatus !== 'refunded' && !quoteExpired}}" class="pay-button" loading="{{paying}}" disabled="{{paying || requoting}}" bindtap="pay">
        <text>{{paying ? payingLabel : payButtonLabel}}</text>
      </button>
      <view class="mock-notice"><image src="/assets/icons/shield-check.png" mode="aspectFit" /><text>{{paymentNotice}}</text></view>
      <view wx:if="{{paymentError}}" class="payment-error"><image src="/assets/icons/warning-circle.png" mode="aspectFit" /><text>{{paymentError}}</text></view>
    </view>

    <view wx:if="{{booking.pickupAddress}}" class="pickup-card">
      <view class="pickup-icon"><image src="/assets/icons/map-pin.png" mode="aspectFit" /></view>
      <view>
        <text>上门取送车地址</text>
        <text>{{booking.pickupAddress.title}}</text>
        <text>{{booking.pickupAddress.address}} {{booking.pickupAddress.detail}}</text>
      </view>
    </view>

    <view class="section-title">
      <view><text>履约进度</text><text>后台状态实时同步</text></view>
      <text>双端同步</text>
    </view>

    <view class="timeline-card">
      <block wx:if="{{booking.events && booking.events.length}}">
        <view wx:for="{{booking.events}}" wx:key="id" class="event">
          <image class="event-icon" src="/assets/icons/check-circle.png" mode="aspectFit" />
          <view class="event-copy">
            <text>{{item.title}}</text>
            <text>{{item.description}}</text>
            <text>{{item.createdAt}}</text>
          </view>
        </view>
      </block>
      <view wx:if="{{!booking.events || !booking.events.length}}" class="timeline-empty">
        <image src="/assets/icons/clock.png" mode="aspectFit" />
        <text>履约记录生成后会展示在这里</text>
      </view>
    </view>

    <block wx:if="{{booking.serviceMode === 'valet'}}">
      <view class="section-title evidence-title">
        <view><text>履约留证</text><text>取车、到站、检测与送回全程可查看</text></view>
        <text>只读记录</text>
      </view>
      <view wx:if="{{evidenceStages.length}}" class="evidence-stage-list">
        <view wx:for="{{evidenceStages}}" wx:key="stage" class="evidence-stage evidence-{{item.statusTone}}">
          <view class="evidence-stage-head">
            <text class="evidence-number">{{item.number}}</text>
            <view><text>{{item.label}}</text><text>{{item.description}}</text></view>
            <view class="evidence-badge"><text>{{item.countText}}</text><text>{{item.statusText}}</text></view>
          </view>
          <view wx:if="{{item.status === 'completed'}}" class="evidence-meta">
            <text>{{item.capturedByLabel || '履约人员'}}</text>
            <text>{{item.capturedAt || '服务端时间已记录'}}</text>
          </view>
          <scroll-view wx:if="{{item.photos.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="evidence-photo-scroll">
            <view class="evidence-photo-list">
              <view wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id" class="evidence-photo-item">
                <button wx:if="{{photo.loadState === 'ready'}}" class="evidence-photo-button" data-stage="{{item.stage}}" data-url="{{photo.url}}" bindtap="previewEvidence" aria-label="查看{{item.label}}{{photo.label}}留证照片">
                  <image src="{{photo.url}}" mode="aspectFill" data-stage="{{item.stage}}" data-photo-id="{{photo.id}}" binderror="handleEvidenceImageError"/>
                </button>
                <view wx:elif="{{photo.loadState === 'loading'}}" class="evidence-photo-placeholder evidence-photo-loading" aria-label="正在安全读取{{item.label}}{{photo.label}}留证照片">
                  <image src="/assets/icons/clock.png" mode="aspectFit"/><text>安全读取中</text>
                </view>
                <button wx:else class="evidence-photo-placeholder evidence-photo-retry" data-stage="{{item.stage}}" data-photo-id="{{photo.id}}" bindtap="retryEvidencePhoto" aria-label="重新读取{{item.label}}{{photo.label}}留证照片">
                  <image src="/assets/icons/warning-circle.png" mode="aspectFit"/><text>重新加载</text>
                </button>
                <text class="evidence-photo-label">{{photo.label}}</text>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="evidence-pending-copy"><image src="/assets/icons/clock.png" mode="aspectFit"/><text>进行到该节点并完成现场拍摄后，照片会自动显示在这里。</text></view>
        </view>
      </view>
      <view wx:elif="{{legacyEvidence}}" class="legacy-evidence-card"><image src="/assets/icons/clock.png" mode="aspectFit"/><view><text>历史订单未采集分阶段留证</text><text>该订单沿用旧履约规则，平台不会补造取车、到站或送回照片。</text></view></view>
    </block>

    <view wx:if="{{booking.inspectionResult}}" class="result-card">
      <view class="result-icon"><image src="/assets/icons/shield-check.png" mode="aspectFit" /></view>
      <view>
        <text>检测结果已回传</text>
        <text>{{inspectionResultText}}</text>
        <text>来源：{{booking.inspectionResult.source}}</text>
      </view>
    </view>
    <view wx:if="{{booking.media && booking.media.length}}" class="section-title">
      <view><text>预约资料</text><text>已安全保存 {{booking.media.length}} 张</text></view>
      <text>点击预览</text>
    </view>

    <scroll-view wx:if="{{booking.media && booking.media.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="media-strip">
      <view class="media-list">
        <block wx:for="{{booking.media}}" wx:key="id">
          <button wx:if="{{item.loadState === 'ready' && item.url}}" data-url="{{item.url}}" bindtap="preview" class="media-item" aria-label="查看预约资料原图">
            <image src="{{item.url}}" mode="aspectFill" data-media-id="{{item.id}}" binderror="handleBookingMediaError" />
            <view><image src="/assets/icons/camera.png" mode="aspectFit" /><text>查看原图</text></view>
          </button>
          <view wx:elif="{{item.loadState === 'loading'}}" class="media-item media-item-state" aria-label="正在安全读取预约资料"><image src="/assets/icons/clock.png" mode="aspectFit"/><text>安全读取中</text></view>
          <button wx:else class="media-item media-item-state media-item-retry" data-media-id="{{item.id}}" bindtap="retryBookingMedia" aria-label="重新安全读取预约资料"><image src="/assets/icons/warning-circle.png" mode="aspectFit"/><text>读取失败</text><text>点击重试</text></button>
        </block>
      </view>
    </scroll-view>

    <button wx:if="{{booking.status === 'pending_payment' || booking.status === 'pending_precheck' || booking.status === 'confirmed' || booking.status === 'awaiting_arrival'}}" class="cancel-button" bindtap="cancel" loading="{{cancelling}}" disabled="{{cancelling || paying || requoting}}">
      <image src="/assets/icons/trash.png" mode="aspectFit" />
      <text>{{cancelling ? '正在处理…' : booking.paymentStatus === 'paid' ? '申请退款并取消预约' : '取消预约'}}</text>
    </button>

    <view class="order-assurance">
      <image src="/assets/icons/shield-check.png" mode="aspectFit" />
      <text>{{paymentFooterNote}}</text>
    </view>
  </view>

  <view wx:else class="empty-state">
    <image src="/assets/icons/warning-circle.png" mode="aspectFit" />
    <text>{{missingOrder ? '缺少订单信息，请从订单列表进入' : (loadError ? '暂时无法读取订单详情' : '暂时无法显示订单详情')}}</text>
    <text>{{missingOrder ? '该页面需要有效的年检订单编号。' : (loadError || '请返回订单列表后重新进入。')}}</text>
    <view class="fallback-actions">
      <view wx:if="{{id && loadError}}" role="button" tabindex="0" class="fallback-action primary" bindtap="retryLoad">重新加载</view>
      <view role="button" tabindex="0" class="fallback-action {{id && loadError ? '' : 'primary'}}" bindtap="goOrders">返回订单</view>
      <view wx:if="{{!id || !loadError}}" role="button" tabindex="0" class="fallback-action" bindtap="goHome">返回首页</view>
    </view>
  </view>

  <view wx:if="{{viewerOpen}}" class="evidence-image-viewer" catchtouchmove="blockViewerTouch">
    <view class="evidence-image-viewer-mask" bindtap="closeImageViewer"></view>
    <view class="evidence-image-viewer-dialog" role="dialog" aria-label="履约留证图片查看器" catchtap="blockViewerTouch">
      <view class="evidence-image-viewer-head"><view><text>履约留证</text><text>{{viewerLabel}}</text></view><button aria-label="关闭图片查看器" bindtap="closeImageViewer">关闭</button></view>
      <view class="evidence-image-viewer-stage"><image src="{{viewerUrl}}" mode="aspectFit" aria-label="{{viewerLabel}}" binderror="handleEvidenceImageError"/></view>
      <view class="evidence-image-viewer-controls">
        <button bindtap="previousViewerImage" disabled="{{!viewerHasPrevious}}"><text>‹</text><text>上一张</text></button>
        <view><text>{{viewerCounter}}</text><text>当前留证组</text></view>
        <button bindtap="nextViewerImage" disabled="{{!viewerHasNext}}"><text>下一张</text><text>›</text></button>
      </view>
    </view>
  </view>
</view>
