.stations-page {
  min-height: 100vh;
  padding: 26rpx 24rpx calc(52rpx + env(safe-area-inset-bottom));
  color: #15243a;
  background: #f6f9fc;
  box-sizing: border-box;
}

.flow-kicker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1768cf;
  font-size: 21rpx;
  font-weight: 800;
}

.flow-kicker image {
  width: 28rpx;
  height: 28rpx;
}

.heading {
  display: flex;
  margin: 14rpx 3rpx 24rpx;
  flex-direction: column;
}

.heading text:first-child {
  color: #13243b;
  font-size: 40rpx;
  font-weight: 850;
}

.heading text:last-child {
  margin-top: 8rpx;
  color: #7b899c;
  font-size: 23rpx;
  line-height: 1.55;
}

.origin-card {
  display: grid;
  min-height: 104rpx;
  padding: 18rpx 20rpx;
  grid-template-columns: 54rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid #dce6f1;
  border-radius: 19rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(27, 61, 101, .055);
}

.origin-icon {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #eaf3ff;
}

.origin-icon image {
  width: 31rpx;
  height: 31rpx;
}

.origin-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.origin-copy text:first-child {
  color: #365573;
  font-size: 21rpx;
  font-weight: 700;
}

.origin-copy text:last-child {
  display: -webkit-box;
  margin-top: 5rpx;
  overflow: hidden;
  color: #233951;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.origin-card > button.origin-action {
  display: flex;
  width: 152rpx;
  min-width: 152rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  color: #1768cf;
  border-radius: 12rpx;
  background: #eaf3ff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  box-sizing: border-box;
}

.search-box {
  display: flex;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid #e0e7ef;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.search-box > image {
  width: 30rpx;
  height: 30rpx;
}

.search-box input,
.search-box .pickup-search-input {
  flex: 1;
  min-width: 0;
  height: 86rpx;
  color: #27496e;
  font-size: 23rpx;
}

.search-box > text {
  flex: 0 0 auto;
  color: #6f86a0;
  font-size: 19rpx;
}

.search-feedback {
  display: flex;
  min-height: 72rpx;
  margin-top: 8rpx;
  padding: 14rpx 17rpx;
  align-items: center;
  gap: 8rpx;
  color: #6f8194;
  border-radius: 13rpx;
  background: #f1f5f9;
  font-size: 20rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.search-feedback image { width: 27rpx; height: 27rpx; flex: 0 0 auto; }
.search-feedback.error-feedback { color: #a34a44; background: #fff2f1; }

.suggestions {
  margin-top: 8rpx;
  overflow: hidden;
  border: 1rpx solid #dce6f0;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(24, 61, 105, .10);
}

.suggestion-row {
  display: grid;
  width: 100%;
  min-height: 92rpx;
  padding: 16rpx 18rpx;
  grid-template-columns: 30rpx minmax(0, 1fr) 20rpx;
  align-items: center;
  gap: 12rpx;
  text-align: left;
}

.suggestion-row + .suggestion-row {
  border-top: 1rpx solid #edf1f5;
}

.suggestion-row > image:first-child {
  width: 28rpx;
  height: 28rpx;
}

.suggestion-row > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.suggestion-row text:first-child {
  overflow: hidden;
  color: #203951;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-row text:last-child {
  display: -webkit-box;
  margin-top: 4rpx;
  overflow: hidden;
  color: #8392a3;
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.suggestion-caret {
  width: 18rpx;
  height: 18rpx;
}

.route-notice {
  display: grid;
  margin: 16rpx 0;
  padding: 17rpx 18rpx;
  grid-template-columns: 32rpx minmax(0, 1fr);
  align-items: start;
  gap: 11rpx;
  border-radius: 14rpx;
  background: #edf5ff;
}

.route-notice > image {
  width: 30rpx;
  height: 30rpx;
}

.route-notice > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.route-notice text:first-child {
  color: #2a639f;
  font-size: 21rpx;
  font-weight: 800;
}

.route-notice text:last-child {
  margin-top: 4rpx;
  color: #6f86a0;
  font-size: 19rpx;
  line-height: 1.5;
}

.station-loading {
  display: flex;
  min-height: 220rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14rpx;
  color: #7e8fa3;
  font-size: 22rpx;
}

.station-loading image {
  width: 58rpx;
  height: 58rpx;
  opacity: .72;
}

.station-card {
  display: grid;
  width: 100%;
  min-height: 274rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  grid-template-columns: 182rpx minmax(0, 1fr);
  border: 1rpx solid #e1e7ee;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31, 58, 91, .055);
  text-align: left;
}

.station-card.requires-origin {
  border-color: #dce3eb;
  box-shadow: none;
}

.station-card.requires-origin .station-photo,
.station-card.requires-origin .station-body {
  opacity: .72;
}

.station-card.requires-origin .choose-station {
  color: #7b8998;
}

.station-photo {
  width: 182rpx;
  height: 100%;
  min-height: 274rpx;
}

.station-body {
  display: flex;
  min-width: 0;
  padding: 17rpx 18rpx;
  flex-direction: column;
}

.station-flags {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.district {
  max-width: 180rpx;
  padding: 4rpx 8rpx;
  overflow: hidden;
  color: #1768cf;
  border-radius: 6rpx;
  background: #eaf3ff;
  font-size: 17rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.district.nearest {
  color: #157856;
  background: #e8f8f1;
}

.rating {
  color: #c87929;
  font-size: 18rpx;
  white-space: nowrap;
}

.station-name {
  display: -webkit-box;
  margin-top: 9rpx;
  overflow: hidden;
  color: #1c3048;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.address {
  margin-top: 5rpx;
  overflow: hidden;
  color: #8391a2;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-row {
  display: flex;
  margin-top: 8rpx;
  align-items: center;
  gap: 6rpx;
  color: #4d6e90;
  font-size: 19rpx;
}

.route-row image {
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 auto;
}

.tags {
  display: flex;
  height: 34rpx;
  margin-top: 8rpx;
  overflow: hidden;
  gap: 6rpx;
}

.tags text {
  padding: 3rpx 7rpx;
  color: #647b94;
  border-radius: 5rpx;
  background: #f1f5f9;
  font-size: 16rpx;
  white-space: nowrap;
}

.station-bottom {
  display: flex;
  margin-top: auto;
  padding-top: 10rpx;
  align-items: flex-end;
  justify-content: space-between;
  border-top: 1rpx solid #edf1f5;
}

.price {
  display: flex;
  flex-direction: column;
}

.price text:first-child {
  color: #8a98a8;
  font-size: 16rpx;
}

.price text:last-child {
  color: #e66b2e;
  font-size: 27rpx;
  font-weight: 850;
}

.choose-station {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: #1768cf;
  font-size: 18rpx;
  font-weight: 700;
}

.choose-station image {
  width: 17rpx;
  height: 17rpx;
}

.empty-state {
  display: flex;
  min-height: 250rpx;
  padding: 36rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx solid #e2e8ef;
  border-radius: 20rpx;
  background: #fff;
}

.empty-state image {
  width: 60rpx;
  height: 60rpx;
}

.empty-state text:nth-child(2) {
  margin-top: 16rpx;
  color: #26384e;
  font-size: 26rpx;
  font-weight: 800;
}

.empty-state text:last-child {
  margin-top: 6rpx;
  color: #8593a4;
  font-size: 20rpx;
  text-align: center;
}

.empty-state button {
  min-width: 240rpx;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  color: #1768cf;
  border: 1rpx solid #bad4ed;
  border-radius: 14rpx;
  background: #f7fbff;
  font-size: 22rpx;
  font-weight: 750;
}

.station-error-state { border-color: #efd0cd; background: #fffafa; }
