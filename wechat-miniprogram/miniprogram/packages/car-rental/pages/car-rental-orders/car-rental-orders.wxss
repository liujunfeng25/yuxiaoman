.orders-page { min-height: 100vh; padding: 18rpx 22rpx 50rpx; color: #17263b; background: #f4f7fb; box-sizing: border-box; }
.orders-hero { display: flex; padding: 24rpx; align-items: center; justify-content: space-between; color: #fff; border-radius: 20rpx; background: linear-gradient(120deg,#105fc6,#258ade); }.orders-hero > view { display: flex; flex-direction: column; }.orders-hero > view text:first-child { font-size: 30rpx; font-weight: 900; }.orders-hero > view text:last-child { margin-top: 4rpx; font-size: 18rpx; opacity: .8; }.orders-hero button { padding: 11rpx 18rpx; color: #1768d4; border-radius: 999rpx; background: #fff; font-size: 20rpx; font-weight: 800; }
.order-list { margin-top: 16rpx; }.order-card { display: block; width: 100%; margin-bottom: 14rpx; padding: 20rpx; border-radius: 19rpx; background: #fff; box-shadow: 0 7rpx 20rpx rgba(25,54,88,.05); text-align: left; }.order-head { display: flex; padding-bottom: 13rpx; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; }.order-head text:first-child { color: #6f7d8f; font-size: 18rpx; }.order-head text:last-child { font-size: 20rpx; font-weight: 800; }.tone-warning { color: #e57524; }.tone-success,.tone-primary { color: #1768d4; }.tone-muted { color: #8b96a5; }
.model { display: grid; margin-top: 15rpx; grid-template-columns: 180rpx 1fr; gap: 13rpx; }.model > image { width: 180rpx; height: 122rpx; border-radius: 12rpx; background: #edf1f5; }.model > view { display: flex; min-width: 0; justify-content: center; flex-direction: column; }.model > view text:first-child { overflow: hidden; font-size: 23rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.model > view text:nth-child(2) { margin-top: 5rpx; color: #1768d4; font-size: 18rpx; }.model > view text:last-child { margin-top: 4rpx; overflow: hidden; color: #8390a0; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-foot { display: flex; margin-top: 15rpx; padding-top: 14rpx; align-items: center; justify-content: space-between; border-top: 1rpx solid #edf0f4; }.order-foot > text { padding: 5rpx 9rpx; color: #1768d4; border-radius: 6rpx; background: #eaf3ff; font-size: 17rpx; }.order-foot > view { display: flex; align-items: baseline; gap: 4rpx; }.order-foot > view text:first-child { color: #8b96a5; font-size: 17rpx; }.order-foot > view text:nth-child(2) { color: #ee6725; font-size: 26rpx; font-weight: 900; }.order-foot image { width: 18rpx; height: 18rpx; margin-left: 4rpx; }.list-note { padding: 18rpx; color: #929dab; font-size: 17rpx; text-align: center; }
.skeleton-list { display: flex; margin-top: 16rpx; align-items: center; flex-direction: column; color: #8793a3; font-size: 19rpx; }.skeleton-list view { width: 100%; height: 230rpx; margin-bottom: 13rpx; border-radius: 19rpx; background: #e6ebf1; }.state-card { display: flex; margin-top: 50rpx; padding: 55rpx 26rpx; align-items: center; flex-direction: column; border-radius: 20rpx; background: #fff; }.state-card > image { width: 66rpx; height: 66rpx; }.state-title { margin-top: 17rpx; font-size: 28rpx; font-weight: 900; }.state-copy { margin-top: 8rpx; color: #8995a4; font-size: 20rpx; text-align: center; }.state-card button { margin-top: 21rpx; padding: 14rpx 24rpx; color: #fff; border-radius: 12rpx; background: #1768d4; font-size: 22rpx; font-weight: 800; }
