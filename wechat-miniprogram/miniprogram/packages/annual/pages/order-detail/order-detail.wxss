.detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(52rpx + env(safe-area-inset-bottom));
  color: #15243a;
  background: #f5f8fc;
  box-sizing: border-box;
}

.detail-loading,
.empty-state {
  display: flex;
  min-height: 62vh;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14rpx;
  color: #7e8fa3;
  font-size: 22rpx;
}

.detail-loading image,
.empty-state image {
  width: 64rpx;
  height: 64rpx;
  opacity: .75;
}

.empty-state text:nth-child(2) {
  color: #26384e;
  font-size: 27rpx;
  font-weight: 800;
}

.empty-state > text:nth-child(3) {
  margin-top: -6rpx;
  color: #8996a6;
  font-size: 20rpx;
}

.fallback-actions {
  display: grid;
  width: 100%;
  min-width: 0;
  max-width: 600rpx;
  margin-top: 18rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  box-sizing: border-box;
}

.fallback-action {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  padding: 10rpx 8rpx;
  align-items: center;
  justify-content: center;
  color: #1768cf;
  border: 1rpx solid #cfe0f3;
  border-radius: 18rpx;
  background: #fff;
  font-size: 22rpx;
  font-weight: 750;
  text-align: center;
  box-sizing: border-box;
}

.fallback-action.primary {
  color: #fff;
  border-color: #1768cf;
  background: #1768cf;
}

.detail-inline-error {
  display: flex;
  min-height: 88rpx;
  margin-bottom: 18rpx;
  padding: 12rpx 14rpx 12rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: #8a5517;
  border: 1rpx solid #efd8aa;
  border-radius: 16rpx;
  background: #fff8ea;
  font-size: 21rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.detail-inline-error text { flex: 1; }
.detail-inline-error button { min-width: 112rpx; min-height: 88rpx; padding: 0 16rpx; color: #8a5517; border: 1rpx solid #e3c288; border-radius: 14rpx; background: #fff; font-size: 22rpx; font-weight: 750; }

.status-hero {
  padding: 28rpx;
  overflow: hidden;
  color: #fff;
  border-radius: 22rpx;
  background: #1768cf;
  box-shadow: 0 12rpx 28rpx rgba(23, 104, 207, .20);
}

.status-hero.status-pending_payment {
  background: #e47a2f;
  box-shadow: 0 12rpx 28rpx rgba(228, 122, 47, .18);
}

.status-hero.status-completed {
  background: #23825f;
  box-shadow: 0 12rpx 28rpx rgba(35, 130, 95, .18);
}

.status-hero.status-cancelled,
.status-hero.status-no_show {
  background: #7c8795;
  box-shadow: none;
}

.status-hero.status-on_hold {
  background: #b87524;
}

.status-top {
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  align-items: center;
  gap: 13rpx;
}

.status-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, .16);
}

.status-icon image {
  width: 36rpx;
  height: 36rpx;
}

.status-top > view:last-child {
  display: flex;
  flex-direction: column;
}

.status-top > view:last-child text:first-child {
  color: rgba(255, 255, 255, .78);
  font-size: 19rpx;
}

.status-top > view:last-child text:last-child {
  margin-top: 2rpx;
  font-size: 37rpx;
  font-weight: 850;
}

.status-copy {
  display: block;
  margin-top: 20rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, .88);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta {
  display: flex;
  margin-top: 15rpx;
  padding-top: 15rpx;
  align-items: flex-end;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, .22);
}

.hero-meta text:first-child {
  color: rgba(255, 255, 255, .78);
  font-size: 20rpx;
}

.hero-meta text:last-child {
  font-size: 32rpx;
  font-weight: 850;
}

.order-number {
  display: grid;
  min-height: 72rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  grid-template-columns: 28rpx auto minmax(0, 1fr);
  align-items: center;
  gap: 9rpx;
  border: 1rpx solid #e2e8ef;
  border-radius: 15rpx;
  background: #fff;
  color: #8592a3;
  font-size: 19rpx;
}

.order-number image {
  width: 27rpx;
  height: 27rpx;
}

.order-number text:last-child {
  min-width: 0;
  overflow: hidden;
  color: #3e536a;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-contact-card {
  margin-top: 16rpx;
  padding: 22rpx 24rpx 20rpx;
  border: 1rpx solid #e1e7ee;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(25, 57, 94, .05);
}

.station-contact-head {
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr);
  align-items: start;
  gap: 13rpx;
}

.station-contact-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #eaf3ff;
}

.station-contact-icon image {
  width: 30rpx;
  height: 30rpx;
}

.station-contact-head > view:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.station-contact-head > view:last-child text:first-child {
  color: #7a8a9c;
  font-size: 20rpx;
  font-weight: 700;
}

.station-contact-head > view:last-child text:nth-child(2) {
  margin-top: 4rpx;
  color: #1b314b;
  font-size: 28rpx;
  font-weight: 850;
}

.station-contact-head > view:last-child text:last-child {
  margin-top: 6rpx;
  color: #66788c;
  font-size: 21rpx;
  line-height: 1.45;
}

.station-contact-row {
  display: flex;
  margin-top: 18rpx;
  padding-top: 16rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid #edf1f5;
}

.station-contact-row > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.station-contact-row > view text:first-child {
  color: #7a8a9c;
  font-size: 19rpx;
}

.station-contact-row > view text:last-child {
  margin-top: 4rpx;
  color: #1f3550;
  font-size: 26rpx;
  font-weight: 800;
}

.station-call-button {
  display: inline-flex;
  min-width: 148rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #1768cf;
  border: 1rpx solid #c5daf3;
  border-radius: 999rpx;
  background: #edf5ff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.station-call-button image {
  width: 28rpx;
  height: 28rpx;
}

.payment-card,
.pickup-card,
.timeline-card,
.result-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e1e7ee;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(25, 57, 94, .05);
}

.payment-head,
.pickup-card,
.result-card {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  align-items: start;
  gap: 13rpx;
}

.payment-icon,
.pickup-icon,
.result-icon {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #eaf3ff;
}

.payment-icon image,
.pickup-icon image,
.result-icon image {
  width: 33rpx;
  height: 33rpx;
}

.payment-head > view:last-child,
.pickup-card > view:last-child,
.result-card > view:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.payment-head > view:last-child text:first-child,
.pickup-card > view:last-child text:first-child,
.result-card > view:last-child text:first-child {
  color: #1d3c5d;
  font-size: 26rpx;
  font-weight: 800;
}

.payment-head > view:last-child text:last-child {
  margin-top: 5rpx;
  color: #7d91a8;
  font-size: 20rpx;
  line-height: 1.55;
}

.payment-card.payment-refunded { border-color: #d8e0e8; background: #fbfcfd; }
.payment-card.payment-unpaid,
.payment-card.payment-unknown { border-color: #ead8be; background: #fffdf9; }

.pay-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  color: #fff;
  border-radius: 15rpx;
  background: #1768cf;
  font-size: 25rpx;
  font-weight: 800;
}

.payment-summary-row {
  display: flex;
  min-height: 68rpx;
  margin-top: 17rpx;
  padding: 0 17rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 13rpx;
  background: #f3f7fc;
  color: #71849a;
  font-size: 20rpx;
}

.payment-summary-row text:last-child {
  color: #1768cf;
  font-size: 28rpx;
  font-weight: 850;
}

.payment-refund-row {
  display: flex;
  min-height: 58rpx;
  margin-top: 8rpx;
  padding: 0 17rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 13rpx;
  background: #edf8f3;
  color: #5b746b;
  font-size: 19rpx;
}

.payment-refund-row text:last-child {
  color: #16805c;
  font-size: 23rpx;
  font-weight: 800;
}
.precheck-owner-card { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #cfe2f5; border-radius: 21rpx; background: #f2f8ff; }
.precheck-owner-card.rejected { border-color: #efcac7; background: #fff5f4; }
.precheck-owner-card.approved { border-color: #bfe4d5; background: #f0fbf7; }
.precheck-owner-card.approved .precheck-owner-head>view text:first-child { color: #167555; }
.precheck-owner-head { display: flex; align-items: flex-start; gap: 13rpx; }.precheck-owner-head>image { width: 38rpx; height: 38rpx; flex: none; }.precheck-owner-head>view { display: flex; min-width: 0; flex-direction: column; }.precheck-owner-head>view text:first-child { color: #1d4269; font-size: 26rpx; font-weight: 800; }.precheck-owner-card.rejected .precheck-owner-head>view text:first-child { color: #a9433f; }.precheck-owner-head>view text:last-child { margin-top: 6rpx; color: #647b94; font-size: 20rpx; line-height: 1.55; }
.precheck-owner-meta { display: grid; margin-top: 14rpx; grid-template-columns: 120rpx minmax(0,1fr); gap: 13rpx; color: #71849a; font-size: 19rpx; line-height: 1.5; }.precheck-owner-meta text:last-child { color: #314c68; text-align: right; }.precheck-owner-note { display: block; margin-top: 15rpx; padding-top: 14rpx; color: #6e8196; border-top: 1rpx solid #dce9f6; font-size: 18rpx; line-height: 1.5; }
.precheck-refund-status { display: flex; min-height: 64rpx; margin-top: 16rpx; padding: 0 15rpx; align-items: center; justify-content: space-between; border-radius: 13rpx; color: #547064; background: #eaf7f1; font-size: 20rpx; }.precheck-refund-status text:last-child { color: #16805c; font-size: 25rpx; font-weight: 800; }.precheck-owner-card>button { width: 100%; min-height: 84rpx; margin-top: 16rpx; color: #1768cf; border: 1rpx solid #a9cbed; border-radius: 15rpx; background: #fff; font-size: 22rpx; font-weight: 800; }

.quote-breakdown {
  margin-top: 10rpx;
  padding: 5rpx 17rpx;
  border: 1rpx solid #e1e8f0;
  border-radius: 13rpx;
  background: #fff;
}

.quote-breakdown > view {
  display: flex;
  min-height: 60rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #71849a;
  border-bottom: 1rpx solid #edf1f5;
  font-size: 19rpx;
}

.quote-breakdown > view:last-child { border-bottom: 0; }
.quote-breakdown > view text:last-child { color: #304b67; font-weight: 750; }
.quote-breakdown .quote-total text { color: #1b4f83; font-weight: 850; }

.quote-route-card {
  display: flex;
  margin-top: 12rpx;
  padding: 15rpx 17rpx;
  flex-direction: column;
  gap: 7rpx;
  color: #607b94;
  border: 1rpx solid #cae0f3;
  border-radius: 13rpx;
  background: #f1f7fd;
  font-size: 17rpx;
  line-height: 1.5;
}

.quote-route-card > view { display: flex; align-items: center; gap: 8rpx; color: #285b87; font-size: 19rpx; font-weight: 800; }
.quote-route-card image { width: 25rpx; height: 25rpx; }
.quote-route-card > text:last-child { color: #426b8e; font-weight: 700; }

.quote-validity {
  display: grid;
  margin-top: 12rpx;
  padding: 13rpx 17rpx;
  gap: 9rpx;
  border: 1rpx solid #d8e3ee;
  border-radius: 13rpx;
  background: #f8fafc;
}

.quote-validity > view { display: grid; grid-template-columns: 158rpx minmax(0, 1fr); align-items: start; gap: 11rpx; }
.quote-validity text:first-child { color: #75889c; font-size: 17rpx; font-weight: 750; }
.quote-validity text:last-child { min-width: 0; color: #344f69; font-size: 17rpx; line-height: 1.45; text-align: right; word-break: break-all; }
.quote-validity.expired { border-color: #efc5c1; background: #fff5f4; }
.quote-validity.expired text:last-child { color: #b34b45; }

.price-change-notice {
  display: grid;
  margin-top: 12rpx;
  padding: 13rpx 15rpx;
  grid-template-columns: 26rpx minmax(0,1fr);
  align-items: start;
  gap: 9rpx;
  color: #8a5a2b;
  border-radius: 12rpx;
  background: #fff7e9;
  font-size: 17rpx;
  line-height: 1.55;
}

.price-change-notice image { width: 25rpx; height: 25rpx; }

.quote-expired-actions {
  display: grid;
  width: 100%;
  min-width: 0;
  margin-top: 13rpx;
  padding: 16rpx;
  grid-template-columns: minmax(0, 1fr) 188rpx;
  align-items: center;
  gap: 13rpx;
  border: 1rpx solid #efc7c3;
  border-radius: 14rpx;
  background: #fff6f5;
  box-sizing: border-box;
}

.quote-expired-actions > view { display: flex; min-width: 0; flex-direction: column; }
.quote-expired-actions > view text:first-child { color: #a8403b; font-size: 21rpx; font-weight: 850; }
.quote-expired-actions > view text:last-child { margin-top: 3rpx; color: #8a6966; font-size: 16rpx; line-height: 1.45; }
.quote-expired-actions button { width: 100%; min-width: 0; min-height: 88rpx; margin: 0; padding: 0 13rpx; color: #fff; border-radius: 13rpx; background: #1768cf; font-size: 19rpx; font-weight: 800; box-sizing: border-box; }
.quote-expired-actions button[disabled] { color: #9daab7; background: #dde5ed; }

.pay-button[disabled] {
  color: #9daab7;
  background: #dde5ed;
}

.mock-notice,
.payment-error {
  display: flex;
  margin-top: 13rpx;
  align-items: flex-start;
  justify-content: center;
  gap: 7rpx;
  color: #7d8fa3;
  font-size: 18rpx;
  line-height: 1.5;
}

.mock-notice image,
.payment-error image {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 auto;
}

.payment-error {
  padding: 13rpx 15rpx;
  justify-content: flex-start;
  color: #ba4242;
  border-radius: 11rpx;
  background: #fff0f0;
}

.pickup-card > view:last-child text:nth-child(2) {
  margin-top: 5rpx;
  color: #254b72;
  font-size: 24rpx;
  font-weight: 700;
}

.pickup-card > view:last-child text:last-child {
  margin-top: 4rpx;
  color: #7c8d9f;
  font-size: 20rpx;
  line-height: 1.45;
}

.section-title {
  display: flex;
  margin: 28rpx 4rpx 14rpx;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title > view {
  display: flex;
  flex-direction: column;
}

.section-title > view text:first-child {
  color: #1a2b41;
  font-size: 30rpx;
  font-weight: 800;
}

.section-title > view text:last-child,
.section-title > text {
  color: #8593a4;
  font-size: 19rpx;
}

.section-title > view text:last-child {
  margin-top: 3rpx;
}

.timeline-card {
  margin-top: 0;
  padding: 8rpx 24rpx;
}

.event {
  display: grid;
  min-height: 108rpx;
  padding: 18rpx 0;
  grid-template-columns: 34rpx minmax(0, 1fr);
  align-items: start;
  gap: 14rpx;
}

.event + .event {
  border-top: 1rpx solid #edf1f5;
}

.event-icon {
  width: 32rpx;
  height: 32rpx;
}

.event-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.event-copy text:first-child {
  color: #284d73;
  font-size: 24rpx;
  font-weight: 750;
}

.event-copy text:nth-child(2) {
  margin-top: 4rpx;
  color: #7c8ea2;
  font-size: 20rpx;
  line-height: 1.5;
}

.event-copy text:last-child {
  margin-top: 5rpx;
  color: #a0aab6;
  font-size: 18rpx;
}

.timeline-empty {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  color: #8190a2;
  font-size: 20rpx;
}

.timeline-empty image {
  width: 30rpx;
  height: 30rpx;
}

.result-card {
  color: #228259;
  border-color: #cbe5d9;
  background: #effaf4;
}

.result-card > view:last-child text:nth-child(2) {
  margin-top: 5rpx;
  color: #206c50;
  font-size: 27rpx;
  font-weight: 800;
}

.result-card > view:last-child text:last-child {
  margin-top: 5rpx;
  color: #5b8a77;
  font-size: 19rpx;
}

.checkup-report-entry {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 94rpx;
  margin-top: 11rpx;
  padding: 18rpx;
  align-items: flex-start;
  gap: 14rpx;
  color: #244866;
  border: 1rpx solid #cbdff3;
  border-radius: 18rpx;
  background: #f0f6fd;
  text-align: left;
  box-sizing: border-box;
}

.checkup-report-entry .entry-icon {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #fff;
}

.checkup-report-entry .entry-icon image { width: 31rpx; height: 31rpx; }
.entry-content { display: flex; width: 0; min-width: 0; flex: 1 1 auto; flex-direction: column; }
.entry-title-row { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 12rpx; }
.entry-title-row > text { color: #244866; font-size: 23rpx; font-weight: 800; line-height: 1.35; }
.entry-material-groups { display: flex; width: 100%; min-width: 0; margin-top: 10rpx; overflow: hidden; flex-direction: column; border: 1rpx solid rgba(203,223,243,.72); border-radius: 12rpx; background: rgba(255,255,255,.76); box-sizing: border-box; }
.entry-material-groups > view { display: flex; min-width: 0; padding: 11rpx 12rpx; align-items: stretch; flex-direction: column; gap: 4rpx; }
.entry-material-groups > view + view { border-top: 1rpx solid #e2ebf4; }
.entry-material-groups > view > text:first-child { color: #346992; font-size: 17rpx; font-weight: 800; line-height: 1.35; }
.entry-material-groups > view > text:last-child { color: #71869a; font-size: 17rpx; line-height: 1.5; overflow-wrap: anywhere; }
.entry-material-groups > view.missing { background: #fff7f1; }
.entry-material-groups > view.missing > text:first-child, .entry-material-groups > view.missing > text:last-child { color: #a66a46; }
.entry-report-boundary { margin-top: 9rpx; color: #8798a7; font-size: 16rpx; line-height: 1.45; }
.checkup-report-entry .entry-caret { width: 26rpx; height: 26rpx; flex: 0 0 auto; opacity: .58; }

.media-strip {
  width: calc(100vw - 48rpx);
  white-space: nowrap;
}

.media-list {
  display: inline-flex;
  gap: 12rpx;
}

.media-item {
  position: relative;
  width: 214rpx;
  height: 166rpx;
  overflow: hidden;
  border-radius: 15rpx;
  background: #eaf0f6;
}

.media-item > image {
  width: 100%;
  height: 100%;
}

.media-item > view {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  display: flex;
  padding: 5rpx 9rpx;
  align-items: center;
  gap: 5rpx;
  color: #fff;
  border-radius: 8rpx;
  background: rgba(20, 34, 51, .62);
  font-size: 16rpx;
}

.media-item > view image {
  width: 20rpx;
  height: 20rpx;
  padding: 3rpx;
  border-radius: 50%;
  background: #fff;
  box-sizing: border-box;
}

.media-item-state {
  display: flex;
  margin: 0;
  padding: 18rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #74889c;
  border: 1rpx dashed #c9d7e5;
  font-size: 18rpx;
  box-sizing: border-box;
}

.media-item-state > image { width: 38rpx; height: 38rpx; opacity: .72; }
.media-item-retry { color: #1768cf; background: #f2f7fd; }
.media-item-retry text:last-child { font-size: 16rpx; }
.media-item-retry::after { border: 0; }

.cancel-button {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin-top: 28rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  color: #c64848;
  border: 1rpx solid #efc9c9;
  border-radius: 15rpx;
  background: #fff;
  font-size: 23rpx;
  font-weight: 750;
}

.cancel-button image {
  width: 28rpx;
  height: 28rpx;
}

.cancel-button[disabled] { color: #9da8b4; border-color: #dfe4e9; background: #f2f4f6; }

.order-assurance {
  display: flex;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  align-items: flex-start;
  gap: 8rpx;
  color: #718398;
  border-radius: 14rpx;
  background: #edf5ff;
  font-size: 18rpx;
  line-height: 1.5;
}

.order-assurance image {
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 auto;
}

.evidence-title { margin-top: 30rpx; }
.evidence-stage-list { display: flex; flex-direction: column; gap: 14rpx; }
.evidence-stage { padding: 22rpx; border: 1rpx solid #dfe8f2; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(25, 57, 94, .045); }
.evidence-stage.evidence-complete { border-color: #bdd8f2; background: #fbfdff; }
.evidence-stage-head { display: grid; grid-template-columns: 48rpx minmax(0, 1fr) auto; align-items: center; gap: 12rpx; }
.evidence-number { display: flex; width: 46rpx; height: 46rpx; align-items: center; justify-content: center; color: #1768cf; border-radius: 14rpx; background: #eaf3ff; font-size: 18rpx; font-weight: 850; }
.evidence-stage-head > view:nth-child(2) { display: flex; min-width: 0; flex-direction: column; }
.evidence-stage-head > view:nth-child(2) text:first-child { color: #1e3853; font-size: 24rpx; font-weight: 800; }
.evidence-stage-head > view:nth-child(2) text:last-child { margin-top: 3rpx; overflow: hidden; color: #7e8fa1; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.evidence-badge { display: flex; align-items: flex-end; flex-direction: column; }
.evidence-badge text:first-child { color: #1768cf; font-size: 23rpx; font-weight: 850; }
.evidence-badge text:last-child { margin-top: 2rpx; color: #8291a1; font-size: 16rpx; }
.evidence-complete .evidence-badge text:last-child { color: #20815d; }
.evidence-meta { display: flex; margin-top: 15rpx; padding-top: 13rpx; align-items: center; justify-content: space-between; gap: 15rpx; color: #8291a1; border-top: 1rpx solid #ebf0f5; font-size: 17rpx; }
.evidence-meta text:last-child { min-width: 0; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.evidence-photo-scroll { width: calc(100% + 22rpx); margin-top: 14rpx; margin-right: -22rpx; white-space: nowrap; }
.evidence-photo-list { display: inline-flex; padding-right: 22rpx; gap: 10rpx; }
.evidence-photo-item { display: flex; width: 152rpx; min-width: 152rpx; flex-direction: column; }
.evidence-photo-button,
.evidence-photo-placeholder { display: flex; width: 152rpx; height: 110rpx; margin: 0; padding: 0; overflow: hidden; align-items: center; justify-content: center; border-radius: 13rpx; background: #edf2f7; box-sizing: border-box; }
.evidence-photo-button::after,
.evidence-photo-retry::after { border: 0; }
.evidence-photo-button image { width: 100%; height: 100%; }
.evidence-photo-placeholder { flex-direction: column; gap: 6rpx; color: #7b8da1; border: 1rpx dashed #c9d6e3; font-size: 16rpx; }
.evidence-photo-placeholder image { width: 30rpx; height: 30rpx; opacity: .72; }
.evidence-photo-retry { color: #1768cf; background: #f1f7ff; }
.evidence-photo-label { margin-top: 6rpx; overflow: hidden; color: #65798f; font-size: 17rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.evidence-pending-copy { display: flex; margin-top: 15rpx; padding: 13rpx 15rpx; align-items: flex-start; gap: 8rpx; color: #7c8c9e; border-radius: 13rpx; background: #f4f7fa; font-size: 17rpx; line-height: 1.5; }
.evidence-pending-copy image { width: 24rpx; height: 24rpx; flex: 0 0 auto; opacity: .7; }
.legacy-evidence-card { display: grid; padding: 22rpx; grid-template-columns: 40rpx minmax(0, 1fr); align-items: start; gap: 12rpx; color: #76879a; border: 1rpx solid #dde5ed; border-radius: 20rpx; background: #fff; }
.legacy-evidence-card > image { width: 38rpx; height: 38rpx; opacity: .7; }
.legacy-evidence-card > view { display: flex; flex-direction: column; }
.legacy-evidence-card text:first-child { color: #354b62; font-size: 22rpx; font-weight: 780; }
.legacy-evidence-card text:last-child { margin-top: 5rpx; font-size: 18rpx; line-height: 1.5; }

.evidence-image-viewer { position: fixed; z-index: 80; inset: 0; display: flex; padding: calc(22rpx + env(safe-area-inset-top)) 26rpx calc(22rpx + env(safe-area-inset-bottom)); align-items: center; justify-content: center; box-sizing: border-box; }
.evidence-image-viewer-mask { position: absolute; inset: 0; background: rgba(17, 28, 42, .58); }
.evidence-image-viewer-dialog { position: relative; z-index: 1; display: flex; width: 100%; height: 82vh; max-width: 680rpx; max-height: 960rpx; min-height: 0; overflow: hidden; flex-direction: column; border-radius: 24rpx; background: #fff; box-shadow: 0 26rpx 70rpx rgba(11, 26, 44, .28); }
.evidence-image-viewer-head { display: flex; min-height: 88rpx; padding: 16rpx 18rpx 14rpx 22rpx; align-items: center; justify-content: space-between; gap: 14rpx; border-bottom: 1rpx solid #e8edf3; }
.evidence-image-viewer-head > view { display: flex; min-width: 0; flex-direction: column; }
.evidence-image-viewer-head > view text:first-child { color: #17344f; font-size: 24rpx; font-weight: 850; }
.evidence-image-viewer-head > view text:last-child { margin-top: 3rpx; overflow: hidden; color: #71859a; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.evidence-image-viewer-head button { display: flex; width: 104rpx; min-width: 104rpx; max-width: 104rpx; min-height: 88rpx; margin: 0; padding: 0; flex: 0 0 104rpx; align-items: center; justify-content: center; color: #1768cf; border-radius: 11rpx; background: #edf5ff; font-size: 18rpx; line-height: 1; }
.evidence-image-viewer-stage { display: flex; height: 0; min-height: 0; padding: 20rpx; align-items: center; justify-content: center; flex: 1 1 auto; background: #eef3f8; }
.evidence-image-viewer-stage image { width: 100%; height: 100%; border-radius: 14rpx; }
.evidence-image-viewer-controls { display: grid; width: 100%; min-width: 0; min-height: 84rpx; padding: 13rpx 16rpx; flex: 0 0 auto; grid-template-columns: minmax(0, 1fr) minmax(80rpx, 104rpx) minmax(0, 1fr); align-items: center; gap: 10rpx; box-sizing: border-box; }
.evidence-image-viewer-controls button { display: flex; width: 100%; min-width: 0; min-height: 88rpx; margin: 0; padding: 0 8rpx; overflow: hidden; align-items: center; justify-content: center; gap: 5rpx; color: #1768cf; border-radius: 12rpx; background: #edf5ff; font-size: 18rpx; box-sizing: border-box; }
.evidence-image-viewer-controls button:last-child { flex-direction: row-reverse; }
.evidence-image-viewer-controls button[disabled] { color: #a5b0bc; background: #f1f3f5; }
.evidence-image-viewer-controls button text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.evidence-image-viewer-controls button:first-child text:first-child,
.evidence-image-viewer-controls button:last-child text:last-child { flex: 0 0 auto; font-size: 28rpx; line-height: 1; }
.evidence-image-viewer-controls > view { display: flex; width: 100%; min-width: 0; align-items: center; flex-direction: column; }
.evidence-image-viewer-controls > view text:first-child { color: #284660; font-size: 20rpx; font-weight: 800; }
.evidence-image-viewer-controls > view text:last-child { margin-top: 2rpx; color: #8896a5; font-size: 14rpx; }
