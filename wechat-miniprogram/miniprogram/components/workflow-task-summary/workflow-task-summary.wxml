<button class="workflow-summary {{overdueCount > 0 ? 'has-overdue' : (dueSoonCount > 0 ? 'has-attention' : '')}}" bindtap="open" disabled="{{loading}}" aria-label="{{title}}，{{openCount}}项待处理，{{dueSoonCount}}项即将超时，{{overdueCount}}项已超时">
  <view class="summary-head"><view><image src="/assets/icons/clock.png" mode="aspectFit"/><text>{{title}}</text></view><view><text>{{loading ? '同步中' : actionText}}</text><image src="/assets/icons/caret-right.png" mode="aspectFit"/></view></view>
  <view class="summary-metrics">
    <view><text>{{openCount}}</text><text>待处理</text></view>
    <view><text>{{dueSoonCount}}</text><text>即将超时</text></view>
    <view><text>{{overdueCount}}</text><text>已超时</text></view>
  </view>
  <view wx:if="{{nextDueLabel}}" class="next-due"><text>最近截止</text><text>{{nextDueLabel}}</text></view>
</button>
