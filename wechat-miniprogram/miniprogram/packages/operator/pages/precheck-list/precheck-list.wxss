.precheck-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  background: #f4f8fc;
  box-sizing: border-box;
}

.precheck-hero {
  padding: 32rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #075cc6, #2788f0);
  box-shadow: 0 16rpx 34rpx rgba(14, 101, 210, .2);
}

.precheck-hero text { display: block; }
.precheck-hero text:first-child { opacity: .76; font-size: 18rpx; letter-spacing: 4rpx; }
.precheck-hero text:nth-child(2) { margin-top: 10rpx; font-size: 38rpx; font-weight: 800; }
.precheck-hero text:last-child { margin-top: 12rpx; opacity: .9; font-size: 23rpx; line-height: 1.55; }

.precheck-tabs {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 8rpx;
}

.precheck-tabs button {
  flex: 1;
  min-height: 72rpx;
  margin: 0;
  padding: 0 8rpx;
  color: #5d7188;
  border-radius: 16rpx;
  background: #fff;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 72rpx;
}

.precheck-tabs .selected {
  color: #fff;
  background: #1768cf;
}

.precheck-list { margin-top: 18rpx; }

.precheck-card {
  display: block;
  width: 100%;
  margin-bottom: 22rpx;
  padding: 28rpx 28rpx 22rpx;
  text-align: left;
  border: 1rpx solid #dfe9f4;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(26, 63, 104, .06);
  box-sizing: border-box;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.plate-block {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.plate {
  color: #12263c;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: .04em;
  line-height: 1.15;
  word-break: keep-all;
  white-space: nowrap;
}

.mode {
  color: #66788d;
  font-size: 22rpx;
  line-height: 1.3;
}

.sla {
  flex: none;
  max-width: 220rpx;
  padding: 10rpx 14rpx;
  color: #1768cf;
  border-radius: 999rpx;
  background: #eaf3ff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.sla.reminder { color: #b65b12; background: #fff2df; }
.sla.overdue { color: #bd3e3e; background: #ffeded; }

.meta-grid {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.meta-item {
  min-width: 0;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 18rpx;
  background: #f5f9fe;
  box-sizing: border-box;
}

.meta-item.released {
  background: #fff7ef;
}

.meta-label {
  display: block;
  color: #6d8096;
  font-size: 20rpx;
  line-height: 1.3;
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  color: #173048;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.35;
  word-break: break-all;
}

.meta-sub {
  display: block;
  margin-top: 4rpx;
  color: #41576f;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.3;
}

.supervision-block {
  margin-top: 18rpx;
  padding: 18rpx 18rpx 14rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e8eef5;
}

.supervision-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.supervision-title {
  color: #23405a;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.35;
  text-align: right;
}

.supervision-lines {
  display: flex;
  margin-top: 14rpx;
  flex-direction: column;
  gap: 10rpx;
}

.supervision-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.supervision-line text:first-child {
  flex: none;
  width: 120rpx;
  color: #6d8096;
  font-size: 22rpx;
  line-height: 1.4;
}

.supervision-line text:last-child {
  flex: 1;
  color: #1d334b;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.4;
  text-align: right;
}

.photo-progress {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f5f9fe;
}

.photo-progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #40526a;
  font-size: 22rpx;
}

.photo-progress-head text:last-child {
  color: #1768cf;
  font-weight: 800;
}

.photo-progress-track {
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: #dce9f7;
}

.photo-progress-track view {
  height: 100%;
  border-radius: 99rpx;
  background: #1768cf;
}

.card-action {
  display: flex;
  min-height: 72rpx;
  margin-top: 8rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: #1768cf;
  font-size: 24rpx;
  font-weight: 750;
}

.card-action image {
  width: 24rpx;
  height: 24rpx;
}

.state-card {
  display: flex;
  min-height: 300rpx;
  margin-top: 22rpx;
  padding: 30rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #708096;
  border: 1rpx solid #e0e9f2;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
  box-sizing: border-box;
}

.state-card image { width: 66rpx; height: 66rpx; }
.state-card text:nth-child(2) { margin-top: 14rpx; color: #26394f; font-size: 28rpx; font-weight: 800; }
.state-card text:nth-child(3) { margin-top: 8rpx; font-size: 20rpx; }
.state-card button {
  min-width: 220rpx;
  min-height: 88rpx;
  margin-top: 20rpx;
  color: #fff;
  border-radius: 16rpx;
  background: #1768cf;
}

.inline-error {
  margin-bottom: 16rpx;
  padding: 16rpx;
  color: #a04a42;
  border-radius: 14rpx;
  background: #fff0ef;
  font-size: 20rpx;
  line-height: 1.5;
}
