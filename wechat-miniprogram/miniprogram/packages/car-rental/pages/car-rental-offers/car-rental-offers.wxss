.offers-page { min-height: 100vh; padding: 18rpx 22rpx 50rpx; color: #18263b; background: #f4f7fb; box-sizing: border-box; }
.trip-summary { padding: 20rpx 22rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(120deg,#0f62c9,#258be0); box-shadow: 0 10rpx 24rpx rgba(20,89,166,.18); }
.trip-top { display: flex; align-items: center; justify-content: space-between; }
.trip-top > view { display: flex; min-width: 0; align-items: center; gap: 8rpx; font-size: 25rpx; font-weight: 800; }
.trip-top image { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); }
.trip-top button { padding: 9rpx 14rpx; color: #fff; border: 1rpx solid rgba(255,255,255,.5); border-radius: 999rpx; font-size: 19rpx; }
.trip-time { display: grid; margin-top: 16rpx; grid-template-columns: 1fr 64rpx 1fr; align-items: center; gap: 8rpx; }
.trip-time > view:not(.trip-days) { display: flex; min-width: 0; flex-direction: column; font-size: 20rpx; }
.trip-time > view:not(.trip-days) text:first-child { width: 30rpx; color: #1768d4; border-radius: 7rpx; background: #fff; text-align: center; font-weight: 800; }
.trip-time > view:not(.trip-days) text:last-child { margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trip-time > view:last-child { align-items: flex-end; }
.trip-days { padding: 5rpx; color: #dcebff; border-top: 1rpx solid rgba(255,255,255,.45); font-size: 18rpx; text-align: center; }
.filter-bar { display: grid; position: sticky; z-index: 8; top: 0; margin: 16rpx -22rpx 0; padding: 0 22rpx; grid-template-columns: 1fr .8fr 1fr; border-bottom: 1rpx solid #e7ebf1; background: rgba(255,255,255,.96); }
.filter-bar button { display: flex; min-width: 0; min-height: 76rpx; align-items: center; justify-content: center; gap: 5rpx; overflow: hidden; color: #58677b; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.filter-bar button.active { color: #1768d4; font-weight: 800; }
.filter-bar image { width: 16rpx; height: 16rpx; }
.result-head { display: flex; margin: 24rpx 2rpx 15rpx; align-items: flex-end; justify-content: space-between; }
.result-head > view { display: flex; flex-direction: column; }
.result-head > view text:first-child { font-size: 31rpx; font-weight: 900; }
.result-head > view text:last-child,.result-head > text { color: #8c98a7; font-size: 18rpx; }
.car-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 15rpx; }
.car-card { min-width: 0; overflow: hidden; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(25,54,89,.07); text-align: left; }
.image-shell { position: relative; height: 220rpx; overflow: hidden; background: #edf2f7; }
.image-shell > image { width: 100%; height: 100%; }
.exact-badge,.stock-badge { position: absolute; padding: 6rpx 9rpx; color: #fff; border-radius: 7rpx; font-size: 16rpx; }
.exact-badge { top: 10rpx; left: 10rpx; background: rgba(23,104,212,.92); }
.stock-badge { right: 9rpx; bottom: 9rpx; background: rgba(17,30,48,.62); }
.car-copy { padding: 14rpx 14rpx 16rpx; }
.brand-name { display: block; color: #7f8b9b; font-size: 17rpx; }
.model-name { display: block; min-height: 56rpx; margin-top: 3rpx; overflow: hidden; font-size: 25rpx; font-weight: 900; line-height: 1.2; }
.car-meta { display: block; margin-top: 7rpx; overflow: hidden; color: #6f7c8e; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.car-tag { display: flex; height: 31rpx; margin-top: 8rpx; gap: 6rpx; overflow: hidden; }
.car-tag text { padding: 3rpx 7rpx; color: #1768d4; border-radius: 5rpx; background: #eaf3ff; font-size: 15rpx; white-space: nowrap; }
.price-row { display: flex; margin-top: 10rpx; align-items: flex-end; justify-content: space-between; }
.price-row > view { color: #ef6724; }
.price-row > view text:first-child { font-size: 29rpx; font-weight: 900; }
.price-row > view text:last-child { font-size: 14rpx; }
.price-row > text { color: #5f6e81; font-size: 16rpx; }
.price-note { display: block; margin-top: 3rpx; color: #98a2af; font-size: 14rpx; }
.data-note { padding: 28rpx 0 2rpx; color: #9aa4b1; font-size: 18rpx; text-align: center; }
.car-skeleton view { height: 220rpx; border-radius: 18rpx; background: #e8edf3; animation: pulse 1.2s ease-in-out infinite alternate; }
.car-skeleton text { display: block; height: 28rpx; margin-top: 12rpx; border-radius: 6rpx; background: #e8edf3; }
.car-skeleton text:last-child { width: 64%; }
.state-card { display: flex; margin-top: 54rpx; padding: 54rpx 24rpx; align-items: center; flex-direction: column; border-radius: 22rpx; background: #fff; }
.state-card > image { width: 66rpx; height: 66rpx; }
.state-title { margin-top: 16rpx; font-size: 28rpx; font-weight: 900; }
.state-copy { margin-top: 7rpx; color: #8793a3; font-size: 21rpx; text-align: center; }
.state-card > view { display: flex; margin-top: 22rpx; gap: 10rpx; }
.state-card button { margin-top: 22rpx; padding: 14rpx 24rpx; color: #fff; border-radius: 12rpx; background: #1768d4; font-size: 22rpx; }
.state-card > view button { margin-top: 0; }
.state-card > view button:first-child { color: #1768d4; background: #eaf3ff; }
.brand-overlay { position: fixed; z-index: 40; inset: 0; display: flex; align-items: flex-end; background: rgba(13,27,45,.42); }
.brand-panel { position: relative; width: 100%; height: 88vh; padding: 24rpx 76rpx 0 24rpx; border-radius: 28rpx 28rpx 0 0; background: #fff; box-sizing: border-box; }
.panel-head { display: flex; align-items: center; justify-content: space-between; }
.panel-head > text { font-size: 32rpx; font-weight: 900; }
.panel-head button image { width: 34rpx; height: 34rpx; }
.brand-search { display: flex; height: 68rpx; margin-top: 18rpx; padding: 0 14rpx; align-items: center; gap: 10rpx; border-radius: 13rpx; background: #f2f5f8; }
.brand-search image { width: 29rpx; height: 29rpx; }
.brand-search input { flex: 1; font-size: 22rpx; }
.brand-search button { color: #1768d4; font-size: 20rpx; }
.all-brand { display: flex; width: 100%; padding: 20rpx 4rpx; justify-content: space-between; border-bottom: 1rpx solid #edf0f4; font-size: 24rpx; font-weight: 800; }
.all-brand text { color: #8d98a7; font-size: 18rpx; font-weight: 400; }
.brand-section-title { display: block; margin-top: 17rpx; color: #758296; font-size: 20rpx; font-weight: 800; }
.hot-brands > view { display: grid; margin-top: 9rpx; grid-template-columns: repeat(5,1fr); gap: 7rpx; }
.hot-brands button { display: flex; min-width: 0; align-items: center; flex-direction: column; font-size: 18rpx; }
.hot-brands image { width: 66rpx; height: 52rpx; }
.brand-scroll { height: calc(88vh - 340rpx); margin-top: 14rpx; }
.initial { display: block; margin-left: -24rpx; padding: 7rpx 28rpx; color: #8692a2; background: #f4f6f9; font-size: 19rpx; }
.brand-group > button { display: grid; width: 100%; min-height: 86rpx; grid-template-columns: 68rpx minmax(0,1fr) auto 20rpx; align-items: center; gap: 10rpx; border-bottom: 1rpx solid #edf0f4; text-align: left; }
.brand-group > button image:first-child { width: 64rpx; height: 54rpx; }
.brand-group > button image:last-child { width: 18rpx; height: 18rpx; }
.brand-group > button text:nth-child(2) { font-size: 23rpx; font-weight: 700; }
.brand-group > button text:nth-child(3) { color: #929dab; font-size: 18rpx; }
.alphabet { position: absolute; top: 250rpx; right: 0; display: flex; width: 72rpx; align-items: center; flex-direction: column; }
.alphabet button { width: 72rpx; min-height: 48rpx; color: #7f8b9b; font-size: 16rpx; }
.brand-empty { padding: 70rpx 20rpx; color: #8d98a7; text-align: center; }
@keyframes pulse { from { opacity:.58; } to { opacity:1; } }
