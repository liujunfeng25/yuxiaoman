.state-card > image { width: 42rpx; height: 42rpx; }
.state-card button { min-width: 176rpx; min-height: 64rpx; margin-top: 10rpx; border: 2rpx solid #bdd8f4; border-radius: 16rpx; color: #1768cf; background: #eef6ff; font-size: 22rpx; font-weight: 750; }
.error-state { color: #ac4053; border-color: #efc7ce; background: #fff8f9; }
.demo-notice { display: flex; margin-bottom: 22rpx; padding: 19rpx 20rpx; align-items: flex-start; gap: 13rpx; border: 2rpx solid #f0cf9e; border-radius: 20rpx; color: #8c622d; background: #fff9ef; }
