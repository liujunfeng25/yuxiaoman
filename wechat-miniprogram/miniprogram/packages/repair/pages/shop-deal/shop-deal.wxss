.shop-deal-page { padding-top: 16rpx; padding-bottom: calc(58rpx + env(safe-area-inset-bottom)); background: #f6f9fc; }
.deal-loading { min-height: 430rpx; }
.demo-line { display: flex; min-height: 46rpx; margin: 0 3rpx 8rpx; align-items: center; justify-content: flex-end; gap: 7rpx; color: #6e7e91; font-size: 19rpx; }
.demo-line image { width: 25rpx; height: 25rpx; }

.deal-hero { display: flex; padding: 29rpx 25rpx 27rpx; align-items: center; flex-direction: column; border: 1rpx solid #c5e5d7; border-radius: 29rpx; background: #f0faf6; }
.deal-check { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(20, 128, 91, .09); }
.deal-check image { width: 47rpx; height: 47rpx; }
.deal-hero > text:nth-child(2) { margin-top: 12rpx; color: #147d59; font-size: 27rpx; font-weight: 850; }
.deal-hero > text:nth-child(3) { margin-top: 4rpx; color: #405d53; font-size: 20rpx; }
.deal-price { display: flex; margin-top: 7rpx; align-items: baseline; color: #eb6508; }
.deal-price text:first-child { font-size: 27rpx; font-weight: 850; }
.deal-price text:last-child { font-size: 55rpx; font-weight: 850; letter-spacing: -1rpx; }
.deal-hero > text:last-child { color: #6c887d; font-size: 17rpx; }

.contact-card { margin-top: 16rpx; padding: 23rpx 23rpx 0; border: 2rpx solid #1677ff; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(22, 119, 255, .08); }
.contact-heading { display: flex; padding-bottom: 16rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e8edf3; }
.contact-heading > view { display: flex; align-items: center; gap: 9rpx; }
.contact-heading image { width: 34rpx; height: 34rpx; }
.contact-heading > view text { color: #1d314b; font-size: 24rpx; font-weight: 850; }
.contact-heading > text { padding: 5rpx 9rpx; color: #1677ff; border-radius: 9rpx; background: #eaf3ff; font-size: 16rpx; }
.contact-row { display: grid; min-height: 78rpx; grid-template-columns: 130rpx minmax(0, 1fr); align-items: center; border-bottom: 1rpx solid #edf1f5; }
.contact-row text:first-child { color: #788698; font-size: 19rpx; }
.contact-row text:last-child { color: #172b44; font-size: 24rpx; font-weight: 800; letter-spacing: .5rpx; }
.contact-card > button { display: flex; width: 100%; min-height: 79rpx; align-items: center; justify-content: center; gap: 8rpx; color: #1677ff; font-size: 21rpx; font-weight: 800; }
.contact-card > button image { width: 30rpx; height: 30rpx; }
.contact-note { display: grid; margin: 0 -23rpx; padding: 15rpx 20rpx; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 8rpx; color: #667c94; border-radius: 0 0 24rpx 24rpx; background: #edf5ff; font-size: 17rpx; line-height: 1.45; }
.contact-note image { width: 26rpx; height: 26rpx; }

.quote-summary { margin-top: 16rpx; padding: 21rpx 22rpx; border: 1rpx solid #dfe7f0; border-radius: 23rpx; background: #fff; }
.summary-heading { display: flex; align-items: center; gap: 8rpx; }
.summary-heading image { width: 31rpx; height: 31rpx; }
.summary-heading text:nth-child(2) { color: #263a53; font-size: 22rpx; font-weight: 850; }
.summary-heading text:last-child { margin-left: auto; color: #8290a2; font-size: 17rpx; }
.quote-summary > text { display: block; margin-top: 12rpx; color: #51657d; font-size: 19rpx; line-height: 1.5; }
.quote-summary > view:last-child { display: flex; margin-top: 14rpx; padding-top: 13rpx; align-items: center; justify-content: space-between; border-top: 1rpx solid #e9eef3; }
.quote-summary > view:last-child text:first-child { overflow: hidden; color: #65758a; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.quote-summary > view:last-child text:last-child { color: #eb6508; font-size: 27rpx; font-weight: 850; }

.next-heading { display: flex; margin: 30rpx 2rpx 14rpx; align-items: baseline; justify-content: space-between; }
.next-heading text:first-child { color: #111e31; font-size: 30rpx; font-weight: 850; }
.next-heading text:last-child { color: #7c899a; font-size: 17rpx; }
.boundary-list { overflow: hidden; border: 1rpx solid #e0e7ef; border-radius: 24rpx; background: #fff; }
.boundary-list > view { display: grid; min-height: 111rpx; padding: 18rpx 21rpx; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 14rpx; }
.boundary-list > view + view { border-top: 1rpx solid #e9eef3; }
.boundary-list > view > image { width: 39rpx; height: 39rpx; }
.boundary-list > view > view { display: flex; flex-direction: column; }
.boundary-list > view > view text:first-child { color: #263a52; font-size: 21rpx; font-weight: 800; }
.boundary-list > view > view text:last-child { margin-top: 4rpx; color: #738298; font-size: 18rpx; line-height: 1.45; }
.platform-boundary { display: grid; margin-top: 15rpx; padding: 20rpx 21rpx; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 11rpx; border: 1rpx solid #f0d0a9; border-radius: 20rpx; background: #fff7ed; }
.platform-boundary > image { width: 34rpx; height: 34rpx; }
.platform-boundary > view { display: flex; flex-direction: column; }
.platform-boundary text:first-child { color: #9f561b; font-size: 21rpx; font-weight: 850; }
.platform-boundary text:last-child { margin-top: 4rpx; color: #866b55; font-size: 18rpx; line-height: 1.5; }
.hall-button { display: grid; width: 100%; min-height: 82rpx; margin-top: 16rpx; padding: 0 18rpx; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 9rpx; color: #1677ff; border: 1rpx solid #cfe0f4; border-radius: 19rpx; background: #fff; text-align: left; font-size: 21rpx; font-weight: 800; }
.hall-button image:first-child { width: 32rpx; height: 32rpx; }
.hall-button image:last-child { width: 24rpx; height: 24rpx; }

.locked-card { display: flex; min-height: 480rpx; margin-top: 80rpx; padding: 42rpx 31rpx; align-items: center; justify-content: center; flex-direction: column; border: 1rpx solid #e0e7ef; border-radius: 28rpx; background: #fff; text-align: center; }
.locked-icon { display: flex; width: 90rpx; height: 90rpx; align-items: center; justify-content: center; border-radius: 27rpx; background: #edf5ff; }
.locked-icon image { width: 51rpx; height: 51rpx; }
.locked-card > text:nth-child(2) { margin-top: 18rpx; color: #1d3049; font-size: 29rpx; font-weight: 850; }
.locked-card > text:nth-child(3) { max-width: 560rpx; margin-top: 8rpx; color: #748398; font-size: 20rpx; line-height: 1.55; }
.locked-summary { display: flex; width: 100%; min-height: 76rpx; margin-top: 21rpx; padding: 0 18rpx; align-items: center; justify-content: space-between; border-radius: 16rpx; background: #f4f8fc; box-sizing: border-box; }
.locked-summary text:first-child { color: #2d425b; font-size: 21rpx; font-weight: 800; }
.locked-summary text:last-child { color: #718196; font-size: 18rpx; }
.locked-error { margin-top: 13rpx; color: #aa583e; font-size: 18rpx; }
.locked-actions { display: grid; width: 100%; margin-top: 22rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11rpx; }
.locked-actions button { width: 100%; min-width: 0; min-height: 76rpx; margin: 0; padding: 0 12rpx; color: #1677ff; border: 1rpx solid #cfe0f4; border-radius: 17rpx; background: #f7fbff; font-size: 20rpx; font-weight: 800; line-height: 1.25; box-sizing: border-box; }
.locked-actions button.primary { color: #fff; border-color: #1677ff; background: #1677ff; }
.locked-actions button:only-child { grid-column: 1 / 3; }

@media (max-width: 340px) {
  .shop-deal-page { padding-right: 22rpx; padding-left: 22rpx; }
  .next-heading text:last-child { display: none; }
}
