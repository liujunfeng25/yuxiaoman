VITE_API_BASE_URL=http://127.0.0.1:8787/api
# 服务商后台地图扎针使用独立的腾讯 JavaScript API GL Web Key。
# 该 Key 会进入浏览器构建，必须在腾讯位置服务控制台限制允许域名；不要复用服务端 WebService Key。
VITE_TENCENT_MAP_WEB_KEY=
PORT=8787
HOST=127.0.0.1
# 默认不信任代理转发头。仅当应用确实位于受控反向代理后时，填写 loopback、
# 明确代理 IP 或逗号分隔 CIDR（例如 loopback,10.8.0.0/16）；禁止 true/全网段。
TRUST_PROXY=false
# PostgreSQL is the only supported application database. Use a dedicated
# database/user in production and require TLS through the managed service.
DATABASE_URL=postgresql://yuxiaoman:change-me@127.0.0.1:5432/yuxiaoman
TEST_DATABASE_URL=postgresql://yuxiaoman:change-me@127.0.0.1:5432/yuxiaoman_test
YUXIAOMAN_DB_SCHEMA=public
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000

# Web development can keep the current invisible demo identity. Production
# ignores this fallback and requires a valid server-issued bearer session.
YUXIAOMAN_ALLOW_DEMO_AUTH_FALLBACK=false
# Local development only: allow the admin UI to set service-account passwords directly.
# Production always ignores this flag and requires one-time activation links.
YUXIAOMAN_ALLOW_DIRECT_BACKOFFICE_PASSWORD=false
# Optional non-production endpoint for issuing a development Bearer session.
YUXIAOMAN_ENABLE_DEVELOPMENT_AUTH=false
# 原生小程序无感登录仅在服务端使用这两项调用微信 code2Session。
# AppSecret 不得写入小程序代码、前端构建变量、日志或接口响应；此模板不填写真实值。
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
YUXIAOMAN_UPLOAD_DIR=data/uploads
# 本地开发使用模拟支付；生产环境默认拒绝模拟支付。
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENT=false
# 写入型演示履约接口必须显式开启；数据重置单独受更严格开关保护。
ALLOW_DEMO_WORKFLOW=false
ALLOW_DEMO_RESET=false
# 只有腾讯真实驾车矩阵成功时才允许生成上门往返取送报价。
# Key 缺失、无权限、超时或额度不足会阻止取送下单，不会用估算距离替代。
TENCENT_MAP_KEY=

# 运营后台统一使用独立实名账号和 HttpOnly、SameSite=Strict Cookie，
# 生产环境还会强制 Secure；会话不复用车主身份。
# 生产环境必须列出允许访问后台的 HTTPS Origin（逗号分隔）；未配置时后台请求会 fail closed。
BACKOFFICE_ALLOWED_ORIGINS=https://admin.example.com
# 一次性邀请/重置链接的后台公开地址；链接 24 小时有效且只展示一次。
BACKOFFICE_ACTIVATION_BASE_URL=https://admin.example.com/activate
# 用于审计日志中 IP 的不可逆摘要；生产环境设置独立高熵值并妥善保管。
BACKOFFICE_AUDIT_IP_SALT=
# 首个平台管理员仅通过 `npm run backoffice:create-admin -- --login <登录名> --display-name <姓名>` 创建。
# 执行时临时注入 12 位以上 BACKOFFICE_ADMIN_PASSWORD，不要把真实密码写进环境文件或镜像。
# 测试环境只有同时满足 NODE_ENV=test 和显式开关时才会生成测试平台会话；生产环境始终忽略。
YUXIAOMAN_ALLOW_BACKOFFICE_TEST_FALLBACK=false

# 代驾端 6 位任务验证码仅以 HMAC 和 AES-256-GCM 密文落库。生产环境必须配置
# 两把相互独立的密钥；缺少或格式错误时，安排司机/验证码兑换会 fail closed。
# DATA_KEY 为 32 字节（64 位十六进制或 Base64）；HMAC_KEY 不少于 32 个字符。
VALET_DRIVER_CODE_DATA_KEY=
VALET_DRIVER_CODE_HMAC_KEY=

# 生产环境仍需使用不少于 32 个字符的独立密钥签发短期取车地点凭证，
# 防止客户端篡改 POI 文案与坐标压低代驾费。
WASH_LOCATION_PROOF_SECRET=
# 仅非生产环境可显式允许合成演示取车地址；生产环境始终拒绝。
YUXIAOMAN_ALLOW_DEMO_LOCATIONS=false

# 保险线索默认严格运行在合成演示模式。真实模式还要求公开基址为 HTTPS、数据/HMAC
# 密钥以及明确的默认接收方同时配置；缺少任一项会 fail closed 回演示模式。
# HTTPS 应由应用直连或受控反向代理终止；应用不采信客户端自行传入的 X-Forwarded-Proto。
INSURANCE_REAL_MODE=false
INSURANCE_PUBLIC_BASE_URL=
INSURANCE_UPLOAD_DIR=data/private/insurance
# 32 字节密钥：64 位十六进制或 Base64。
INSURANCE_DATA_KEY=
INSURANCE_PHONE_HMAC_KEY=
INSURANCE_PARTNER_ID=
INSURANCE_PARTNER_NAME=
INSURANCE_PARTNER_RECIPIENT=
INSURANCE_PARTNER_DATA_SCOPE=联系人姓名、手机号、车辆档案、续保需求、行驶证照片
INSURANCE_PARTNER_PURPOSE=核验续保需求并安排专业服务人员联系
INSURANCE_PARTNER_RETENTION=合作方按其已披露规则保存；平台关闭线索后 180 天清除个人信息
INSURANCE_PARTNER_CONSENT_TEXT=
INSURANCE_PARTNER_CONTACT_ETA=专业服务人员将在 1 个工作日内联系

# 驾校咨询默认只接受固定合成演示资料。真实机构咨询仅在以下四项全部满足时启用；
# 缺少任一项时 disclosure、留资及真实机构发布均 fail closed，不会降级接收真实手机号。
DRIVING_SCHOOL_INQUIRY_REAL_MODE=false
# 必须是应用实际公开使用的 HTTPS 基址，不采信客户端转发头。
DRIVING_SCHOOL_INQUIRY_PUBLIC_BASE_URL=
# 32 字节 AES/HMAC 私钥：64 位十六进制或 Base64。服务端会拒绝与手机号 HMAC 密钥相同的配置。
DRIVING_SCHOOL_INQUIRY_DATA_KEY=
# 独立且不少于 32 字符；用于手机号去重 HMAC。
DRIVING_SCHOOL_INQUIRY_PHONE_HMAC_KEY=
# 逗号分隔的 HTTPS Origin，例如 https://admin.example.com；真实模式后台咨询 API
# 会校验 Origin，导航请求缺少 Origin 时回退校验 Referer。
DRIVING_SCHOOL_INQUIRY_ADMIN_ORIGINS=
# 仅当部署方已通过受控反向代理、防火墙或内网边界限制后台入口时设为 true。
DRIVING_SCHOOL_INQUIRY_ADMIN_NETWORK_RESTRICTED=false
