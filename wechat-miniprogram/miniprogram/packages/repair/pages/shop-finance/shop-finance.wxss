.finance-page{min-height:100vh;padding:24rpx;background:#f2f7fb;color:#173650}.finance-hero{display:grid;gap:10rpx;padding:32rpx;border-radius:28rpx;color:#fff;background:linear-gradient(135deg,#174f7d,#197ac0)}.finance-hero text:first-child{color:#a9d8f7;font-size:18rpx;letter-spacing:4rpx}.finance-hero text:nth-child(2){font-size:38rpx;font-weight:700}.finance-hero text:last-child{color:#d1e8f7;font-size:22rpx;line-height:1.65}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:18rpx 0}.metrics view{display:grid;gap:8rpx;padding:22rpx 18rpx;border:1rpx solid #dbe8f1;border-radius:22rpx;background:#fff}.metrics text:first-child{color:#758a9a;font-size:20rpx}.metrics text:last-child{color:#16446a;font-size:29rpx;font-weight:700}.notice,.error{margin:16rpx 0;padding:20rpx;border-radius:18rpx;font-size:22rpx}.notice{color:#8a641f;background:#fff6dc}.error{display:flex;justify-content:space-between;color:#a04435;background:#fff0ec}.error button,.statement-foot button{margin:0;color:#176fac;background:#eef7fd;font-size:20rpx}.section-title,.statement-head,.statement-foot{display:flex;align-items:center;justify-content:space-between}.section-title{margin:30rpx 4rpx 16rpx}.section-title text:first-child{font-size:30rpx;font-weight:700}.section-title text:last-child{color:#8495a4;font-size:20rpx}.empty{padding:90rpx;text-align:center;color:#8293a1;background:#fff;border-radius:24rpx}.statement-list{display:grid;gap:16rpx}.statement{padding:24rpx;border:1rpx solid #dce8f0;border-radius:24rpx;background:#fff}.statement-head view{display:grid;gap:5rpx}.statement-head view text:first-child{font-size:28rpx;font-weight:700}.statement-head view text:last-child{color:#8293a1;font-size:18rpx}.status{padding:8rpx 14rpx;border-radius:999rpx;color:#3e6d8e;background:#eaf3f9;font-size:19rpx}.status-paid{color:#257552;background:#e8f7ef}.status-pending_payment{color:#93631c;background:#fff3d7}.amount-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:22rpx 0;padding:18rpx 0;border-top:1rpx solid #edf2f5;border-bottom:1rpx solid #edf2f5}.amount-grid view{display:grid;gap:7rpx}.amount-grid text:first-child{color:#7a8d9c;font-size:19rpx}.amount-grid text:last-child{font-size:25rpx;font-weight:700}.statement-foot text{color:#6f8495;font-size:20rpx}.drawer{position:fixed;z-index:50;inset:0}.mask{position:absolute;inset:0;background:rgba(8,28,43,.42)}.panel{position:absolute;right:0;bottom:0;left:0;height:76vh;border-radius:32rpx 32rpx 0 0;background:#f4f8fb}.panel-head{display:flex;align-items:center;justify-content:space-between;padding:28rpx 26rpx;color:#fff;border-radius:32rpx 32rpx 0 0;background:linear-gradient(135deg,#154d78,#1b79b9)}.panel-head view{display:grid;gap:7rpx}.panel-head view text:last-child{font-size:28rpx;font-weight:700}.panel-head button{margin:0;color:#fff;background:rgba(255,255,255,.16);font-size:20rpx}.panel-summary{display:flex;gap:12rpx;padding:18rpx 24rpx}.panel-summary text{flex:1;padding:16rpx;border-radius:16rpx;background:#fff;color:#416078;font-size:20rpx;text-align:center}.items{height:calc(76vh - 190rpx);padding:0 24rpx}.item{display:flex;justify-content:space-between;margin-bottom:12rpx;padding:22rpx;border:1rpx solid #dee8ef;border-radius:18rpx;background:#fff}.item>view{display:grid;gap:6rpx}.item>view:first-child text:first-child{font-size:23rpx;font-weight:700}.item>view text:not(:first-child){color:#7c8e9d;font-size:19rpx}.item>view:last-child{text-align:right;font-size:20rpx}.negative{color:#c24e42!important}
